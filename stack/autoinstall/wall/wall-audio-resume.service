# wall-audio-resume.service — re-assert the switch after resume or USB return.
#
# A SEPARATE UNIT FROM wall-audio-state.service, AND THAT IS THE POINT. The boot
# unit is `RemainAfterExit=yes`, so it stays active for the life of the boot --
# which means pulling it in again at resume would start an already-active unit
# and run nothing at all. That is a silent no-op: the panel would come back from
# sleep with whatever the ALSA graph happened to be in, and Owner ruling G (and
# item 16) would be quietly unmet with a green `systemctl status` above it.
#
# The systemd idiom for "run on resume" is to be ordered After= the sleep target
# and wanted by it: units wanted by suspend.target are started when it is
# activated, and this one's ordering puts it after the sleep transition rather
# than before it. No RemainAfterExit here, so every resume runs it again.
#
# Also re-asserted rather than assumed because the USB adapters may have been
# re-enumerated across S3: the applier resolves the headset card afresh and
# starts the leg the stored position calls for. The USB adapter's udev rule also
# wants this unit after a re-add. That is intentionally the same operation: it
# is non-sticky, so repeated wants are safe and policy stays in
# wall_audio_state.py instead of being copied into a udev unit list.

[Unit]
Description=Wall panel: re-assert the stored audio switch after resume or USB return
Documentation=file:///opt/wall-panel/docs/design/audio-routing-2026-09-13.md
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
After=sound.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wall-audio-output apply-state
SyslogIdentifier=wall-audio-output
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
