# wall-mic-rear.service - the selected microphone to the desktop's input.
#
# ITEM 23 REVISION 2, SPEC C: "the selected mic feeds the rear output and the
# Bluetooth mic return". The rear output of the 5.1 adapter is wired to the
# desktop's audio input (the Owner's declared hardware layout), so this unit is
# the half of C that reaches the desktop. The other half is wall-bt-mic.service.
#
# WHICH MICROPHONE IS NOT DECIDED HERE. `mic_selected` resolves through
# `@func getenv WALL_AUDIO_MIC_SOURCE`, written by wall-audio-output on every
# apply from the OUTPUT switch position: the panel's ALC255 in Speaker and in
# Mute, the headset adapter's mono capsule in Headset (item 23 D3 and D4).
# ALSA resolves that name when the PCM is OPENED, so the applier RESTARTS this
# unit when the selection changes rather than starting it -- see
# select_mic_source, which exists entirely to make that true.
#
# AND `mic_selected` IS ALSO THE AEC SEAM. The later echo-cancellation step
# (D-3a) puts a cancelled microphone in front of both mic legs by making that
# one name resolve somewhere else. Nothing in this unit changes when it does.
#
# MONO, ON PURPOSE. Both destinations are mono by nature and the graph mixes
# down once, in asound-bus-mode.conf, so neither leg has to know.
#
# WHY THIS CANNOT REACH THE SPEAKERS. `mic_rear` is a generated `route`
# (/etc/wall-panel/audio-mic.conf) over the SHARED eight-channel dmix
# `usb_out_mix`. It writes the microphone to measured Side channels 6 and 7 and
# EXPLICIT ZEROS to 0-5. The speaker leg's own generated route writes explicit
# zeros to 4-7. dmix sums per channel, so the two tables are the whole of the
# separation, in both directions, and they are the whole of it BECAUSE the
# adapter's mute is one boolean over all eight channels (numid 7, measured
# 2026-09-14) and cannot express "front off, rear on".
#
# BOUND TO THE 5.1 ADAPTER, NOT TO THE MICROPHONE. The adapter is the
# destination and is the thing whose disappearance makes this leg meaningless.
# The panel's own codec never goes away; the headset adapter does, and when it
# does the presence unit drives an apply that re-points the source and restarts
# this unit. Binding to the headset here would stop the leg in Speaker position,
# where it has nothing to do with a headset at all.
#
# NOT ENABLED: wall-audio-output owns when it runs, and `input_muted` (Owner
# ruling E) is applied by STOPPING it. That is what makes the input mute a real
# mute rather than something the UI draws over a running microphone.

[Unit]
Description=Wall panel: selected microphone to the adapter's rear out (the desktop's input)
Documentation=file:///opt/wall-panel/docs/design/audio-routing-2026-09-13.md
After=sound.target
Wants=sound.target
# Ordering does not pull AEC in when the Owner has disabled it. PartOf makes a
# later AEC stop/restart propagate to a mic leg already reading mic_clean.
After=wall-audio-aec.service
PartOf=wall-audio-aec.service
StartLimitIntervalSec=60
StartLimitBurst=10
BindsTo=dev-wall_audio_adapter.device
After=dev-wall_audio_adapter.device

[Service]
Type=simple
ExecCondition=/bin/sh -c '[ "$(cat /etc/wall-panel/audio-mode 2>/dev/null || echo trigger)" = bus ]'
# THE MUTE IS RE-CHECKED ON EVERY START ATTEMPT, RESTARTS INCLUDED. This unit
# is Restart=always, so "the applier stopped it" is not a property anybody can
# rely on: a guard or alsaloop crash, an operator restart, a daemon-reload
# workflow, or a stop that FAILED during an apply would each bring it back with
# the state still saying muted. systemd re-runs ExecCondition on every start
# attempt and treats a non-zero exit as a clean "not started" rather than a
# failure, which is exactly the shape wanted. It takes no lock, so it cannot
# deadlock the apply that is starting this leg. Review (terra, 2026-09-14)
# found this path once per mic leg.
ExecCondition=/usr/local/sbin/wall-audio-output mic-allowed
# When the seam is on mic_clean, do not open it unless its only writer is live.
# When AEC is disabled, the condition is true without starting that service.
ExecCondition=/bin/sh -c '! grep -qx WALL_AUDIO_AEC=1 /etc/wall-panel/audio-aec.env 2>/dev/null || systemctl is-active --quiet wall-audio-aec.service'
# Which microphone, written by wall-audio-output at every apply. `-` so a
# hand-started leg with no applier run behind it takes the configured default
# (the panel's own microphone), rather than refusing to start.
EnvironmentFile=-/run/wall-panel/audio-mic-source.env
# The headset adapter's card id, for the Headset-position source. Same file the
# headset OUTPUT leg reads, and for the same reason: the kernel calls any
# nameless C-Media part "Device" and ALSA cannot look a card up by USB id.
EnvironmentFile=-/run/wall-panel/audio-headset.env
ExecStart=/usr/local/lib/wall-panel/wall-alsaloop-guard.py \
    --max-errors 20 --window 10 -- \
    /usr/bin/alsaloop \
    --cdevice mic_selected \
    --pdevice mic_rear \
    --format S16_LE --rate 48000 --channels 1 \
    --tlatency 50000 --sync 5
Restart=always
RestartSec=2
Nice=-5
CPUSchedulingPolicy=rr
CPUSchedulingPriority=15
LimitRTPRIO=15
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
SupplementaryGroups=audio
StandardOutput=journal
StandardError=journal
