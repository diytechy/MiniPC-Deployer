# wall-amp-trigger.service — power the amplifier while audio is playing.
#
# Commands either the ALC255 tone/rectifier path or one LCUS-2 USB relay
# channel whenever either audio source is above threshold. See
# PANEL_AMP_AUTOPOWER.md in the HomeHub repo for the measurements, the circuit
# and the calibration procedure.
#
# It needs the audio group for the dsnoop segments it reads, and it must be able
# to drive amixer on the built-in codec -- it asserts Master and Headphone at
# 100% on every cycle rather than inheriting them from alsactl, because a silent
# reset would halve the trigger voltage and the amplifier would simply stop
# switching on with nothing in any log.

[Unit]
Description=Wall panel: hold the amplifier on while audio is playing
Documentation=file:///opt/wall-panel/stack/panel-audio/README.md
After=sound.target wall-line-in.service
Wants=sound.target
# A re-enumeration can restart this unit while the relay is still being
# re-probed, so a couple of exits in quick succession are recovery, not a
# crash loop, and must not land it in `failed`. [Unit] keys, not [Service]:
# the [Service] spelling is accepted-and-ignored with only a verify warning.
StartLimitIntervalSec=60
StartLimitBurst=10
# ITEM 25 (2026-09-13): when the hub moved ports this daemon lost its line-in
# capture AND its relay handle and did not get either back until a hand-run
# restart. Bound to the adapter's udev alias, a re-enumeration stops it -- which
# also drives the relay to a verified OFF on the way down, the correct state
# when there is no longer any audio hardware -- and the SYSTEMD_WANTS in
# 90-wall-audio-adapter.rules starts it again when the adapter returns.
#
# The LCUS-2 relay is a SEPARATE USB device on the same hub and is deliberately
# not a dependency: its node is a udev symlink that reappears on its own, and
# the daemon now waits a bounded WALL_AMP_RELAY_WAIT_SECONDS for it at start
# rather than exiting on the first ENOENT of a re-enumeration in progress.
BindsTo=dev-wall_audio_adapter.device
After=dev-wall_audio_adapter.device

[Service]
Type=simple
# Thresholds and timings live here, not in the script. Every one of them is a
# number someone will want to change after living with it for a week. Absent
# file or absent key falls back to the measured defaults.
EnvironmentFile=-/etc/wall-panel/amp-trigger.env
ExecStart=/usr/bin/python3 /usr/local/lib/wall-panel/panel-amp-trigger.py
RuntimeDirectory=wall-amp-trigger
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=5
# 78 = a tool it needs is missing. Restarting will not conjure one.
SuccessExitStatus=0
RestartPreventExitStatus=78

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The mode file is the only thing it reads outside /usr.
ReadOnlyPaths=/etc/wall-panel
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SupplementaryGroups=audio dialout

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
