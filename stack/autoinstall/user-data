#cloud-config
# Ubuntu Server autoinstall (cloud-init) for the AWOW AK41 always-on core.
# Flash USB → boot → everything up, zero clicks.
#
# This is the `autoinstall` user-data consumed by the Ubuntu Server 24.04 LTS
# live installer (Subiquity). It:
#   1. Partitions the whole eMMC/SSD (LVM = simple whole-disk layout).
#   2. Creates the hub user (SSH KEY-ONLY by default — WI-10.12).
#   3. Installs Docker Engine + compose plugin + git + Cockpit via late-commands.
#   4. Enables unattended-upgrades (WI-10.12) for hands-off OS security patching.
#   5. Drops the stack/ tree, a placeholder .env, and a first-boot systemd unit
#      onto the target, then enables the unit so the FIRST real boot runs
#      provisioning + `docker compose up -d`.
#
# SECURITY: replace the identity block below (username + SSH PUBLIC key) and DO
# NOT commit a filled-in copy — this template ships with placeholders. The box is
# key-only; there is no usable password login.
#
# See ../README.md "Build the USB" and ../../REMOTE_MANAGEMENT.md for how to
# attach this file and how to manage the headless box over the LAN.

autoinstall:
  version: 1

  # Non-interactive: never stop to ask. Any prompt would defeat "zero clicks".
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # DHCP on the first NIC. Give the box a DHCP RESERVATION at your chosen LAN_IP
  # on the router so it always lands where the split-horizon records point.
  # MATCH `e*`, NOT `en*` — this cost a whole install cycle to learn.
  # `en*` covers systemd's predictable names (eno1 on the AK41's Realtek,
  # enp2s0, enx<mac>) but NOT the plain `eth0` that a VMBus/virtio NIC gets,
  # because predictable naming does not apply to those. In Hyper-V the NIC
  # comes up as `eth0`, so `en*` matched nothing, netplan configured nothing,
  # DHCP never ran, and the install died fetching `cockpit` with apt exit 100
  # — network failure surfacing as a package error, three steps downstream.
  # `e*` is a strict superset: everything `en*` matched, plus eth*. There is no
  # case where `en*` is right and `e*` is wrong, and the failure mode it
  # prevents is an UNATTENDED box that installs with no network at all. That
  # matters beyond the VM: swap the mini PC for anything presenting eth0 and
  # `en*` would strand the replacement exactly the same way.
  # Keeping ONE match for both production and the VM is deliberate — it means
  # the V3 gate actually exercises the config that ships.
  network:
    version: 2
    ethernets:
      any-eth:
        match:
          name: "e*"
        dhcp4: true

  identity:
    # HOSTNAME is the ROLE, not the hardware (Owner's ruling, same reasoning as
    # the account name below). AWOW is the box that happens to run it today; if
    # it is replaced tomorrow the name should still be right. `awow` stays in
    # documentation, where it describes the machine, and out of anything the
    # running system answers to.
    # NOTE: the install PATH is still /opt/homehub — a separate rename with
    # its own blast radius across firstboot, the systemd units and the sim.
    hostname: homehub
    realname: "Home Hub Operator"
    # ACCOUNT NAME - do not use a name Ubuntu already ships as a USER OR GROUP.
    # This was `operator` until the first real install, which died at
    #   useradd 'operator' ... returned non-zero exit status 9
    # Debian/Ubuntu ship a system GROUP called `operator` (GID 37, straight out
    # of base-passwd's group.master). useradd creates a primary group named
    # after the user, hit the existing one, and exited 9 = "username or group
    # name already in use". It would have failed identically on real hardware —
    # nothing about this was VM-specific.
    # Unusable names, i.e. every group Ubuntu ships: root daemon bin sys adm tty
    # disk lp mail news uucp man proxy kmem dialout fax voice cdrom floppy tape
    # sudo audio dip www-data backup operator list irc src shadow utmp video
    # sasl plugdev staff games users nogroup. render_seed_tree() now refuses to
    # build if this name collides with any of them.
    # `hub` is the ROLE, deliberately not the hardware: AWOW is just the box
    # that happens to run it today.
    username: hub
    # SSH KEY-ONLY box (WI-10.12): no usable password login. "!" is a locked
    # hash — the account cannot be logged into with a password at all. Console/
    # emergency access is via the physical console only. If you MUST allow a
    # password (not recommended for a headless box) replace this with a real
    # `mkpasswd --method=SHA-512` hash AND set ssh.allow-pw: true below.
    password: "!"

  # Remote management is KEY (WI-10.12): SSH on, KEY-ONLY. Paste your PUBLIC key.
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      # REPLACE with your real public key(s). allow-pw:false above means the box
      # is unreachable over SSH until at least one valid key is present here.
      - "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY you@host"

  # Whole-disk automatic layout (LVM) — DESTRUCTIVE, and pinned on purpose.
  #
  # !! READ THIS BEFORE CHANGING IT !!
  # `layout:` wipes the disk it selects, unattended, with no confirmation:
  # `interactive-sections: []` above means the installer NEVER stops to ask,
  # and the repacked ISO puts `autoinstall` on the kernel command line so it
  # begins immediately at boot. There is NO machine validation step and no
  # "are you sure" — first power-on IS the install.
  #
  # Without a `match:` the installer picks a disk by its own heuristic, and
  # EVERY attached disk is a candidate — including the USB library and backup
  # drives. On this box those are 4 TB and 8 TB, i.e. far larger than the
  # internal disk, so a size-based heuristic would choose exactly the drive
  # holding the family's data. Pinning the path removes that entire class of
  # accident.
  #
  # The AK41's internal disk is an NVMe (FORESEE P900F128GBH, 119.2 GB) — the
  # 2026-07-26 hardware baseline confirms `nvme0n1`; earlier comments in this
  # repo called it eMMC, which was wrong. The library/backup drives enumerate
  # as USB `sd*`, so the nvme path also distinguishes by bus, not just name.
  #
  # DIFFERENT HARDWARE? Change this path (or switch to `serial:`/`model:` —
  # a serial is more precise but is device-identifying, so keep real serials
  # out of this public repo and materialize them from Personal if wanted).
  # STILL RECOMMENDED regardless: physically detach the USB data drives before
  # imaging. Defence in depth costs nothing here.
  storage:
    layout:
      name: lvm
      match:
        path: /dev/nvme0n1

  packages:
    - ca-certificates
    - curl
    - git
    - dnsutils          # provides dig for the health check
    - apt-transport-https
    - cockpit           # LAN web console (terminal/logs/updates/reboot) — WI-10.12
    - unattended-upgrades  # hands-off OS security patching — WI-10.12
    - powertop          # low-power auto-tune, applied per boot by powertune.service
    - hdparm            # backup-drive spin-down (WI-10.10) — NOT guaranteed on Ubuntu Server
    - samba             # household file server (A14) — shares come from storage-map §3
    - samba-common-bin  # provides smbpasswd/pdbedit for the per-account passwords (A13)

  # Everything site-specific happens in late-commands, which run in the installer
  # environment with the target mounted at /target. We write files INTO /target.
  late-commands:
    # ---- 1. Install Docker Engine from the official repo (inside the target) --
    - curtin in-target --target=/target -- bash -c 'install -m 0755 -d /etc/apt/keyrings'
    - curtin in-target --target=/target -- bash -c 'curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc && chmod a+r /etc/apt/keyrings/docker.asc'
    - curtin in-target --target=/target -- bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list'
    - curtin in-target --target=/target -- bash -c 'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin'
    # Docker log rotation (review 2026-07-10): the default json-file driver grows
    # unbounded — a slow disk-filler on an always-on box with small eMMC/SSD
    # (Technitium/Caddy log every query/request). The "local" driver rotates by
    # default (per-container cap), so one line prevents the failure mode.
    # YAML: this entry is a FOLDED BLOCK SCALAR (>-), not a plain scalar like
    # its neighbours, and it has to stay one. The JSON below contains ": "
    # (colon-space); inside a PLAIN scalar YAML reads that as a mapping key, so
    # the list item parses as a dict instead of a string and Subiquity rejects
    # the entire section with "Malformed autoinstall in 'late-commands'
    # section" — the install dies before it starts. Block scalars take their
    # content literally, so the colon is harmless. The neighbouring entries get
    # away with plain scalars only because their colons are in "://" (no
    # following space). Caught on the first real boot of the V3 gate.
    - >-
      curtin in-target --target=/target -- bash -c 'mkdir -p /etc/docker && echo "{ \"log-driver\": \"local\" }" > /etc/docker/daemon.json'
    - curtin in-target --target=/target -- systemctl enable docker
    - curtin in-target --target=/target -- usermod -aG docker hub

    # ---- 2. Remote management: Cockpit + unattended-upgrades (WI-10.12) --------
    # Cockpit web console on :9090 — LAN-only (do NOT proxy it through Caddy to
    # the public internet). See ../../REMOTE_MANAGEMENT.md.
    - curtin in-target --target=/target -- systemctl enable cockpit.socket
    # Enable unattended security upgrades non-interactively.
    - curtin in-target --target=/target -- bash -c 'echo "unattended-upgrades unattended-upgrades/enable_auto_updates boolean true" | debconf-set-selections'
    - curtin in-target --target=/target -- dpkg-reconfigure -f noninteractive unattended-upgrades
    - curtin in-target --target=/target -- systemctl enable unattended-upgrades

    # ---- 2b. Low-power lightening (Owner, 2026-07-04) --------------------------
    # Nothing in the stack uses snaps; snapd costs RAM + background churn on a
    # low-power box. Purge it. (powertop tuning is applied per-boot by
    # powertune.service, installed in step 5 — auto-tune does not persist.)
    - curtin in-target --target=/target -- bash -c 'DEBIAN_FRONTEND=noninteractive apt-get purge -y snapd 2>/dev/null || true; apt-get autoremove -y --purge'

    # ---- 3. Place the stack ---------------------------------------------------
    # The repo payload is copied by the USB-build step to /cdrom/deploy-payload
    # (a second CIDATA stick, or the remastered ISO) and picked up here into
    # /opt/homehub/. The stack itself then lives at /opt/homehub/stack/.
    - mkdir -p /target/opt/homehub
    # /cdrom IS NOT ENOUGH on the LIGHT path, and this was silent for months.
    # On the REPACKED path /cdrom is the combined ISO and carries
    # /deploy-payload — which is the path every V3 gate has actually used, so
    # nothing ever noticed. On the light path /cdrom is the STOCK Ubuntu ISO,
    # which has no such directory, and the CIDATA seed that does is mounted only
    # transiently by cloud-init to read user-data. The ~470 MB of baked container
    # images the light path carefully stages therefore NEVER REACHED THE BOX:
    # firstboot logged its "no baked image payload found" fallback and pulled
    # from registries instead, which looks like a slow first boot rather than a
    # bug. Found 2026-08-03 by the wall image, which cannot degrade that way.
    # Mount the seed by label as a fallback.
    #
    # NOT FINDING A PAYLOAD IS STILL NON-FATAL, deliberately, unlike the wall's
    # copy of this: a hub with no payload has a documented degraded mode
    # (firstboot.sh step 3 pulls at compose-up). Say so loudly rather than
    # halting an install that can recover.
    #
    # FINDING ONE AND FAILING TO COPY IT IS FATAL, and that is NOT the same
    # thing. Both branches used to read `cp -a … && echo …; exit 0` — and the
    # `exit 0` is a SEPARATE command after the `;`, so it ran whether or not the
    # copy worked. One I/O error partway through ~470 MB of baked images left a
    # HALF-COPIED /target/opt/homehub, reported success, and handed 4b a site/
    # holding only the files that made it across before the error; firstboot
    # then ran on whatever else survived. "No payload" is a recoverable state
    # the box knows how to describe; "some of the payload" is not a state at
    # all. Refuse it, and let Subiquity halt where the operator can see why.
    # (Found by an adversarial review 2026-08-03, alongside OI-19's second head.)
    - >-
      bash -c 'fail_partial() {
      echo "homehub: FATAL - $1";
      echo "homehub: /target/opt/homehub now holds a PARTIAL copy of the deploy unit. Late-command 4b would install only the site files that made it across, and firstboot would run on whatever else survived.";
      echo "homehub: a truncated deploy unit is worse than no deploy unit - it looks installed. Refusing to continue.";
      exit 1; };
      for d in /cdrom /media /media/* /run/media/*; do
      [ -d "$d/deploy-payload" ] || continue;
      cp -a "$d/deploy-payload/." /target/opt/homehub/ || fail_partial "found $d/deploy-payload but cp -a FAILED partway";
      echo "homehub: payload copied from $d/deploy-payload";
      exit 0;
      done;
      dev=$(blkid -L CIDATA 2>/dev/null || true);
      if [ -n "$dev" ]; then m=$(mktemp -d);
      if mount -o ro "$dev" "$m" 2>/dev/null; then
      if [ -d "$m/deploy-payload" ]; then
      cp -a "$m/deploy-payload/." /target/opt/homehub/ || { umount "$m" || true; fail_partial "found deploy-payload on the CIDATA seed at $dev but cp -a FAILED partway"; };
      umount "$m" || { echo "homehub: FATAL - the payload copied from the CIDATA seed at $dev but the seed would NOT unmount."; echo "homehub: the install is about to reboot with the boot medium still busy, and nothing else here can tell whether the copy was flushed. Refusing to guess."; exit 1; };
      echo "homehub: payload copied from the CIDATA seed at $dev";
      exit 0; fi;
      umount "$m" || true; fi; fi;
      echo "homehub: WARNING - no deploy-payload found under /cdrom, /media, /run/media/* or on the CIDATA volume.";
      echo "homehub: first boot will PULL every container image from its registry (needs internet), and naglight:local has no registry home.";
      exit 0'

    # ---- 3b. Decide the deploy unit's PERMISSIONS ------------------------------
    # FOUND BY BOOTING, 2026-08-04. The installed gate VM had `drwxrwxrwx
    # root:root /opt/homehub`, `-rwxrwxrwx stack/.env`, `-rwxrwxrwx
    # docker-compose.yml` and 230 world-writable paths beneath it — and an
    # unprivileged account could READ every credential in .env and WRITE the
    # compose file that root brings up on the next boot. Nothing was
    # malfunctioning: a WSL build stages the payload on an NTFS mount, DrvFs
    # reports 0777 for every path there, Rock Ridge records that honestly and the
    # `cp -a` above copies it honestly. The mode was never DECIDED by anyone.
    #
    # It is decided in TWO places on purpose. vmtest/lib/common.sh
    # (normalize_payload_modes) is the primary fix and gives the payload a real
    # policy — 0755 dirs, 0644 files, 0755 for anything with a `#!`, 0600
    # secrets. This step is the floor underneath it, and it is not merely belt
    # and braces: on the DEFAULT build host the staging filesystem discards
    # chmod outright, so a payload can still arrive here from a build route that
    # never applied the policy. What this asserts is the property that made the
    # finding a security defect rather than untidiness — root-owned, and NOTHING
    # group- or world-writable — and it refuses the install if it cannot get it.
    #
    # `chown -R 0:0` is the OI-18 lesson generalised: `-rock` preserves the
    # BUILDER's uid, which on an ordinary single-user Linux/WSL builder is 1000 —
    # the same uid this image gives `hub`. Ownership, not just mode.
    #
    # It runs BEFORE step 4/4b deliberately: 4b installs the real site files
    # 0600 root:root and tightens what it leaves behind, so this narrows the
    # window rather than fighting it, and the two agree about site/ being 0700.
    #
    # sim-gate/ gets site/'s treatment for site/'s reason: it is the GATE's
    # equivalent seam (generated, never tracked) and its backup.env carries the
    # tracker's bearer token. Added 2026-08-04 after reading the modes actually
    # recorded in a built ISO rather than the ones the staging tree reported —
    # on the DrvFs build path `-chmod_r go-w` is SUBTRACTIVE, so it clears the
    # write bits and leaves `-rwxr-xr-x`, world-READABLE. `stack/.env` has
    # always been in exactly that state on the ISO and has always been tightened
    # here; sim-gate/ was the new seam nobody had told this step about, which is
    # the same sentence as defect #13's.
    - >-
      bash -c 'R=/target/opt/homehub;
      if [ ! -d "$R" ]; then echo "homehub: no /opt/homehub to normalise - step 3 found no payload"; exit 0; fi;
      chown -R 0:0 "$R" || { echo "homehub: FATAL - could not take ownership of $R"; exit 1; };
      chmod -R go-w "$R" || { echo "homehub: FATAL - could not clear group/world write on $R"; exit 1; };
      chmod 0755 "$R";
      if [ -d "$R/site" ]; then chmod 0700 "$R/site"; find "$R/site" -type f -exec chmod 0600 {} +; fi;
      if [ -d "$R/sim-gate" ]; then chmod 0700 "$R/sim-gate"; find "$R/sim-gate" -type f -exec chmod 0600 {} +; fi;
      if [ -f "$R/stack/.env" ]; then chmod 0600 "$R/stack/.env"; fi;
      find "$R" -type f -name "*.creds" -exec chmod 0600 {} + ;
      bad=$(find "$R" -perm /022 | head -n 5);
      if [ -n "$bad" ]; then
      echo "homehub: FATAL - $R is STILL group- or world-writable after normalisation:";
      echo "$bad";
      echo "homehub: a writable docker-compose.yml on a box that runs it as root is a local privilege escalation. Refusing to finish an install that leaves one.";
      exit 1;
      fi;
      echo "homehub: /opt/homehub normalised - root-owned, nothing group- or world-writable"'

    # ---- 4. Seed .env from the example if the operator did not pre-fill one ----
    - curtin in-target --target=/target -- bash -c '[ -f /opt/homehub/stack/.env ] || cp /opt/homehub/stack/.env.example /opt/homehub/stack/.env'

    # ---- 4b. SITE payload: real materialized config + secrets (A14) ------------
    # deploy-payload/site/ is written by Build-VentoyStick.ps1 from
    # Personal\homelab\deploy\out\ — the REAL values, not the sim placeholders
    # the vmtest builders bake. A sim/vmtest build legitimately has no site/ at
    # all, and on that path this whole block is a documented no-op.
    #
    # IT READS THE PAYLOAD STEP 3 ALREADY COPIED, not the boot medium (OI-19).
    # This used to start `S=/cdrom/deploy-payload/site` with a `/media/...`
    # fallback and then `[ -d "$S" ] || exit 0` — a SILENT SUCCESS built on the
    # same wrong assumption that cost an install cycle on 2026-08-03: /cdrom is
    # the BOOT MEDIUM, not the seed. On the repacked path (the one
    # Build-VentoyStick.ps1 uses today) /cdrom is the combined ISO and does
    # carry /deploy-payload, so this worked. On the LIGHT path — the one this
    # repo recommends by default, and a supported way to build a production hub
    # (SITE_DIR=… bash vmtest/build-seed.sh) — /cdrom is the STOCK Ubuntu ISO
    # and the CIDATA seed carrying the payload is mounted only transiently by
    # cloud-init. A production hub would then install NONE of its six real
    # files and come up on .env.example placeholders while believing it is
    # production.
    #
    # The fix deliberately adds NO second search. Step 3 above already tries
    # /cdrom, /media, /media/*, /run/media/* and finally mounts the CIDATA
    # volume by label, and it copies the WHOLE payload — site/ included — to
    # /target/opt/homehub/. One discovery mechanism, one place it can rot. This
    # is the same shape the wall image uses (its late-command 4a reads
    # /opt/wall-panel/site/wall.env rather than searching again).
    #
    # AND IT REFUSES, when a PRODUCTION image is what was asked for. BUILD_PROFILE
    # below is `production` in the tracked template — which is what
    # Materialize-Deploy.ps1 renders user-data.filled from — and
    # vmtest/lib/common.sh rewrites it to `sim` on the sim path (asserting the
    # rewrite applied, so a silent no-op cannot make a sim image refuse). The
    # safe value is therefore the default and the sim build has to opt out of it.
    # A production box that quietly degrades to sim config is the failure mode
    # this exists to prevent: the "a dead panel must be a visible event, not
    # silence" doctrine, applied to a headless box where the only screen is the
    # journal.
    #
    # AN ABSENT `optional` FILE IS LOUD BUT NOT FATAL, on purpose:
    # Build-VentoyStick.ps1 marks cifs.creds, samba-users.creds and
    # drive-identity.conf optional (Required=$false), so refusing the install
    # over one of them would refuse legitimate households.
    #
    # AN ABSENT `required` FILE NOW HALTS THE INSTALL (rc=1). It used to only
    # print and `continue`, and that was OI-19 wearing a second hat: a payload
    # whose site/ directory EXISTS but is empty of everything that matters
    # sailed past the missing-directory refusal above, logged six MISSING lines
    # nobody reads on a headless box, touched .site-present so firstboot's own
    # "broken production stick" branch stayed quiet, and exited 0. The outcome
    # was byte-for-byte the outcome OI-19 was raised about — a production hub on
    # .env.example placeholders believing it is production — reached by a
    # different road. The directory's existence was never the property worth
    # checking; the FILES are.
    # NOTE FOR RATIFICATION (docs/status.md OI-19/A10): this closes that open
    # ruling in the REFUSE direction. It is the same call the missing-directory
    # branch above already makes, and the same call the wall image makes; it is
    # recorded rather than assumed, and the Owner can reverse it by moving a
    # file from `required` to `optional` in the table below.
    #
    # site/config.json IS NOT IN THIS TABLE, and that is deliberate. It is the
    # kiosk shell's runtime config and its destination is a WEB ROOT
    # (/opt/homehub/stack/wall-shell/), not /etc — and firstboot.sh step 3d
    # untars the site tarball OVER that directory, so anything this step wrote
    # there could be overwritten hours later. firstboot.sh step 3e installs it
    # instead, after the untar. The two site-file lists (here and
    # vmtest/lib/common.sh's staging loop) are cross-referenced from both ends
    # for exactly this reason: they are hand-maintained and they must not drift.
    #
    # Modes matter: every file here is a secret artifact. .env and the *.creds
    # files carry live credentials, so they are installed 0600 root-owned. The
    # smb.conf fragment and fstab are not secret but are still root-only to
    # keep the whole site/ tree consistent. The payload COPY of site/ is
    # tightened too — its modes come from whatever filesystem the ISO was
    # staged on, and a build run under WSL on /mnt/c produces 0777.
    - mkdir -p /target/etc/homehub-samba /target/etc/homehub-backup
    - >-
      bash -c 'BUILD_PROFILE=production;
      S=/target/opt/homehub/site;
      if [ ! -d "$S" ]; then
      if [ "$BUILD_PROFILE" = production ]; then
      echo "homehub: FATAL - this is a PRODUCTION image and the deploy payload carried no site/ directory.";
      echo "homehub: none of .env, backup.env, cifs.creds, samba-users.creds, smb.conf.fragment or library-mounts.fstab would be installed,";
      echo "homehub: so the box would come up on .env.example placeholders while believing it is production. Refusing to install that.";
      echo "homehub: step 3 above reports where the payload was found; site/ is staged into it by vmtest/lib/common.sh from SITE_DIR.";
      exit 1;
      fi;
      echo "homehub: no site/ in the payload - SIM build, so the stack runs on .env.example placeholders (expected for a vmtest image).";
      exit 0;
      fi;
      chmod 0700 "$S" || true;
      rc=0;
      for spec in ".env:/target/opt/homehub/stack/.env:required"
      "backup.env:/target/etc/homehub-backup/backup.env:required"
      "cifs.creds:/target/etc/homehub-backup/cifs.creds:optional"
      "samba-users.creds:/target/etc/homehub-samba/samba-users.creds:optional"
      "smb.conf.fragment:/target/etc/homehub-samba/smb.conf.fragment:required"
      "library-mounts.fstab:/target/etc/homehub-samba/library-mounts.fstab:required"
      "drive-identity.conf:/target/etc/homehub-samba/drive-identity.conf:optional"; do
      f=${spec%%:*}; rest=${spec#*:}; d=${rest%:*}; kind=${rest##*:};
      if [ ! -f "$S/$f" ]; then
      if [ "$kind" = required ]; then
      echo "homehub: FATAL - required site file MISSING - site/$f is not in the payload, so nothing was installed at $d";
      rc=1;
      else
      echo "homehub: optional site file MISSING - site/$f is not in the payload, so nothing was installed at $d";
      fi;
      continue;
      fi;
      if install -m600 -o root -g root "$S/$f" "$d"; then
      chmod 600 "$S/$f" || true;
      echo "homehub: installed site/$f -> $d";
      else
      echo "homehub: FATAL - site/$f is present but could not be installed to $d";
      rc=1;
      fi;
      done;
      touch /target/etc/homehub-samba/.site-present;
      if [ "$rc" -ne 0 ]; then
      echo "homehub: REFUSING to finish a PRODUCTION install whose site/ payload is incomplete - the box would come up on .env.example placeholders while believing it is production, and nothing on a headless machine would say so.";
      echo "homehub: the site/ directory existed, so the check above passed; what is missing are the files named FATAL over it.";
      fi;
      exit $rc'

    # ---- 5. Install + enable the first-boot unit ------------------------------
    - cp /target/opt/homehub/stack/autoinstall/homehub-firstboot.service /target/etc/systemd/system/homehub-firstboot.service
    - cp /target/opt/homehub/stack/autoinstall/firstboot.sh /target/usr/local/sbin/homehub-firstboot.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/homehub-firstboot.sh
    - curtin in-target --target=/target -- systemctl enable homehub-firstboot.service
    # Low-power tune unit (per-boot powertop auto-tune + USB-storage guard).
    - cp /target/opt/homehub/stack/autoinstall/powertune.service /target/etc/systemd/system/powertune.service
    - cp /target/opt/homehub/stack/autoinstall/powertune.sh /target/usr/local/sbin/powertune.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/powertune.sh
    - curtin in-target --target=/target -- systemctl enable powertune.service
    # Backup-drive default standby unit (per-boot hdparm -S spin-down — WI-10.10).
    # Runs from the stack dir (sources common.sh) like homehub-backup.service, so we
    # only install the unit + make the script executable; no cp to /usr/local/sbin.
    # A no-op until BACKUP_DRIVE_DEVICES is set in /etc/homehub-backup/backup.env.
    - cp /target/opt/homehub/stack/backup/systemd/backup-standby.service /target/etc/systemd/system/backup-standby.service
    - curtin in-target --target=/target -- chmod +x /opt/homehub/stack/backup/backup-standby.sh
    - curtin in-target --target=/target -- systemctl enable backup-standby.service

  # No reboot prompt — power-cycle straight into the running box.
  shutdown: reboot
