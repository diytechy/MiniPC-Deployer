# wall-bt-call.service - both directions of a call the panel is the headset for.
#
# WAS wall-bt-mic.service, which carried the microphone only. It now supervises
# TWO legs: the selected microphone to the gateway, and (A3, behind
# WALL_BT_SCO_PLAYBACK) the gateway's far end onto the merged bus. One process
# rather than two units because an SCO PCM exists only for the duration of a
# call and is named after the peer, so neither leg can be a `BindsTo=` unit,
# and two supervisors polling the same D-Bus tree would race each other.
#
# THE SECOND HALF OF ITEM 23 SPEC C: "the selected mic feeds the rear output and
# the Bluetooth mic return". wall-mic-rear.service is the rear-output half.
#
# WHY THIS ONE IS A SUPERVISOR AND NOT AN alsaloop. An HFP SCO PCM exists only
# while a call is up and is named after the phone's Bluetooth address; there is
# no device node, so there is nothing for `BindsTo=` to bind to. wall-bt-mic.py
# watches BlueALSA's own D-Bus object tree instead and runs one alsaloop for
# exactly as long as a sink is there. The whole argument, and what it
# deliberately does not do, is in that file's docstring.
#
# THE PANEL IS THE PHONE'S HANDS-FREE UNIT (`hfp-hf`), which
# wall-bluealsa-override.conf enables. Without that profile there is never an
# SCO sink and this unit simply polls and finds nothing, which is a correct and
# quiet way to be inactive -- it is not an error and must not be logged as one.
#
# NOT ENABLED, and the MICROPHONE LEG is stopped by `input_muted` exactly as the
# rear leg is: Owner ruling E's input mute is applied by STOPPING both mic legs,
# so that no sample leaves the panel at all. A mute that only told the UI to
# draw a red slash would be indistinguishable from a working microphone to
# anybody on the call.
#
# WHICH IS WHY `mic-allowed` IS NO LONGER AN ExecCondition ON THIS UNIT. It
# used to be, correctly, while the unit was the microphone and nothing else.
# Now the unit also carries the FAR END, and muting the panel must not silence
# the person you are listening to -- that is what a muted headset does
# (WSN-027, and §20a of the 2026-09-19 plan). A unit-level gate would stop
# both legs together. The check has moved to the per-poll one the process
# already made through `wall_audio_state.mic_live`, which is the same
# authority re-read on every poll rather than once per start, and is strictly
# the tighter of the two: an operator restart cannot outrun it.
#
# AND THE STOP IS NOT THE ONLY THING HOLDING THAT. This unit is Restart=always
# and a long-lived process, so "it was stopped once" is not a property anybody
# can rely on: an operator restart, a daemon-reload workflow, a crash, or a stop
# that FAILED during an apply would each start it again. wall-bt-mic.py
# therefore re-reads /etc/wall-panel/audio-state.json on every poll and refuses
# to open a microphone unless the switch's own state still authorises one --
# through wall_audio_state.mic_live, which is the single definition of that.
# Review (terra, 2026-09-14) found the fail-open this closes. That per-poll
# check is now the ONLY mute gate, by the argument above.

[Unit]
Description=Wall panel: both directions of a call the panel is the headset for
Documentation=file:///opt/wall-panel/docs/design/audio-routing-2026-09-13.md
After=sound.target bluealsa.service
Wants=sound.target
# Ordering does not pull AEC in when disabled. PartOf propagates an AEC
# stop/restart to a leg that may already be reading mic_clean.
After=wall-audio-aec.service
PartOf=wall-audio-aec.service
# Ordering only, no Requires: BlueALSA not running means no SCO sink, which
# this unit already treats as "no call is up". Requiring it would make a panel
# with Bluetooth disabled fail an apply that has nothing to do with Bluetooth.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecCondition=/bin/sh -c '[ "$(cat /etc/wall-panel/audio-mode 2>/dev/null || echo trigger)" = bus ]'
# Refuse a silent mic_clean when the seam has moved; raw-mic mode is unaffected.
# STILL A UNIT GATE, unlike the mute: a dead echo canceller means the
# microphone leg would send raw echo to the far end, and there is no useful
# far-end-only mode to keep running in when the panel's own capture chain is
# broken. Failing closed here is the same answer it always was.
ExecCondition=/bin/sh -c '! grep -qx WALL_AUDIO_AEC=1 /etc/wall-panel/audio-aec.env 2>/dev/null || systemctl is-active --quiet wall-audio-aec.service'
EnvironmentFile=-/run/wall-panel/audio-mic-source.env
EnvironmentFile=-/run/wall-panel/audio-headset.env
EnvironmentFile=-/etc/wall-panel/bt-mic.env
# A3's knob. Absent or 0 leaves the far-end leg off and this unit behaves
# exactly as wall-bt-mic.service did.
EnvironmentFile=-/etc/wall-panel/bt-call.env
ExecStart=/usr/local/lib/wall-panel/wall-bt-call.py
Restart=always
RestartSec=5
Nice=-5
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
SupplementaryGroups=audio
ExecStopPost=-/bin/rm -f /run/wall-panel/call-state.json
StandardOutput=journal
StandardError=journal
