#cloud-config
# Ubuntu Server autoinstall (cloud-init) for the AWOW AK41 always-on core.
# Flash USB → boot → everything up, zero clicks.
#
# This is the `autoinstall` user-data consumed by the Ubuntu Server 24.04 LTS
# live installer (Subiquity). It:
#   1. Partitions the whole eMMC/SSD (LVM = simple whole-disk layout).
#   2. Creates the hub user (SSH KEY-ONLY by default — WI-10.12).
#   3. Installs Docker Engine + compose plugin + git + Cockpit via late-commands.
#   4. Enables unattended-upgrades (WI-10.12) for hands-off OS security patching.
#   5. Drops the stack/ tree, a placeholder .env, and a first-boot systemd unit
#      onto the target, then enables the unit so the FIRST real boot runs
#      provisioning + `docker compose up -d`.
#
# SECURITY: replace the identity block below (username + SSH PUBLIC key) and DO
# NOT commit a filled-in copy — this template ships with placeholders. The box is
# key-only; there is no usable password login.
#
# See ../README.md "Build the USB" and ../../REMOTE_MANAGEMENT.md for how to
# attach this file and how to manage the headless box over the LAN.

autoinstall:
  version: 1

  # Non-interactive: never stop to ask. Any prompt would defeat "zero clicks".
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # DHCP on the first NIC. Give the box a DHCP RESERVATION at your chosen LAN_IP
  # on the router so it always lands where the split-horizon records point.
  # MATCH `e*`, NOT `en*` — this cost a whole install cycle to learn.
  # `en*` covers systemd's predictable names (eno1 on the AK41's Realtek,
  # enp2s0, enx<mac>) but NOT the plain `eth0` that a VMBus/virtio NIC gets,
  # because predictable naming does not apply to those. In Hyper-V the NIC
  # comes up as `eth0`, so `en*` matched nothing, netplan configured nothing,
  # DHCP never ran, and the install died fetching `cockpit` with apt exit 100
  # — network failure surfacing as a package error, three steps downstream.
  # `e*` is a strict superset: everything `en*` matched, plus eth*. There is no
  # case where `en*` is right and `e*` is wrong.
  # Keeping ONE match for both production and the VM is deliberate — it means
  # the V3 gate actually exercises the config that ships.
  #
  # THE COUPLING THAT MADE THAT BUG EXPENSIVE IS GONE (2026-08-06). "netplan
  # matched nothing" and "the box is empty" were the same event, because the
  # install fetched every package over this link. It no longer fetches
  # anything: `packages:` is empty and everything is installed from a repo of
  # frozen .debs on the payload (see packages.list and late-command 3c). This
  # match is still worth getting right — a hub nobody can reach is a hub nobody
  # can reach — but it is no longer load-bearing for the INSTALL, and a
  # netplan failure now surfaces as a machine with no address rather than as a
  # bare Ubuntu that reported success.
  network:
    version: 2
    ethernets:
      any-eth:
        match:
          name: "e*"
        dhcp4: true

  identity:
    # HOSTNAME is the ROLE, not the hardware (Owner's ruling, same reasoning as
    # the account name below). AWOW is the box that happens to run it today; if
    # it is replaced tomorrow the name should still be right. `awow` stays in
    # documentation, where it describes the machine, and out of anything the
    # running system answers to.
    # NOTE: the install PATH is still /opt/homehub — a separate rename with
    # its own blast radius across firstboot, the systemd units and the sim.
    hostname: homehub
    realname: "Home Hub Operator"
    # ACCOUNT NAME - do not use a name Ubuntu already ships as a USER OR GROUP.
    # This was `operator` until the first real install, which died at
    #   useradd 'operator' ... returned non-zero exit status 9
    # Debian/Ubuntu ship a system GROUP called `operator` (GID 37, straight out
    # of base-passwd's group.master). useradd creates a primary group named
    # after the user, hit the existing one, and exited 9 = "username or group
    # name already in use". It would have failed identically on real hardware —
    # nothing about this was VM-specific.
    # Unusable names, i.e. every group Ubuntu ships: root daemon bin sys adm tty
    # disk lp mail news uucp man proxy kmem dialout fax voice cdrom floppy tape
    # sudo audio dip www-data backup operator list irc src shadow utmp video
    # sasl plugdev staff games users nogroup. render_seed_tree() now refuses to
    # build if this name collides with any of them.
    # `hub` is the ROLE, deliberately not the hardware: AWOW is just the box
    # that happens to run it today.
    username: hub
    # SSH KEY-ONLY box (WI-10.12): no usable password login. "!" is a locked
    # hash — the account cannot be logged into with a password at all. Console/
    # emergency access is via the physical console only. If you MUST allow a
    # password (not recommended for a headless box) replace this with a real
    # `mkpasswd --method=SHA-512` hash AND set ssh.allow-pw: true below.
    password: "!"

  # Remote management is KEY (WI-10.12): SSH on, KEY-ONLY. Paste your PUBLIC key.
  #
  # install-server: FALSE, AND SSHD IS STILL INSTALLED — read this before
  # "fixing" it. `install-server: true` is not a switch that turns sshd on; it
  # adds `openssh-server` to the SAME apt run `packages:` uses, which happens
  # during curtin's install step, BEFORE any late-command. On 2026-08-06 that
  # run had no network, so it died, and the box came up with no sshd AND a
  # password-locked console account — no way in at all, recovered with
  # `init=/bin/bash` from GRUB. openssh-server is now in packages.list and is
  # installed from the baked offline repo by late-command 3c, which also
  # enables ssh.service.
  #
  # authorized-keys STAYS AND WORKS. subiquity applies it through the target's
  # cloud-init user config (99-installer.cfg), which is independent of
  # install-server — that is the only reason it is safe to turn install-server
  # off, since the keys would otherwise go nowhere and a key-only box would be
  # unreachable by construction.
  #
  # allow-pw DOES NOT. This comment used to claim both survived; the second half
  # was wrong and nothing had ever checked it. `sshd -T` on an installed lab hub
  # reported `passwordauthentication yes` and `permitrootlogin without-password`
  # with an EMPTY /etc/ssh/sshd_config.d/ — allow-pw is rendered by cloud-init's
  # set_passwords module during the in-target pass install-server governs, so it
  # went away with it on 2026-08-06 and nobody noticed for two days.
  #
  # It is kept here as the declaration of intent, and late-command 3c-ter now
  # installs the drop-in that actually enforces it. Do not delete either one:
  # this line is what a reader looks for, that one is what sshd reads.
  ssh:
    install-server: false
    allow-pw: false
    authorized-keys:
      # REPLACE with your real public key(s). allow-pw:false above means the box
      # is unreachable over SSH until at least one valid key is present here.
      - "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY you@host"

  # Whole-disk automatic layout (LVM) — DESTRUCTIVE, and pinned on purpose.
  #
  # !! READ THIS BEFORE CHANGING IT !!
  # `layout:` wipes the disk it selects, unattended, with no confirmation:
  # `interactive-sections: []` above means the installer NEVER stops to ask,
  # and the repacked ISO puts `autoinstall` on the kernel command line so it
  # begins immediately at boot. There is NO machine validation step and no
  # "are you sure" — first power-on IS the install.
  #
  # Without a `match:` the installer picks a disk by its own heuristic, and
  # EVERY attached disk is a candidate — including the USB library and backup
  # drives. On this box those are 4 TB and 8 TB, i.e. far larger than the
  # internal disk, so a size-based heuristic would choose exactly the drive
  # holding the family's data. Pinning the path removes that entire class of
  # accident.
  #
  # The AK41's internal disk is an NVMe (FORESEE P900F128GBH, 119.2 GB) — the
  # 2026-07-26 hardware baseline confirms `nvme0n1`; earlier comments in this
  # repo called it eMMC, which was wrong. The library/backup drives enumerate
  # as USB `sd*`, so the nvme path also distinguishes by bus, not just name.
  #
  # DIFFERENT HARDWARE? Change this path (or switch to `serial:`/`model:` —
  # a serial is more precise but is device-identifying, so keep real serials
  # out of this public repo and materialize them from Personal if wanted).
  # STILL RECOMMENDED regardless: physically detach the USB data drives before
  # imaging. Defence in depth costs nothing here.
  storage:
    layout:
      name: lvm
      match:
        path: /dev/nvme0n1

  # EMPTY, DELIBERATELY AND PERMANENTLY (2026-08-06). The list moved to
  # ./packages.list; late-command 3c installs it from a repo of frozen .debs
  # carried on the payload, so the install needs no network at all.
  #
  # WHY IT CANNOT BE "EMPTY EXCEPT FOR A COUPLE OF SAFE ONES": `packages:` runs
  # during curtin's install step, which is BEFORE the first late-command. No
  # apt source a late-command adds can serve it, so every name left here is one
  # more thing this install reaches for the Ubuntu archive to satisfy — and
  # reaching for the archive at all is the failure. On 2026-08-06 the first
  # casualty was `cockpit` (apt exit 100); subiquity errored, late-commands
  # never ran, and the real hub rebooted as a bare Ubuntu that reported
  # success. One entry here is enough to reproduce that exactly.
  #
  # ANYTHING ADDED HERE ALSO BYPASSES EVERY GUARD. export-apt.sh resolves
  # packages.list, assert-installed.sh asserts packages.list, and
  # stage_apt_into_payload refuses a baked repo that disagrees with
  # packages.list. A name here is in none of those.
  packages: []

  # Everything site-specific happens in late-commands, which run in the installer
  # environment with the target mounted at /target. We write files INTO /target.
  #
  # THE ORDER CHANGED ON 2026-08-06, and the reason is the whole offline change.
  # Installing packages used to be steps 1 and 2, at the very top, from
  # download.docker.com and the Ubuntu archive. It is now step 3c, and it CANNOT
  # move back up: it installs from a repo of .debs that arrives with the payload,
  # so it has to run after step 3 has put the payload on the target. Everything
  # that needs an installed package — the Docker config, Cockpit,
  # unattended-upgrades — moved down with it. Sections 1 and 2 are gone rather
  # than renumbered so that 3, 3b, 4, 4b, 5 and 6 keep the identities the rest of
  # this repo refers to them by.
  late-commands:
    # ---- 3. Place the stack ---------------------------------------------------
    # The repo payload is copied by the USB-build step to /cdrom/deploy-payload
    # (a second CIDATA stick, or the remastered ISO) and picked up here into
    # /opt/homehub/. The stack itself then lives at /opt/homehub/stack/.
    - mkdir -p /target/opt/homehub
    # /cdrom IS NOT ENOUGH on the LIGHT path, and this was silent for months.
    # On the REPACKED path /cdrom is the combined ISO and carries
    # /deploy-payload — which is the path every V3 gate has actually used, so
    # nothing ever noticed. On the light path /cdrom is the STOCK Ubuntu ISO,
    # which has no such directory, and the CIDATA seed that does is mounted only
    # transiently by cloud-init to read user-data. The ~470 MB of baked container
    # images the light path carefully stages therefore NEVER REACHED THE BOX:
    # firstboot logged its "no baked image payload found" fallback and pulled
    # from registries instead, which looks like a slow first boot rather than a
    # bug. Found 2026-08-03 by the wall image, which cannot degrade that way.
    # Mount the seed by label as a fallback.
    #
    # NOT FINDING A PAYLOAD IS NOW FATAL, and it was not before 2026-08-06.
    # The old comment here read: "a hub with no payload has a documented
    # degraded mode (firstboot.sh step 3 pulls at compose-up), so say so loudly
    # rather than halting an install that can recover." That was true when the
    # payload carried only the stack and the container images. It is not true
    # now: the payload also carries the APT REPO, and `packages:` is empty, so a
    # box that reaches this point with no payload installs no sshd, no docker
    # and no cockpit. There is no degraded mode for that — it is precisely the
    # 2026-08-06 machine, and the only thing that could "recover" it needs a
    # network to fetch the tools with.
    #
    # Step 6 would refuse the install anyway, three steps later, naming four
    # missing paths and not the cause. Refusing here names the cause.
    #
    # FINDING ONE AND FAILING TO COPY IT IS FATAL, and that is NOT the same
    # thing. Both branches used to read `cp -a … && echo …; exit 0` — and the
    # `exit 0` is a SEPARATE command after the `;`, so it ran whether or not the
    # copy worked. One I/O error partway through ~470 MB of baked images left a
    # HALF-COPIED /target/opt/homehub, reported success, and handed 4b a site/
    # holding only the files that made it across before the error; firstboot
    # then ran on whatever else survived. "No payload" is a recoverable state
    # the box knows how to describe; "some of the payload" is not a state at
    # all. Refuse it, and let Subiquity halt where the operator can see why.
    # (Found by an adversarial review 2026-08-03, alongside OI-19's second head.)
    - >-
      bash -c 'fail_partial() {
      echo "homehub: FATAL - $1";
      echo "homehub: /target/opt/homehub now holds a PARTIAL copy of the deploy unit. Late-command 4b would install only the site files that made it across, and firstboot would run on whatever else survived.";
      echo "homehub: a truncated deploy unit is worse than no deploy unit - it looks installed. Refusing to continue.";
      exit 1; };
      for d in /cdrom /media /media/* /run/media/*; do
      [ -d "$d/deploy-payload" ] || continue;
      cp -a "$d/deploy-payload/." /target/opt/homehub/ || fail_partial "found $d/deploy-payload but cp -a FAILED partway";
      echo "homehub: payload copied from $d/deploy-payload";
      exit 0;
      done;
      dev=$(blkid -L CIDATA 2>/dev/null || true);
      if [ -n "$dev" ]; then m=$(mktemp -d);
      if mount -o ro "$dev" "$m" 2>/dev/null; then
      if [ -d "$m/deploy-payload" ]; then
      cp -a "$m/deploy-payload/." /target/opt/homehub/ || { umount "$m" || true; fail_partial "found deploy-payload on the CIDATA seed at $dev but cp -a FAILED partway"; };
      umount "$m" || { echo "homehub: FATAL - the payload copied from the CIDATA seed at $dev but the seed would NOT unmount."; echo "homehub: the install is about to reboot with the boot medium still busy, and nothing else here can tell whether the copy was flushed. Refusing to guess."; exit 1; };
      echo "homehub: payload copied from the CIDATA seed at $dev";
      exit 0; fi;
      umount "$m" || true; fi; fi;
      echo "homehub: FATAL - no deploy-payload found under /cdrom, /media, /run/media/* or on the CIDATA volume.";
      echo "homehub: the payload carries the BAKED APT REPO this image installs every package from - packages: is empty by design (2026-08-06).";
      echo "homehub: without it late-command 3c installs NOTHING: no openssh-server, no docker, no cockpit. That is the 2026-08-06 machine exactly:";
      echo "homehub: a box that boots, answers pings, and has no way in. There is no degraded mode for it, and fixing it needs a network to fetch the tools with.";
      echo "homehub: the seed ISO carries the payload at its root; on the light path nothing mounts that volume for you. Refusing to install.";
      exit 1'

    # ---- 3b. Decide the deploy unit's PERMISSIONS ------------------------------
    # FOUND BY BOOTING, 2026-08-04. The installed gate VM had `drwxrwxrwx
    # root:root /opt/homehub`, `-rwxrwxrwx stack/.env`, `-rwxrwxrwx
    # docker-compose.yml` and 230 world-writable paths beneath it — and an
    # unprivileged account could READ every credential in .env and WRITE the
    # compose file that root brings up on the next boot. Nothing was
    # malfunctioning: a WSL build stages the payload on an NTFS mount, DrvFs
    # reports 0777 for every path there, Rock Ridge records that honestly and the
    # `cp -a` above copies it honestly. The mode was never DECIDED by anyone.
    #
    # It is decided in TWO places on purpose. vmtest/lib/common.sh
    # (normalize_payload_modes) is the primary fix and gives the payload a real
    # policy — 0755 dirs, 0644 files, 0755 for anything with a `#!`, 0600
    # secrets. This step is the floor underneath it, and it is not merely belt
    # and braces: on the DEFAULT build host the staging filesystem discards
    # chmod outright, so a payload can still arrive here from a build route that
    # never applied the policy. What this asserts is the property that made the
    # finding a security defect rather than untidiness — root-owned, and NOTHING
    # group- or world-writable — and it refuses the install if it cannot get it.
    #
    # `chown -R 0:0` is the OI-18 lesson generalised: `-rock` preserves the
    # BUILDER's uid, which on an ordinary single-user Linux/WSL builder is 1000 —
    # the same uid this image gives `hub`. Ownership, not just mode.
    #
    # It runs BEFORE step 4/4b deliberately: 4b installs the real site files
    # 0600 root:root and tightens what it leaves behind, so this narrows the
    # window rather than fighting it, and the two agree about site/ being 0700.
    #
    # sim-gate/ gets site/'s treatment for site/'s reason: it is the GATE's
    # equivalent seam (generated, never tracked) and its backup.env carries the
    # tracker's bearer token. Added 2026-08-04 after reading the modes actually
    # recorded in a built ISO rather than the ones the staging tree reported —
    # on the DrvFs build path `-chmod_r go-w` is SUBTRACTIVE, so it clears the
    # write bits and leaves `-rwxr-xr-x`, world-READABLE. `stack/.env` has
    # always been in exactly that state on the ISO and has always been tightened
    # here; sim-gate/ was the new seam nobody had told this step about, which is
    # the same sentence as defect #13's.
    - >-
      bash -c 'R=/target/opt/homehub;
      if [ ! -d "$R" ]; then echo "homehub: FATAL - no $R to normalise, though step 3 reported a copy"; exit 1; fi;
      chown -R 0:0 "$R" || { echo "homehub: FATAL - could not take ownership of $R"; exit 1; };
      chmod -R go-w "$R" || { echo "homehub: FATAL - could not clear group/world write on $R"; exit 1; };
      chmod 0755 "$R";
      if [ -d "$R/site" ]; then chmod 0700 "$R/site"; find "$R/site" -type f -exec chmod 0600 {} +; fi;
      if [ -d "$R/sim-gate" ]; then chmod 0700 "$R/sim-gate"; find "$R/sim-gate" -type f -exec chmod 0600 {} +; fi;
      if [ -f "$R/stack/.env" ]; then chmod 0600 "$R/stack/.env"; fi;
      find "$R" -type f -name "*.creds" -exec chmod 0600 {} + ;
      bad=$(find "$R" -perm /022 | head -n 5);
      if [ -n "$bad" ]; then
      echo "homehub: FATAL - $R is STILL group- or world-writable after normalisation:";
      echo "$bad";
      echo "homehub: a writable docker-compose.yml on a box that runs it as root is a local privilege escalation. Refusing to finish an install that leaves one.";
      exit 1;
      fi;
      echo "homehub: /opt/homehub normalised - root-owned, nothing group- or world-writable"'

    # ---- 3c. INSTALL EVERY PACKAGE, FROM THE PAYLOAD, WITH NO NETWORK ---------
    # THE STEP THIS WHOLE IMAGE WAS REARRANGED FOR (2026-08-06). `packages:` is
    # empty and `ssh: install-server` is false, so this is where openssh-server,
    # cockpit, docker-ce, samba and the rest actually arrive. The .debs came in
    # with the payload at /opt/homehub/apt, resolved and PROVEN offline at build
    # time by vmtest/export-apt.sh (a second container, --network none, every
    # archive source deleted, the real list simulated).
    #
    # WHY THE REPO IS A LOCAL PATH INSIDE THE TARGET, and not file:///cdrom/...:
    # whether /cdrom is visible inside the chroot during curtin's package phase
    # is Ubuntu's business, not ours, and this image is not in a position to
    # find out on someone's hardware. By late-commands the target filesystem
    # exists and step 3 has already put the repo INSIDE it, so the question does
    # not arise. Do not "save the copy" by pointing apt at the boot medium.
    #
    # THE LIST IS packages.baked.list, WRITTEN BY THE EXPORTER, and that is
    # deliberate rather than lazy. It is the exporter's own record of what it
    # resolved, so this can never ask apt for a name the repo does not carry;
    # and vmtest/lib/common.sh stage_apt_into_payload refuses to build an ISO
    # whose baked list disagrees with the tracked stack/autoinstall/packages.list
    # riding the same payload. Two files, one meaning, checked at build time
    # where a human can act on it. It also means no comment-stripping parser has
    # to be written a fourth time, in a folded YAML scalar, in single quotes.
    #
    # NOTHING IS WRITTEN TO /etc/apt, and the "what should baked.list look like
    # afterwards?" question is therefore answered by not creating the problem:
    # the source line and an empty parts directory live in /run for the duration
    # of this command, and apt is pointed at them with -o Dir::Etc::*. The
    # target's own ubuntu.sources is never moved, never disabled and never
    # restored, so unattended-upgrades tracks the archive normally from first
    # boot — while THIS apt run cannot touch the network even if there is one.
    # (Verified in a container: scoped, the update reads only file:/repo and
    # returns instantly with --network none; unscoped it hangs on DNS.)
    # APT::Get::List-Cleanup=0 keeps curtin's archive lists, which a scoped
    # update would otherwise prune as "sources no longer configured".
    #
    # --no-remove IS LOAD-BEARING, AND IT IS HERE BECAUSE THIS STEP ONCE BRICKED
    # THE HUB SILENTLY (2026-08-08). packages.list gained one name —
    # `systemd-resolved`, so the resolver would stop being an implicit
    # dependency — and export-apt.sh duly baked systemd 255.4-1ubuntu8.16 to
    # satisfy it. The ISO's base system carries 8.12, and `udev` Depends on
    # systemd (= ${binary:Version}) EXACTLY. `udev` was not a named package, so
    # no 8.16 of it was ever fetched, and apt found the only resolution it had:
    #
    #     Remove: udev, initramfs-tools, busybox-initramfs, cloud-init,
    #             netplan.io, netplan-generator, mdadm, multipath-tools,
    #             open-iscsi, plymouth, snapd, ubuntu-minimal, ubuntu-server
    #
    # It removed the boot infrastructure to install a resolver. No udev means no
    # /dev/disk/by-uuid/* symlinks; the .device units for /boot and /boot/efi
    # (which curtin writes as by-uuid PATHS, and which carry no nofail) never
    # appear; local-fs.target fails; and the box reaches emergency.target on
    # EVERY boot. No netplan.io means no network was ever configured, so it was
    # not merely broken, it was unreachable — and the run reported it as "the hub
    # never appeared on the network within 60 minutes", which reads like the lab.
    #
    # -y ANSWERED THE QUESTION A HUMAN WOULD HAVE STOPPED AT. Interactive apt
    # prints "the following packages will be REMOVED" and waits. Unattended, it
    # just did it.
    #
    # So: this install may UPGRADE and it may INSTALL, and it may never REMOVE.
    # With --no-remove apt exits non-zero instead, `set -e` fails the
    # late-command, and the install stops with the offending package named —
    # which is the difference between a build someone can fix and a machine that
    # boots to a maintenance prompt on a wall.
    #
    # NOTE WHAT DID NOT CATCH THIS. export-apt.sh proves the closure resolves
    # offline, in a throwaway ubuntu:24.04 CONTAINER — which ships no udev, no
    # initramfs-tools and no cloud-init, so the resolution it proved is not the
    # one that runs in /target. And a REMOVAL IS A VALID RESOLUTION: it asked
    # "can apt satisfy this list with no network?", got yes, and never asked
    # what the answer cost. Same shape as the caddy plugin validated with a
    # placeholder token: the check proved the plumbing and nothing about the
    # outcome.
    - >-
      curtin in-target --target=/target -- bash -c 'set -e;
      R=/opt/homehub;
      [ -s "$R/apt/Packages" ] || { echo "homehub: FATAL - no baked apt repo at $R/apt (no Packages index)."; echo "homehub: packages: is empty by design, so this install would produce a bare Ubuntu with no sshd. Refusing."; exit 1; };
      [ -s "$R/apt/packages.baked.list" ] || { echo "homehub: FATAL - $R/apt carries no packages.baked.list, so nothing here knows what to install."; exit 1; };
      mkdir -p /run/baked-apt/parts;
      echo "deb [trusted=yes] file://$R/apt ./" > /run/baked-apt/sources.list;
      APT="-o Dir::Etc::sourcelist=/run/baked-apt/sources.list -o Dir::Etc::sourceparts=/run/baked-apt/parts -o APT::Get::List-Cleanup=0";
      export DEBIAN_FRONTEND=noninteractive;
      apt-get $APT update;
      xargs -a "$R/apt/packages.baked.list" apt-get $APT install -y --no-install-recommends --no-remove;
      echo "homehub: installed $(wc -l < "$R/apt/packages.baked.list") package(s) from the baked repo, with no network at all"'
    # ENABLE THEM EXPLICITLY. Every one of these is enabled by its own postinst
    # in an ordinary install, and none of them can be RELIED on to be: curtin
    # runs the chroot behind a policy-rc.d, and a unit that is merely "installed"
    # on a headless box is a service that does not exist. sshd most of all —
    # this account has a locked password, so a box that boots with ssh.service
    # not enabled has no way in, which is the 2026-08-06 failure reproduced by a
    # different road.
    - curtin in-target --target=/target -- systemctl enable ssh
    # Cockpit web console on :9090 — LAN-only (do NOT proxy it through Caddy to
    # the public internet). See ../../REMOTE_MANAGEMENT.md.
    - curtin in-target --target=/target -- systemctl enable cockpit.socket

    # ---- 3c-bis. THE PIECE THE LOCKED PASSWORD REQUIRES ----------------------
    # WITHOUT THIS THE BOX IS UNMAINTAINABLE OVER SSH, and that was true from the
    # first image until 2026-08-07. `hub` is in the sudo group, but `password:
    # "!"` above is a LOCKED hash, so `sudo` demanded a password that cannot
    # exist:
    #     sudo: a password is required
    # No apt, no /etc edits, no systemctl, and healthcheck.sh could not even read
    # its own .env. Cockpit was dead for the same reason — its login is PAM
    # against the same locked password — and so was the console. Measured on an
    # installed lab hub, not inferred.
    #
    # THIS IS THE STANDARD CLOUD-IMAGE POSTURE AND THE IMAGE HAD TWO OF ITS THREE
    # PARTS. Ubuntu's own /etc/cloud/cloud.cfg ships:
    #     default_user: { lock_passwd: True, sudo: ["ALL=(ALL) NOPASSWD:ALL"] }
    # and AWS, GCP, Azure, DigitalOcean and Hetzner all image that way. Key-only
    # SSH plus a locked password plus passwordless sudo is one design, not three
    # choices: the SSH KEY IS THE CREDENTIAL, and a password behind it protects
    # nothing from anyone already holding the key. We had the first two and not
    # the third, because subiquity's `identity:` block has no way to express a
    # sudoers rule — its `password:` is meant to be a real hash, so adopting the
    # cloud posture there silently drops cloud-init's compensating drop-in.
    #
    # ALL, NOT AN ALLOWLIST, and that is a considered choice rather than
    # laziness. On the hub it changes no exposure whatsoever: `hub` is in the
    # `docker` group, and the docker socket is root by design — `docker run
    # -v /:/host` reads and writes anything, with no password, today. What this
    # adds is AUDITABILITY: sudo journals every command it runs, while the docker
    # path logs only that a container started. An allowlist would also need
    # extending for every new workflow, which is how allowlists become ALL with
    # extra steps.
    #
    # VALIDATED BEFORE IT IS INSTALLED, and that is not ceremony. A malformed
    # sudoers file breaks sudo for EVERY user, on a box whose only account has a
    # locked password — precisely the no-way-in state that cost a GRUB rescue via
    # init=/bin/bash on 2026-08-06. So it is written to a temp path, checked with
    # `visudo -cf`, and only then moved into place; a failed check leaves the box
    # exactly as it was and fails the install loudly instead.
    - |
      curtin in-target --target=/target -- bash -c '
      set -e
      T=$(mktemp)
      printf "%s\n" \
        "# Managed by the HomeHub autoinstall. See stack/autoinstall/user-data 3c-bis." \
        "# The SSH key is the credential: this account has a LOCKED password, so" \
        "# without this line sudo can never succeed and the box cannot be maintained." \
        "hub ALL=(ALL) NOPASSWD:ALL" > "$T"
      visudo -cf "$T"
      install -o root -g root -m 0440 "$T" /etc/sudoers.d/90-homehub-ops
      rm -f "$T"
      echo "homehub: /etc/sudoers.d/90-homehub-ops installed and validated"'

    # ---- 3c-ter. THE OTHER HALF OF KEY-ONLY, WHICH `allow-pw: false` DID NOT DO -
    # MEASURED ON AN INSTALLED LAB HUB, 2026-08-07. `sshd -T` on a box built from
    # this file reports:
    #     passwordauthentication yes
    #     permitrootlogin without-password
    # and /etc/ssh/sshd_config.d/ is EMPTY. The `ssh:` block above sets
    # `allow-pw: false`, and the comment beside it asserts that authorized-keys
    # and allow-pw are "unaffected" by `install-server: false`. Half of that is
    # true: the KEYS land, which is why anyone can log in at all. The hardening
    # does not. subiquity renders allow-pw through cloud-init's set_passwords
    # module, which writes its drop-in during the same in-target pass that
    # `install-server` governs — so turning install-server off on 2026-08-06 to
    # make the offline install work silently took the hardening with it.
    #
    # IT IS A CLAIM NOTHING EVER CHECKED, which is the shape of nearly every
    # defect this project has found by booting the thing. assert-installed.sh
    # now asserts the EFFECTIVE policy out of `sshd -T`, so it cannot go quiet
    # again.
    #
    # WHAT IT COSTS TODAY: nothing visible, and that is exactly why it survived.
    # Both accounts carry `password: "!"`, a locked hash no password can satisfy,
    # so there is no credential to guess and the box is key-only in practice. It
    # is key-only by ACCIDENT rather than by CONFIGURATION — one `passwd hub` (an
    # explicit instruction in this repo's own handoff, for console recovery) turns
    # a locked box into a password-authenticating one reachable from the whole
    # LAN, with nothing anywhere reporting the change.
    #
    # VALIDATED BEFORE IT COUNTS, and DIFFERENTIALLY, which is the part worth
    # reading. A broken sshd_config stops sshd starting at all, on a headless box
    # whose only other door is a locked console — so the file has to be checked.
    # But the naive check (`sshd -t || exit 1`) would BRICK EVERY BUILD for a
    # reason that has nothing to do with this file: inside curtin's chroot the
    # target may have no host keys yet, and `sshd -t` fails with "no hostkeys
    # available" regardless of what the config says. An install that refuses over
    # that is worse than the defect being fixed.
    #
    # So: run it with the drop-in, and if that fails, run it WITHOUT. If it fails
    # both ways the fault is the chroot's and the file is kept with a warning; if
    # it fails only with the file, the file is the fault and the install stops.
    # The test therefore measures OUR change and nothing else.
    - |
      curtin in-target --target=/target -- bash -c '
      set -e
      D=/etc/ssh/sshd_config.d
      mkdir -p "$D"
      F="$D/90-homehub-hardening.conf"
      printf "%s\n" \
        "# Managed by the HomeHub autoinstall. See stack/autoinstall/user-data 3c-ter." \
        "# autoinstall ssh.allow-pw: false does NOT survive install-server: false." \
        "# Measured 2026-08-07: sshd -T said passwordauthentication yes and this" \
        "# directory was empty. assert-installed.sh checks the effective policy." \
        "PasswordAuthentication no" \
        "KbdInteractiveAuthentication no" \
        "PermitRootLogin no" \
        "PubkeyAuthentication yes" > "$F"
      chmod 0644 "$F"
      if sshd -t 2>/tmp/sshd-t.with; then
        echo "homehub: $F installed and validated (sshd -t)"
      else
        mv "$F" /tmp/90-homehub-hardening.conf
        if sshd -t 2>/dev/null; then
          echo "homehub: FATAL - the sshd hardening drop-in does not parse:" >&2
          cat /tmp/sshd-t.with >&2
          echo "homehub: removed it. A box that boots with a broken sshd_config has NO" >&2
          echo "homehub: door: the console password is locked and there is no other way in." >&2
          exit 1
        fi
        install -o root -g root -m 0644 /tmp/90-homehub-hardening.conf "$F"
        echo "homehub: WARN - sshd -t cannot run in this chroot (it fails with and without" >&2
        echo "homehub: the drop-in, so the drop-in is not the cause). Keeping it; the boot-time" >&2
        echo "homehub: check is assert-installed.sh reading sshd -T on the running box." >&2
        cat /tmp/sshd-t.with >&2
      fi'

    # ---- 3d. Docker configuration (the engine came from 3c) -------------------
    # The three late-commands that used to live at the top of this file — fetch
    # Docker's GPG key, write /etc/apt/sources.list.d/docker.list, apt-get
    # install docker-ce — are GONE. docker-ce and its four companions are in
    # packages.list, export-apt.sh notices them and adds download.docker.com to
    # its resolver, and the .debs ride the payload like everything else. That
    # removes the last install-time dependency on Docker's CDN.
    #
    # It also removes a diagnostic: /etc/apt/keyrings/docker.asc being ABSENT is
    # what located the 2026-08-06 failure as earlier than late-commands. Nothing
    # writes that file any more, so its absence means nothing; assert-installed.sh
    # and step 6 are what answer that question now.
    #
    # Docker log rotation (review 2026-07-10): the default json-file driver grows
    # unbounded — a slow disk-filler on an always-on box with small eMMC/SSD
    # (Technitium/Caddy log every query/request). The "local" driver rotates by
    # default (per-container cap), so one line prevents the failure mode.
    # YAML: this entry is a FOLDED BLOCK SCALAR (>-), not a plain scalar like
    # its neighbours, and it has to stay one. The JSON below contains ": "
    # (colon-space); inside a PLAIN scalar YAML reads that as a mapping key, so
    # the list item parses as a dict instead of a string and Subiquity rejects
    # the entire section with "Malformed autoinstall in 'late-commands'
    # section" — the install dies before it starts. Block scalars take their
    # content literally, so the colon is harmless. The neighbouring entries get
    # away with plain scalars only because their colons are in "://" (no
    # following space). Caught on the first real boot of the V3 gate.
    - >-
      curtin in-target --target=/target -- bash -c 'mkdir -p /etc/docker && echo "{ \"log-driver\": \"local\" }" > /etc/docker/daemon.json'
    - curtin in-target --target=/target -- systemctl enable docker
    - curtin in-target --target=/target -- usermod -aG docker hub

    # ---- 3e. unattended-upgrades (WI-10.12) -----------------------------------
    # Enable unattended security upgrades non-interactively. This is also what
    # catches the box up on everything the FROZEN debs are behind on, the first
    # time it sees a network — which is the accepted cost of baking them.
    - curtin in-target --target=/target -- bash -c 'echo "unattended-upgrades unattended-upgrades/enable_auto_updates boolean true" | debconf-set-selections'
    - curtin in-target --target=/target -- dpkg-reconfigure -f noninteractive unattended-upgrades
    - curtin in-target --target=/target -- systemctl enable unattended-upgrades

    # ---- 3f. Low-power lightening (Owner, 2026-07-04) -------------------------
    # Nothing in the stack uses snaps; snapd costs RAM + background churn on a
    # low-power box. Purge it. (powertop tuning is applied per-boot by
    # powertune.service, installed in step 5 — auto-tune does not persist.)
    # Purge and autoremove are local dpkg/apt operations and need no network,
    # which is why this can stay where it always was in the sequence.
    - curtin in-target --target=/target -- bash -c 'DEBIAN_FRONTEND=noninteractive apt-get purge -y snapd 2>/dev/null || true; apt-get autoremove -y --purge'

    # ---- 4. Seed .env from the example if the operator did not pre-fill one ----
    - curtin in-target --target=/target -- bash -c '[ -f /opt/homehub/stack/.env ] || cp /opt/homehub/stack/.env.example /opt/homehub/stack/.env'

    # ---- 4b. SITE payload: real materialized config + secrets (A14) ------------
    # deploy-payload/site/ is written by Build-VentoyStick.ps1 from
    # Personal\homelab\deploy\out\ — the REAL values, not the sim placeholders
    # the vmtest builders bake. A sim/vmtest build legitimately has no site/ at
    # all, and on that path this whole block is a documented no-op.
    #
    # IT READS THE PAYLOAD STEP 3 ALREADY COPIED, not the boot medium (OI-19).
    # This used to start `S=/cdrom/deploy-payload/site` with a `/media/...`
    # fallback and then `[ -d "$S" ] || exit 0` — a SILENT SUCCESS built on the
    # same wrong assumption that cost an install cycle on 2026-08-03: /cdrom is
    # the BOOT MEDIUM, not the seed. On the repacked path (the one
    # Build-VentoyStick.ps1 uses today) /cdrom is the combined ISO and does
    # carry /deploy-payload, so this worked. On the LIGHT path — the one this
    # repo recommends by default, and a supported way to build a production hub
    # (SITE_DIR=… bash vmtest/build-seed.sh) — /cdrom is the STOCK Ubuntu ISO
    # and the CIDATA seed carrying the payload is mounted only transiently by
    # cloud-init. A production hub would then install NONE of its six real
    # files and come up on .env.example placeholders while believing it is
    # production.
    #
    # The fix deliberately adds NO second search. Step 3 above already tries
    # /cdrom, /media, /media/*, /run/media/* and finally mounts the CIDATA
    # volume by label, and it copies the WHOLE payload — site/ included — to
    # /target/opt/homehub/. One discovery mechanism, one place it can rot. This
    # is the same shape the wall image uses (its late-command 4a reads
    # /opt/wall-panel/site/wall.env rather than searching again).
    #
    # AND IT REFUSES, when a PRODUCTION image is what was asked for. BUILD_PROFILE
    # below is `production` in the tracked template — which is what
    # Materialize-Deploy.ps1 renders user-data.filled from — and
    # vmtest/lib/common.sh rewrites it to `sim` on the sim path (asserting the
    # rewrite applied, so a silent no-op cannot make a sim image refuse). The
    # safe value is therefore the default and the sim build has to opt out of it.
    # A production box that quietly degrades to sim config is the failure mode
    # this exists to prevent: the "a dead panel must be a visible event, not
    # silence" doctrine, applied to a headless box where the only screen is the
    # journal.
    #
    # AN ABSENT `optional` FILE IS LOUD BUT NOT FATAL, on purpose:
    # Build-VentoyStick.ps1 marks cifs.creds, samba-users.creds and
    # drive-identity.conf optional (Required=$false), so refusing the install
    # over one of them would refuse legitimate households.
    #
    # AN ABSENT `required` FILE NOW HALTS THE INSTALL (rc=1). It used to only
    # print and `continue`, and that was OI-19 wearing a second hat: a payload
    # whose site/ directory EXISTS but is empty of everything that matters
    # sailed past the missing-directory refusal above, logged six MISSING lines
    # nobody reads on a headless box, touched .site-present so firstboot's own
    # "broken production stick" branch stayed quiet, and exited 0. The outcome
    # was byte-for-byte the outcome OI-19 was raised about — a production hub on
    # .env.example placeholders believing it is production — reached by a
    # different road. The directory's existence was never the property worth
    # checking; the FILES are.
    # NOTE FOR RATIFICATION (docs/status.md OI-19/A10): this closes that open
    # ruling in the REFUSE direction. It is the same call the missing-directory
    # branch above already makes, and the same call the wall image makes; it is
    # recorded rather than assumed, and the Owner can reverse it by moving a
    # file from `required` to `optional` in the table below.
    #
    # site/config.json IS NOT IN THIS TABLE, and that is deliberate. It is the
    # kiosk shell's runtime config and its destination is a WEB ROOT
    # (/opt/homehub/stack/wall-shell/), not /etc — and firstboot.sh step 3d
    # untars the site tarball OVER that directory, so anything this step wrote
    # there could be overwritten hours later. firstboot.sh step 3e installs it
    # instead, after the untar. The two site-file lists (here and
    # vmtest/lib/common.sh's staging loop) are cross-referenced from both ends
    # for exactly this reason: they are hand-maintained and they must not drift.
    #
    # Modes matter: every file here is a secret artifact. .env and the *.creds
    # files carry live credentials, so they are installed 0600 root-owned. The
    # smb.conf fragment and fstab are not secret but are still root-only to
    # keep the whole site/ tree consistent. The payload COPY of site/ is
    # tightened too — its modes come from whatever filesystem the ISO was
    # staged on, and a build run under WSL on /mnt/c produces 0777.
    - mkdir -p /target/etc/homehub-samba /target/etc/homehub-backup
    - >-
      bash -c 'BUILD_PROFILE=production;
      S=/target/opt/homehub/site;
      if [ ! -d "$S" ]; then
      if [ "$BUILD_PROFILE" = production ]; then
      echo "homehub: FATAL - this is a PRODUCTION image and the deploy payload carried no site/ directory.";
      echo "homehub: none of .env, backup.env, cifs.creds, samba-users.creds, smb.conf.fragment or library-mounts.fstab would be installed,";
      echo "homehub: so the box would come up on .env.example placeholders while believing it is production. Refusing to install that.";
      echo "homehub: step 3 above reports where the payload was found; site/ is staged into it by vmtest/lib/common.sh from SITE_DIR.";
      exit 1;
      fi;
      echo "homehub: no site/ in the payload - SIM build, so the stack runs on .env.example placeholders (expected for a vmtest image).";
      exit 0;
      fi;
      chmod 0700 "$S" || true;
      rc=0;
      for spec in ".env:/target/opt/homehub/stack/.env:required"
      "backup.env:/target/etc/homehub-backup/backup.env:required"
      "cifs.creds:/target/etc/homehub-backup/cifs.creds:optional"
      "samba-users.creds:/target/etc/homehub-samba/samba-users.creds:optional"
      "smb.conf.fragment:/target/etc/homehub-samba/smb.conf.fragment:required"
      "library-mounts.fstab:/target/etc/homehub-samba/library-mounts.fstab:required"
      "drive-identity.conf:/target/etc/homehub-samba/drive-identity.conf:optional"; do
      f=${spec%%:*}; rest=${spec#*:}; d=${rest%:*}; kind=${rest##*:};
      if [ ! -f "$S/$f" ]; then
      if [ "$kind" = required ]; then
      echo "homehub: FATAL - required site file MISSING - site/$f is not in the payload, so nothing was installed at $d";
      rc=1;
      else
      echo "homehub: optional site file MISSING - site/$f is not in the payload, so nothing was installed at $d";
      fi;
      continue;
      fi;
      if install -m600 -o root -g root "$S/$f" "$d"; then
      chmod 600 "$S/$f" || true;
      echo "homehub: installed site/$f -> $d";
      else
      echo "homehub: FATAL - site/$f is present but could not be installed to $d";
      rc=1;
      fi;
      done;
      touch /target/etc/homehub-samba/.site-present;
      if [ "$rc" -ne 0 ]; then
      echo "homehub: REFUSING to finish a PRODUCTION install whose site/ payload is incomplete - the box would come up on .env.example placeholders while believing it is production, and nothing on a headless machine would say so.";
      echo "homehub: the site/ directory existed, so the check above passed; what is missing are the files named FATAL over it.";
      fi;
      exit $rc'

    # ---- 5. Install + enable the first-boot unit ------------------------------
    - cp /target/opt/homehub/stack/autoinstall/homehub-firstboot.service /target/etc/systemd/system/homehub-firstboot.service
    - cp /target/opt/homehub/stack/autoinstall/firstboot.sh /target/usr/local/sbin/homehub-firstboot.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/homehub-firstboot.sh
    - curtin in-target --target=/target -- systemctl enable homehub-firstboot.service
    # Low-power tune unit (per-boot powertop auto-tune + USB-storage guard).
    - cp /target/opt/homehub/stack/autoinstall/powertune.service /target/etc/systemd/system/powertune.service
    - cp /target/opt/homehub/stack/autoinstall/powertune.sh /target/usr/local/sbin/powertune.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/powertune.sh
    - curtin in-target --target=/target -- systemctl enable powertune.service
    # Backup-drive default standby unit (per-boot hdparm -S spin-down — WI-10.10).
    # Runs from the stack dir (sources common.sh) like homehub-backup.service, so we
    # only install the unit + make the script executable; no cp to /usr/local/sbin.
    # A no-op until BACKUP_DRIVE_DEVICES is set in /etc/homehub-backup/backup.env.
    - cp /target/opt/homehub/stack/backup/systemd/backup-standby.service /target/etc/systemd/system/backup-standby.service
    - curtin in-target --target=/target -- chmod +x /opt/homehub/stack/backup/backup-standby.sh
    - curtin in-target --target=/target -- systemctl enable backup-standby.service
    # ---- 5b. THE BACKUP SERVICE ITSELF, WHICH WAS NEVER INSTALLED ------------
    # FOUND 2026-08-08 by verify-hub.sh section 9, on a hub that was otherwise
    # healthy: `systemctl is-enabled homehub-backup.timer` answered NOT-FOUND.
    # Not disabled — ABSENT. stack/backup/systemd/ carries three units and the
    # line above copied exactly one of them, so homehub-backup.service and
    # homehub-backup.timer shipped in the payload to every box ever built and
    # were never put anywhere systemd would look.
    #
    # WHAT THAT MEANS, PLAINLY: the backup has never run, on any machine, ever.
    # Not "ran and failed" — never fired. The whole storage-map §4b/§4c contract
    # (wake Mini-serv, ingest, pull, archive, hash, report, retain) is code that
    # has been carried around and never executed, and `restore.sh` is the
    # recovery half of a contract with no forward half.
    #
    # WHY NOTHING NOTICED, and it is the same shape as the sshd finding above.
    # backup-standby.service — the spin-down unit from the SAME directory — was
    # installed, so `systemctl | grep backup` looked populated. The two
    # drive-health timers firstboot installs are also named ...backup..., and
    # they DO run. Three units answering to the name, one of them the one that
    # matters, absent. The docs never claimed it worked; nothing had ever asked.
    #
    # The timer is enabled, not started: OnCalendar fires it. backup.sh refuses
    # loudly when the target is not a mountpoint (measured — it is the one part
    # of this that has been exercised), so a first boot with no drive attached
    # is a named failure rather than a backup written to the system disk.
    - cp /target/opt/homehub/stack/backup/systemd/homehub-backup.service /target/etc/systemd/system/homehub-backup.service
    - cp /target/opt/homehub/stack/backup/systemd/homehub-backup.timer /target/etc/systemd/system/homehub-backup.timer
    - curtin in-target --target=/target -- chmod +x /opt/homehub/stack/backup/backup.sh
    - curtin in-target --target=/target -- chmod +x /opt/homehub/stack/backup/restore.sh
    - curtin in-target --target=/target -- systemctl enable homehub-backup.timer
    # ---- 5c. THE LIBRARY BACKUP — the FileBackup container's host side (E2) ---
    # The SECOND backup unit, and not a replacement for the one above: that one
    # keeps cifs ingest, the volume: sets, the Mini-serv set and WoL; this one
    # takes the nine library path: sets, with dedup and Snapshot_<date> history
    # instead of the eight full copies they would otherwise need. Both units
    # have to exist for the household to be covered.
    #
    # THE CONFIG IS NOT A SITE ARTIFACT, which is why it is installed from the
    # payload here rather than from site/ in step 4. Every path inside
    # filebackup.json is a container-internal mount target fixed by
    # docker-compose.yml — /source, /state, /backup, /changes — so it carries no
    # secret, no serial and nothing site-specific, and it is tracked in the repo
    # like the mosquitto config. Hence 0644 root (readable, since the container
    # binds it read-only) rather than the 0600 the site secrets get.
    - install -m0644 -o root -g root /target/opt/homehub/stack/backup/filebackup.json /target/etc/homehub-backup/filebackup.json
    - cp /target/opt/homehub/stack/backup/systemd/homehub-library-backup.service /target/etc/systemd/system/homehub-library-backup.service
    - cp /target/opt/homehub/stack/backup/systemd/homehub-library-backup.timer /target/etc/systemd/system/homehub-library-backup.timer
    - curtin in-target --target=/target -- chmod +x /opt/homehub/stack/backup/library-backup.sh
    - curtin in-target --target=/target -- systemctl enable homehub-library-backup.timer
    # ---- 5d. ASSERT THE TIMER IS ACTUALLY THERE (the defect-22 lesson) --------
    # Defect 22 is the reason this block exists at all: stack/backup/systemd/
    # held three units, a late-command copied exactly ONE of them, and
    # `systemctl is-enabled homehub-backup.timer` answered NOT-FOUND on every
    # box ever built. Not disabled — ABSENT. The nightly backup had never fired
    # on any machine, and nothing in the install noticed because the copy that
    # was missing succeeded at being missing.
    #
    # So the new units check their own installation, at the moment of it. The
    # cost of getting this wrong is not a failed install; it is a box that looks
    # installed and never backs its library up.
    #
    # `is-enabled`, NOT `list-timers`, AND THAT IS A LIMIT WORTH NAMING.
    # `systemctl list-timers` needs a RUNNING systemd to ask, and this runs in a
    # curtin chroot where there is none — it would fail on the bus every time,
    # which means it could never distinguish a missing timer from a chroot. What
    # IS answerable offline is whether the unit files landed and whether
    # `enable` created its symlink, and that is precisely the state defect 22
    # found wrong. The real `list-timers` assertion (next-elapse in the future)
    # lives in firstboot.sh step 6b, on a booted box where the question has an
    # answer; docs/LAB_TEST_PLAN.md TC-H-M13 is the third layer.
    - |
      curtin in-target --target=/target -- bash -c '
        rc=0
        for u in homehub-backup.timer homehub-library-backup.timer; do
          if [ ! -f "/etc/systemd/system/$u" ]; then
            echo "homehub: FATAL - $u was never copied to /etc/systemd/system." >&2
            rc=1
            continue
          fi
          state="$(systemctl is-enabled "$u" 2>&1 || true)"
          if [ "$state" != "enabled" ]; then
            echo "homehub: FATAL - $u is present but is-enabled says \"$state\" (want: enabled)." >&2
            rc=1
            continue
          fi
          echo "homehub: $u installed and enabled."
        done
        for f in /etc/homehub-backup/filebackup.json \
                 /opt/homehub/stack/backup/library-backup.sh; do
          [ -s "$f" ] || { echo "homehub: FATAL - $f is missing or empty." >&2; rc=1; }
        done
        if [ "$rc" -ne 0 ]; then
          echo "homehub: refusing to finish an install whose backup timers are not installed." >&2
          echo "homehub: a box that looks installed and never backs up is exactly defect 22, and it" >&2
          echo "homehub: went unnoticed for months because nothing ever asked this question." >&2
          exit 1
        fi
      '
    # ---- 6. REFUSE TO FINISH AN INSTALL THAT DID NOT PRODUCE ITS ARTIFACTS ----
    # 2026-08-06. An install reported success and produced a box with no
    # /opt/homehub, no openssh-server, no docker and no cockpit - i.e. a bare
    # Ubuntu wearing the right hostname, unreachable because the console
    # account is password-locked and sshd was never installed. Every stage
    # above had "succeeded" in the sense of not stopping.
    #
    # So the last thing the install does is check its own work. `exit 1` here
    # makes Subiquity fail visibly and run error-commands, which now preserves
    # the logs - rather than rebooting into a machine whose emptiness is
    # discovered an hour away from the toolchain.
    #
    # THIS CANNOT CATCH EVERYTHING, and the limit is worth stating: if the
    # failure happens BEFORE late-commands run, this block never executes and
    # the install still reboots green. That case is caught after boot instead,
    # by vmtest/assert-installed.sh. The two layers exist because neither
    # covers the other.
    #
    # IT NOW CHECKS THE PACKAGES TOO, one dpkg-query per name in the baked list,
    # and that is not redundant with the four paths above. Those four are a
    # sample chosen because they were the visible casualties; the list is the
    # actual claim the offline install makes. A repo missing one deb installs
    # everything else and leaves, say, `hdparm` absent — invisible in a path
    # check, invisible on a headless box, and a build-time refusal is no longer
    # available because the ISO is already written. Cheap: ~40 dpkg-query calls.
    - |
      curtin in-target --target=/target -- bash -c '
        missing=""
        for p in /opt/homehub /usr/sbin/sshd /usr/bin/docker \
                 /etc/systemd/system/homehub-firstboot.service; do
          [ -e "$p" ] || missing="$missing $p"
        done
        if [ -n "$missing" ]; then
          echo "homehub: FATAL - the install is incomplete. Missing:$missing" >&2
          echo "homehub: refusing to reboot into a box that looks installed and is not." >&2
          exit 1
        fi
        L=/opt/homehub/apt/packages.baked.list
        if [ ! -s "$L" ]; then
          echo "homehub: FATAL - $L is absent, so late-command 3c cannot have installed anything." >&2
          exit 1
        fi
        notinst=""
        while read -r pkg; do
          [ -n "$pkg" ] || continue
          dpkg-query -W -f=\${Status} "$pkg" 2>/dev/null | grep -q "^install ok installed$" \
            || notinst="$notinst $pkg"
        done < "$L"
        if [ -n "$notinst" ]; then
          echo "homehub: FATAL - the baked repo did not install:$notinst" >&2
          echo "homehub: every one of those is in packages.list and was proven resolvable offline at build time," >&2
          echo "homehub: so the payload and the repo that was baked have drifted apart. Refusing to reboot." >&2
          exit 1
        fi
        echo "homehub: install completeness check passed ($(wc -l < "$L") baked package(s) installed)."
      '

  # ── If the install does not run, SAY WHY, on the console (2026-08-06) ──────
  # The `match:` above halts by design on any machine it does not recognise.
  # What Subiquity prints is `Failed to find matching device for {'serial':
  # ...}` and nothing else — so "wrong machine" and "right machine, wrong
  # serial format" look identical, and the operator is left with a rebooting
  # box and no information. It also offers "press enter to start a shell" that
  # cannot be accepted: `interactive-sections: []` plus `shutdown: reboot`
  # take the box down first. That combination cost a site visit on 2026-08-06.
  #
  # This does NOT rescue the install — by the time it runs the config is
  # applied and the target is decided. It makes the halt legible and names the
  # way out. If the failure comes early enough that error-commands never fire,
  # the GRUB entries are still there, which is why the way out is a menu entry
  # and not something that depends on this block running.
  #
  # THE EXPECTED PIN IS READ BACK FROM THE SEED, not written here: this
  # template is public and the serial is T1 (HomeHub's Materialize-Deploy
  # substitutes it in from Personal). Nothing device-identifying is hardcoded.
  error-commands:
    - |
      {
        echo
        echo "=============================================================="
        echo " THE INSTALL FAILED."
        echo "=============================================================="
        echo
        # WAS ANYTHING WRITTEN? DETERMINE IT, NEVER ASSUME IT.
        #
        # This banner used to assert "Nothing was written to any disk"
        # unconditionally, because it was written assuming the only way to
        # reach error-commands was the storage-pin halt, where nothing has been
        # touched yet. On 2026-08-06 it printed exactly that over a disk that
        # had already been partitioned and imaged - the failure was a LATER
        # stage - and the operator reasonably believed the disk was untouched.
        # A confident wrong answer about whether a disk was written is worse
        # than no answer at all.
        #
        # /proc/mounts rather than mountpoint(1): always present, no package.
        if grep -q ' /target ' /proc/mounts 2>/dev/null; then
          TARGET_MOUNTED=yes
          echo "STATE: /target IS MOUNTED - the target disk HAS been written."
          echo "       This is NOT the storage-pin halt. A PARTIAL INSTALL exists"
          echo "       on the disk below, and it may well boot while being"
          echo "       incomplete. Do not assume the machine is untouched."
        else
          TARGET_MOUNTED=no
          echo "STATE: /target is not mounted."
          echo "       Most likely nothing was written by THIS run - but that is"
          echo "       an inference from what is visible now, not a guarantee."
        fi
        echo
        # PRESERVE THE EVIDENCE. Subiquity copies /var/log/installer to the
        # target only on SUCCESS, so a failed install's logs die with the live
        # system at the reboot that follows. On 2026-08-06 that is precisely
        # what happened, and the post-mortem had nothing to read: the installed
        # disk carried only the live medium's casper files.
        if [ "$TARGET_MOUNTED" = yes ] && cp -a /var/log/installer /target/var/log/installer-failed 2>/dev/null; then
          echo "LOGS: saved to /var/log/installer-failed/ ON THE TARGET DISK."
          echo "      They survive the reboot - read them from the installed system."
        else
          echo "LOGS: could NOT be saved to the target. They are at"
          echo "      /var/log/installer on this LIVE system and die at reboot."
          echo "      Copy them off NOW if you need them."
        fi
        echo
        echo "-- the tail of the installer's own log --"
        tail -n 25 /var/log/installer/subiquity-server-debug.log 2>/dev/null \
          || echo "   (no subiquity-server-debug.log - the failure was very early)"
        echo
        echo "-- the disk this image expects (its pin, read back from the seed) --"
        for f in /autoinstall.yaml /cdrom/nocloud/user-data; do
          [ -f "$f" ] || continue
          sed -n '/^  storage:/,/^  [a-z]/p' "$f" | grep -E '^ +(serial|model|path|wwn):' && break
        done
        echo
        echo "-- the disks this machine actually reports --"
        lsblk -dn -o NAME,SIZE,MODEL,SERIAL 2>/dev/null
        echo
        echo "-- udev ID_SERIAL per disk (THIS is what 'match: serial' compares) --"
        for d in /dev/sd? /dev/nvme?n? /dev/mmcblk?; do
          [ -b "$d" ] || continue
          echo "   $d  $(udevadm info --query=property --name="$d" 2>/dev/null | sed -n 's/^ID_SERIAL=//p')"
        done
        echo
        # The advice DIFFERS by state, because the wrong advice here costs an
        # evening. The GRUB entries solve a pin that matched nothing; they solve
        # nothing at all once curtin has written the disk.
        if [ "$TARGET_MOUNTED" = yes ]; then
          echo "THE DISK WAS ALREADY WRITTEN, so this is NOT the pin halting and"
          echo "the unpinned GRUB entry will not help. The cause is in the log"
          echo "above and in /var/log/installer-failed/ on the installed system."
          echo "Expect a machine that boots and is INCOMPLETE."
        else
          echo "If a disk above IS this machine's internal disk, the pin is most"
          echo "likely the SHORT serial. Subiquity matches udev ID_SERIAL, usually"
          echo "MODEL_SERIAL_LUN - not the bare serial on the sticker or in lsblk."
          echo
          echo "TO INSTALL ON THIS MACHINE ANYWAY, now, without rebuilding the ISO:"
          echo "  reboot, and at the GRUB menu (10 second timeout) choose"
          echo "    Install - choose target disk manually (unpinned)"
          echo "  It stops at the storage screen for you to pick and confirm a disk."
          echo
          echo "TO LOOK AROUND FIRST: choose 'Diagnostic Shell (no autoinstall)'."
        fi
        echo "=============================================================="
        echo
      } > /dev/console 2>&1

  # No reboot prompt — power-cycle straight into the running box.
  shutdown: reboot
