# WSN-019 / B14: credential-isolated, explicit-start Door preview broker.
# Firstboot extracts only the Door allowlist into root-only files under /run.
# systemd copies those into this service's RAM-backed credential mount; the
# broker never receives Wi-Fi, share, music, or any other wall.env secret.
[Unit]
Description=Office wall panel Door stream broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wall-door-stream
Group=wall-door-stream
SupplementaryGroups=panel
RuntimeDirectory=wall-door-stream
RuntimeDirectoryMode=0750
UMask=0007
LoadCredential=host:/run/wall-door-credentials/host
LoadCredential=password:/run/wall-door-credentials/password
LoadCredential=port:/run/wall-door-credentials/port
LoadCredential=path:/run/wall-door-credentials/path
LoadCredential=username:/run/wall-door-credentials/username
LoadCredential=width:/run/wall-door-credentials/width
LoadCredential=height:/run/wall-door-credentials/height
LoadCredential=input-fov:/run/wall-door-credentials/input-fov
LoadCredential=horizontal-fov:/run/wall-door-credentials/horizontal-fov
LoadCredential=vertical-fov:/run/wall-door-credentials/vertical-fov
LoadCredential=yaw:/run/wall-door-credentials/yaw
LoadCredential=pitch:/run/wall-door-credentials/pitch
LoadCredential=stale-seconds:/run/wall-door-credentials/stale-seconds
LoadCredential=start-seconds:/run/wall-door-credentials/start-seconds
LoadCredential=motion-enabled:/run/wall-door-credentials/motion-enabled
LoadCredential=motion-calibrated:/run/wall-door-credentials/motion-calibrated
LoadCredential=motion-sample-fps:/run/wall-door-credentials/motion-sample-fps
LoadCredential=motion-min-area-ratio:/run/wall-door-credentials/motion-min-area-ratio
LoadCredential=motion-persistence-seconds:/run/wall-door-credentials/motion-persistence-seconds
LoadCredential=motion-dwell-seconds:/run/wall-door-credentials/motion-dwell-seconds
LoadCredential=motion-stationary-ratio:/run/wall-door-credentials/motion-stationary-ratio
LoadCredential=motion-trigger-zone:/run/wall-door-credentials/motion-trigger-zone
LoadCredential=motion-road-zone:/run/wall-door-credentials/motion-road-zone
LoadCredential=motion-masks:/run/wall-door-credentials/motion-masks
LoadCredential=motion-diagnostics:/run/wall-door-credentials/motion-diagnostics
ExecStartPre=+/bin/chgrp panel /run/wall-door-stream
ExecStart=/usr/bin/python3 /opt/wall-panel/app/runtime/resources/app/doorstream/service.py --credential-directory %d --socket /run/wall-door-stream/service.sock --allowed-group panel
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed
CPUAccounting=true
CPUQuota=80%
MemoryAccounting=true
MemoryMax=384M
TasksMax=64
OOMPolicy=stop

# The broker needs LAN sockets and its runtime directory, but no writable
# filesystem, devices, home directory, elevated transition, or kernel control.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# The service intentionally emits no camera/decoder output. Its bounded state
# goes to the panel over the socket; FFmpeg stderr is discarded by the broker.
StandardOutput=null
StandardError=null

# Deliberately no [Install] target: wall-firstboot creates the volatile
# credential sources and starts this unit after they exist on every boot.
