# Office wall panel — configuration (the panel's own knobs).
#
# Copy to /etc/wall-panel/wall.env (the autoinstall seeds it from this file) and
# fill in. NOTHING here is committed filled: only this .example is tracked
# (SN-007). The real file is root-only 0600 — it carries the Wi-Fi PSK.
#
# QUOTING RULE (same as stack/.env.example): this file is shell-sourced by
# wall-firstboot.sh and wall-sleep.sh, so any value containing a SPACE must be
# double-quoted (KEY="a b") or first boot dies at the source line.
#
# NOT here on purpose:
#   - PANEL_USER_SUB — the panel never learns its own NagLight identity. The
#     kiosk site INJECTS it (stack/caddy/Caddyfile); a value on the panel would
#     be a copy of a secret-ish fact for no reason.
#   - MEDIA_ROOT — that is the AWOW-side library root, and the panel has no
#     business knowing it. The panel knows only the SHARES it pulls from
#     (the two MEDIA_*_SHARE_UNC knobs below) and its own cache
#     (D-W8 rider / OWN-D5 / OI-15).
#   - the shell's own knobs (HEARTBEAT_URL, LOCAL_LIBRARY, SUBSONIC, …) — those
#     live in the shell's config.json, which is IF-005's remaining contract.
#     See ./README.md "What IF-005 still owes".

# ── The kiosk site the shell loads ──────────────────────────────────────────
# Must match WALL_HOST / WALL_PORT in the AWOW's stack/.env — this is the origin
# that serves the shell AND proxies /api/* to the tracker (same-origin: NagLight
# sends no CORS headers). Reachable ONLY on the LAN, by design.
WALL_HOST=wall.example.tld
WALL_PORT=8443

# ── Wi-Fi (quirk 5) — the panel has no RJ45 ─────────────────────────────────
# The PSK is the one genuinely secret value on the panel. Give the panel a DHCP
# RESERVATION on its HARDWARE MAC: the kiosk site's /32 allow-list depends on the
# address never moving, and MAC randomization is pinned off for the same reason.
WIFI_SSID=REPLACE_WITH_WIFI_SSID
WIFI_PSK=REPLACE_WITH_WIFI_PSK

# ── Sleep window (D-W4) ─────────────────────────────────────────────────────
# suspend  = S3 "deep" (L2). ~0.5-1.5 W, and — the better argument — near-zero
#            heat and no fan noise for the window. NO LAN presence at all while
#            asleep: no SSH, no fixing it, until the RTC alarm fires.
# backlight = L1 fallback. Machine stays fully up and SSH-able, backlight off,
#            ~7-10 W. Use this if resume ever proves unreliable on this
#            firmware — that is the classic 2016-consumer-hardware failure and
#            the reason the knob exists at all.
SLEEP_MODE=suspend
# Window boundaries, box-local 24h HH:MM. Both modes share this one schedule.
SLEEP_START=22:00
SLEEP_END=06:30
# The wake is RTC-PRIMARY: wall-sleep.sh arms /sys/class/rtc/rtc0/wakealarm for
# SLEEP_END *before* suspending, so the morning wake never depends on anyone
# nudging the mouse. The USB mouse is the manual/early wake on top of that (and
# it is REQUIRED, not optional: the internal touchscreen is an I2C-HID device and
# will almost certainly NOT wake the machine from S3).
# Set false ONLY to test the USB-only path deliberately.
SLEEP_RTC_WAKE=true

# ── Media sync — THE PANEL PULLS, FROM TWO HOSTS ────────────────────────────
# OI-15 (the Owner, 2026-07-29): the panel MIRRORS its media into a local cache
# and the shell then serves /media/* panel-locally.
# OI-18 exit (b) (the Owner, 2026-08-03): there are TWO sources on TWO hosts, and
# the panel mounts each with its OWN credential. Consolidating them behind one
# host was rejected — it would re-open HOMELAB_TOPOLOGY.md decision 2 ("the panel
# pulls frame videos from Mini-serv directly").
#
# Run by wall-sync.service (both flows) once after boot and on every resume, by
# wall-sync-frame.timer (frame only) every minute, and on demand with:
#     sudo systemctl start wall-sync.service        # <- the dedicated command
#
# WHICH host and WHICH share each of these is, is answered by the pathing SSOT —
# Personal\homelab\deploy\storage-map.md §3 row 2, §3b and §4d — NOT by guessing
# from this example. The values are filled in by the household secret tooling
# (Personal's Materialize-Deploy.ps1 -Image wall) from config.wall.psd1.

# ── Source 1 of 2: MUSIC (storage-map §4d `sync-music`) ─────────────────────
# WHAT IT IS: the share on HOMEHUB (the AWOW) that exports the library's media
# tree. Storage-map §3 row 1 exports `NonDocs\Media` as the share `Media`, and
# §3 row 2 puts the panel's music at `NonDocs\Media\Music` — i.e. reached
# THROUGH that share, as the `Music` subdirectory UNDER the mount. So this is the
# `Media` share, NOT a `Music` share: the subdirectory is fixed in wall-sync.sh
# (it is not a knob) and pointing this at a share that has no `Music/` in its
# root makes the sync refuse rather than mirror nothing.
# WHAT BREAKS WITHOUT IT: wall-sync.service FAILS on every boot and resume, the
# panel has no music at all, and the local library — which is the PRIMARY
# playback source since 2026-07-29, not a cache in front of streaming — is empty.
# SSOT: storage-map.md §3 rows 1-2 + §4d `sync-music`.
MEDIA_MUSIC_SHARE_UNC=//REPLACE_WITH_MUSIC_HOST/REPLACE_WITH_MUSIC_SHARE
#
# The root-only credentials file for that mount: a HOMEHUB **Samba** identity,
# which is a different account on a different machine from the frame one below.
# The image installs this file 0600 root:root from the materialised site payload.
# WHAT BREAKS WITHOUT IT: the music mount cannot authenticate — §2 of the storage
# map says even `everyone` read access still requires a valid account — so
# wall-sync fails loudly on every run. There is deliberately NO inline
# user/password fallback any more (retired by OI-18: one inline pair cannot serve
# two hosts, and duplicating it per flow would only add places to keep a password
# less safely than in this file).
# SSOT for the value: the household store, key `PanelMusicCifsCredential`.
MEDIA_MUSIC_CIFS_CREDENTIALS=/etc/wall-panel/cifs-music.creds

# ── Source 2 of 2: FRAME VIDEOS (storage-map §4d `sync-frame-videos`) ───────
# WHAT IT IS: `\\MINI-SERV\PictureFrameVideos` — a DEDICATED share (§3b), whose
# content is at the share ROOT with no subdirectory under it. That asymmetry with
# the music mount above is the single most important thing on this page: give the
# frame mount a subdirectory it does not have and the mirror looks one level too
# deep and finds nothing.
# WHAT BREAKS WITHOUT IT: the wall shows no picture-frame video — which is the
# panel's main visible content when the tracker is idle.
# SSOT: storage-map.md §3b + §4d `sync-frame-videos`.
MEDIA_FRAME_SHARE_UNC=//REPLACE_WITH_FRAME_HOST/REPLACE_WITH_FRAME_SHARE
#
# The root-only credentials file for that mount: the MINI-SERV local account
# ruled 2026-08-01 (A11(v)/A10(v)) — `share`, read-only on the three §3b shares.
# It is the SAME account the AWOW's backup pull uses, and a different one from
# the music mount's.
# WHAT BREAKS WITHOUT IT: the frame mount cannot authenticate and the run fails
# loudly (this is a configuration defect, NOT the designed "Mini-serv is asleep"
# state — see the failure-policy note below).
# SSOT for the value: the household store, key `CifsCredential`.
MEDIA_FRAME_CIFS_CREDENTIALS=/etc/wall-panel/cifs-frame.creds

# ── THE TWO SOURCES HAVE DIFFERENT FAILURE POLICIES ─────────────────────────
# (storage-map §4d, A0/A10 — this is a ruling, not a setting, so there is no knob
# for it.)
#   * MUSIC — HOMEHUB is ALWAYS-ON. A refused mount means the hub or its Samba
#     service is down: a real ALERT, so the unit FAILS, loudly.
#   * FRAME — MINI-SERV MAY SLEEP, and is NEVER woken for this. wall-sync probes
#     445/tcp first; nothing answering = the box is asleep = SKIP SILENTLY, which
#     is the one place this project's never-silent-green rule bends, and only
#     because that state is DESIGNED. If the box ANSWERS and the mount is then
#     refused, that is a wrong share or a wrong credential and it IS fatal.

# ── How stale is the wall allowed to get before the journal says so? ────────
# The frame skip is silent about the failure; it must not be silent about the
# consequence. Every successful sync stamps its finish time and every skip
# reports the cache's age — as a plain log line below this many hours, and as a
# WARNING above it. It NEVER escalates to a failed unit however old the content
# gets: "Mini-serv has been off for a week" is an allowed state, and at what age
# it stops being allowed is a decision nobody has made.
WALL_FRAME_STALE_WARN_HOURS=24

# ── Common to both mounts ───────────────────────────────────────────────────
# Where the mirrored copy LIVES on the panel. Disposable by design: it is a
# CACHE, and reimaging the panel throws it away (the library is the only copy
# that matters). It must be an ABSOLUTE path — it is an `rsync --delete`
# destination. The Electron host maps /media/* onto this directory, so the
# shell's default manifest paths resolve to <cache>/music/index.json and
# <cache>/frame/playlist.json.
WALL_MEDIA_CACHE=/var/cache/wall-media
#
# MIRROR SEMANTICS — READ THIS ONCE: the sync is `rsync -a --delete`, so the
# panel cache is made to MATCH the share. Content REMOVED from the LAN source
# DISAPPEARS from the panel on the next sync. That is the ruling, and from the
# panel's side it is irreversible.
#
# MIRROR SAFETY (the backup service's ingest step learned this the hard way): if
# a subtree MOUNTS but turns out to hold no files — wrong share name, a source
# that came up without its data volume — mirroring it would ERASE a good cache,
# so the sync REFUSES and fails loudly instead. Set this to true only for a run
# where the source really is (or is meant to become) empty. It applies to BOTH
# flows, so clear it again after the one run that needed it.
WALL_SYNC_ALLOW_EMPTY=false
#
# cifs mount options shared by both mounts — the protocol version, chiefly. One
# knob and not two: this is a protocol choice and both hosts speak SMB3. Split it
# only if a real box ever turns out to need a different version.
MEDIA_CIFS_EXTRA=vers=3.0
#
# BENCH/TEST HOOKS — leave commented on a real panel. Each names a LOCAL
# directory to mirror from INSTEAD OF MOUNTING that flow's share, which is how
# the mirror, the guards and the manifest generation are exercised on a machine
# with no Samba host. The hook replaces the MOUNT, not the logic — so a music
# override directory must itself contain `Music/`, exactly as the real share
# does, while a frame override directory holds the videos at its own root. The
# sync announces loudly when either is set, so a run in the journal can never be
# mistaken for a real pull.
# MEDIA_MUSIC_SOURCE_OVERRIDE=/tmp/fake-library
# MEDIA_FRAME_SOURCE_OVERRIDE=/tmp/fake-frame-videos

# ── Optional music credentials — COMMENTED ON PURPOSE ───────────────────────
# Music plays from the panel's local synced copy (D-W8 rider), so Navidrome
# streaming and Pandora are BOTH optional. Un-comment a pair only when you
# actually enable that source — and note the consequence for the household secret
# tooling: an uncommented KEY here makes the emitter DEMAND its store key and
# refuse to emit until it exists (FieldSchema completeness rule).
# NAVIDROME_USER=REPLACE_WITH_NAVIDROME_USER
# NAVIDROME_PASSWORD=REPLACE_WITH_NAVIDROME_PASSWORD
# PANDORA_USER=REPLACE_WITH_PANDORA_USER
# PANDORA_PASSWORD=REPLACE_WITH_PANDORA_PASSWORD

# ── Kiosk app (IF-005 PLACEHOLDER — see ./README.md) ────────────────────────
# The command cage runs fullscreen. The real value depends on how the
# OfficeWallNaglight Electron app is packaged, which is exactly the part of
# IF-005 that is NOT decided yet. Until it is, this path is a placeholder and the
# kiosk session will log a loud, explicit "artifact missing" screen instead of
# silently showing a black wall.
WALL_APP_CMD=/opt/wall-panel/app/wall-shell

# ── Input quirk 3 — internal keyboard + touchpad face the mount ─────────────
# Folded flat, the keys press against the wall: one held key is an input storm.
# The fix is a udev rule, but it needs THIS MACHINE's device names, which no one
# can know from here (they are read off the running panel — see
# ./WALL-BURN-IN.md §3 for the exact one-liner that prints them).
# Leave EMPTY and the rule is NOT installed (firstboot says so loudly rather than
# guessing and disabling the touchscreen by accident).
# PIPE-separated exact udev NAMEs (pipes, because the names themselves contain
# spaces), e.g.  WALL_DISABLE_INPUT="AT Translated Set 2 keyboard|ELAN Touchpad"
# The touchscreen must NOT be listed — it is the panel's only input device.
WALL_DISABLE_INPUT=
