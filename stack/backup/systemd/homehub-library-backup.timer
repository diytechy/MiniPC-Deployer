# Schedule for the library backup (E2 / Phase 2).
#
# 03:00 BOX-LOCAL — THE OWNER MOVED THIS OFF THE Q-FB6 DEFAULT, 2026-08-30.
# Both backups now run at 03:00. The previous value was 21:30, and the reasoning
# it was chosen for is kept below rather than deleted, because it is still true
# and it is what you would want to re-read if the nightly ever starts running
# long.
#
# WHAT THE 21:30 OFFSET WAS FOR: homehub-backup.timer owns /mnt/backup-drive
# from its own start until its archive finishes, and both services hold the
# drive awake with hdparm while they run. Contending for one USB spindle makes
# each slower and neither safer. 21:30 put six clear hours in front of the
# nightly archive.
#
# AND THE OFFSET WAS ACTIVELY WRONG FOR THIS DRIVE — the Owner, 2026-08-30.
# The reasoning above optimises for the wrong thing. `BACKUP_DRIVE_STANDBY=241`
# parks the 8 TB after 30 idle minutes, so six hours between the two backups
# does not "keep them out of each other's way" — it guarantees the platter spins
# DOWN after the nightly and has to spin back UP for the library run. That is an
# extra stop/start cycle every night, on the one component in this system with
# moving parts, to avoid contention that barely exists: the nightly archives ~98
# files of container volumes and finishes in seconds.
#
# So the two runs should be adjacent, not separated. Both timers now fire at
# 03:00 and the ordering is explicit rather than hoped for — see the `After=` on
# homehub-library-backup.service, which makes the library run wait for the
# nightly to finish instead of racing it. Sequential, back to back, and the
# drive never gets the 30 idle minutes it would need to park between them.
#
# RandomizedDelaySec IS DELIBERATELY 0 ON BOTH, and that is what makes the
# ordering deterministic: identical OnCalendar values put both start jobs in ONE
# systemd transaction, which is where `After=` is honoured. Re-introduce jitter
# and the two timers land in separate transactions, `After=` becomes a no-op
# against an already-finished unit, and the library run can start first — which
# is the contention this arrangement exists to prevent.
[Unit]
Description=HomeHub library backup timer (FileBackup container)

[Timer]
OnCalendar=*-*-* 03:00:00
# A missed run (box off, or asleep) fires on the next boot. A backup should
# never silently skip — the same reasoning as homehub-backup.timer, including
# its warning that a timezone change fires any window that is now in the past.
Persistent=true
# ZERO, ON PURPOSE. See the header: firing on the same second as the nightly is
# what puts both jobs in one transaction so `After=` can order them. Jitter here
# would break the ordering, not protect it.
RandomizedDelaySec=0
Unit=homehub-library-backup.service

[Install]
WantedBy=timers.target
