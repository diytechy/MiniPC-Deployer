[Unit]
# Periodic "is the library actually there?" report (Personal A14 follow-up).
# The per-share `root preexec` guard makes a MISSING drive fail loudly at the
# moment someone tries to use it. This unit is the other half: it notices when
# nobody is looking, so a drive that drops at 3am shows up as a red check in
# the morning instead of being discovered by a backup that quietly did nothing.
# The unit reports one combined item: mount + representative Samba read health.
Description=AWOW file-share / backup-health monitor
Documentation=file:/opt/homehub/stack/samba/library-guard.sh
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStartPre=/usr/local/sbin/homehub-retire-legacy-backup-health
# POWER-LOSS RECOVERY for the backup run phase. ExecStopPost on the backup unit
# withdraws an in-progress phase on every exit systemd can see; it cannot run
# when the box loses power mid-run, which would leave the wall showing "backing
# up" indefinitely. This timer already runs every 10 minutes, so it bounds that
# staleness without a new unit and without a timeout on the run itself — the
# call is lock-aware and leaves a genuinely live backup alone.
# `-` so it can never fail the share-health report that is this unit's job.
ExecStartPre=-/opt/homehub/stack/backup/library-backup.sh --reconcile-run-state
# THE MEDIA DRIVE IS PUT BACK FROM HERE TOO (SR-149): it hangs off a USB hub, and a
# drive that returns mid-session is mounted by nothing else. Motion clips queue
# while it is away and are cut when it returns, so this is what keeps the wait
# short. `-` for the same reason as above, and a no-op without an fstab row.
ExecStartPre=-/usr/local/sbin/homehub-library-guard --reattach --library /srv/media --label media
ExecStart=/usr/local/sbin/homehub-library-guard --report --label library
# A failing report must not put the unit in a permanent failed state that
# masks later recoveries — the REPORT is the signal, not the exit code.
SuccessExitStatus=0 1
