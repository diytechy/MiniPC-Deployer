# audio-mic.conf.example - what `wall-audio-output mic` GENERATES.
#
# The live file is /etc/wall-panel/audio-mic.conf and it is rewritten whole by
# that command. This copy is here so the shape is reviewable in the repo, the
# way audio-trim.conf.example and audio-cards.conf.example are; nothing installs
# it and nothing reads it.
#
# IT IS GENERATED, AND NOT SHIPPED, FOR THE SAME REASON THE TRIM IS: the one
# number worth turning at a desk (how hot the desktop's line input wants to be
# driven) must move without anybody editing ALSA syntax or reinstalling a
# payload file.
#
# THE EXPLICIT ZEROS ARE THE POINT OF THE FILE. `usb_out_mix` is a dmix over the
# adapter's ONE eight-channel playback stream, shared with the speaker leg
# because item 23 needs the room's music and the microphone out of the same
# adapter at the same time. The adapter's mute is a single boolean over all
# eight channels (numid 7, measured 2026-09-14), so it cannot say "front off,
# rear on". These zeros, and the matching zeros on channels 4-7 in
# audio-trim.conf, are therefore the WHOLE of the separation between the
# microphone and the speakers in one direction and the room's music and the
# desktop's input in the other.
#
# /etc/wall-panel/audio-mic.conf - GENERATED by `wall-audio-output mic`.
# Edit with that command, not by hand: this file is rewritten whole.
# The 8-channel map is the adapter's and is fixed:
#   0 FL  1 FR  2 FC  3 LFE  4 RL  5 RR  6 SL  7 SR
# Source channel 0 is the ONLY source: mic_selected is mono.
pcm.mic_rear_route {
    type route
    slave {
        pcm "usb_out_mix"
        channels 8
    }
    ttable.0.4 1.0000  # the microphone, to the desktop's input
    ttable.0.5 1.0000  # the microphone, to the desktop's input
    ttable.0.0 0.0000  # the mic must never reach this channel
    ttable.0.1 0.0000  # the mic must never reach this channel
    ttable.0.2 0.0000  # the mic must never reach this channel
    ttable.0.3 0.0000  # the mic must never reach this channel
    ttable.0.6 0.0000  # the mic must never reach this channel
    ttable.0.7 0.0000  # the mic must never reach this channel
}
