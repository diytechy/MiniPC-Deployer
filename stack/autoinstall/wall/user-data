#cloud-config
# Ubuntu Server autoinstall (cloud-init) for the OFFICE WALL PANEL — the second
# image target of this repo (OI-12 / D-W0, ratified 2026-07-29).
#
# HOW THIS DIFFERS FROM ../user-data (the AWOW always-on core), and why:
#   - GRAPHICAL, not headless: the deliverable is one fullscreen app on a wall,
#     so this image installs a Wayland kiosk compositor (`cage`) and autologs a
#     single unprivileged user into it. No desktop environment, no display
#     manager, no login screen.
#   - NO DOCKER, NO STACK: the panel is a thin client that holds nothing but a
#     disposable cache. It runs no containers and hosts no services, so none of
#     the AWOW's docker/compose/Technitium machinery is installed here.
#   - Wi-Fi, not ethernet: the R5-471T has no RJ45 (hardware baseline,
#     2026-07-26). Credentials come from wall.env (see wall-firstboot.sh).
#   - LIGHTER GATES (OI-12b): the panel's needs are SN-013, not SN-001's
#     headless zero-click bar. A panel that fails is REIMAGED, not repaired
#     (REMOTE_MANAGEMENT.md) — nothing on it is precious.
#   - Its own hardware quirk fixes: a wall-mounted convertible is a hostile
#     configuration for default Linux power/input behaviour. Six quirks, each
#     with a config-level fix, are applied by wall-firstboot.sh.
#
# SECURITY: this template ships with PLACEHOLDERS. The identity block (username +
# SSH PUBLIC key) is materialised by the household secret tooling; never commit a
# filled-in copy. The panel is SSH key-only, exactly like the AWOW.
#
# See ./README.md for the payload contract and ./WALL-BURN-IN.md for everything
# only the real hardware can settle.

autoinstall:
  version: 1

  # Non-interactive: the installer must never stop to ask. A panel being imaged
  # is usually on a bench with no keyboard attached.
  interactive-sections: []

  locale: en_US.UTF-8
  keyboard:
    layout: us

  # ── Network: Wi-Fi only ─────────────────────────────────────────────────────
  # The installer needs the network for apt, so the SSID/PSK are substituted into
  # THIS block too (the same wall.env values wall-firstboot.sh renders netplan
  # from). Two hardware-driven settings, both from quirk 5:
  #   - `wifis` + a DHCP lease that must be RESERVED on the panel's HARDWARE MAC.
  #     The kiosk site's /32 allow-list depends on that address never moving.
  #   - MAC randomization OFF. The live boot showed it ON by default, which
  #     silently breaks a reservation keyed to the real MAC.
  # NetworkManager's powersave-off (also quirk 5) is applied post-install by
  # wall-firstboot.sh — it is a NetworkManager setting, not a netplan one.
  network:
    version: 2
    wifis:
      wlan0:
        match:
          name: "wl*"
        set-name: wlan0
        dhcp4: true
        # Never a random MAC: the DHCP reservation and the /32 both key off the
        # permanent hardware address.
        macaddress: permanent
        access-points:
          "REPLACE_WITH_WIFI_SSID":
            password: "REPLACE_WITH_WIFI_PSK"

  identity:
    hostname: wall-panel
    realname: "Office Wall Panel"
    username: panel
    # SSH KEY-ONLY (same posture as the AWOW): "!" is a locked hash, so there is
    # no usable password login. The kiosk session is reached by AUTOLOGIN on tty1
    # (wall-firstboot.sh writes the getty drop-in), which needs no password.
    password: "!"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      # REPLACE with your real public key(s). allow-pw:false means the panel is
      # unreachable over SSH until at least one valid key is here — and while it
      # is asleep (D-W4) it is unreachable regardless. See WALL-BURN-IN.md.
      - "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY you@host"

  # Whole-disk automatic layout (LVM), same shape as the AWOW image. The panel's
  # disk is a 256 GB M.2 SATA (hardware baseline 2026-07-26; the machine shipped
  # with no disk at all). Nothing here is precious — quirk 4b makes unclean
  # power-cuts routine, which is survivable precisely because the panel is a
  # cache. See WALL-BURN-IN.md for the fsck-must-not-block check.
  # DESTRUCTIVE and unattended — same warning as the AWOW variant. Without a
  # `match:` the installer picks a disk by its own heuristic and every attached
  # disk is a candidate.
  #
  # Pinned by MODEL rather than path: the panel's internal disk is SATA
  # (KINGSTON RBU-SNS8152S3256GG2, 238.5 GB — 2026-07-26 baseline) and so
  # enumerates as `sd*`, exactly like the USB install stick. A `path:` match
  # would therefore be a coin flip on enumeration order, and losing it means
  # imaging the stick you booted from. The model string is stable and, unlike a
  # serial, is not device-identifying, so it is safe in this public repo.
  storage:
    layout:
      name: lvm
      match:
        model: KINGSTON*RBU-SNS8152S3256GG2

  packages:
    - ca-certificates
    - curl
    - cage                 # single-surface Wayland kiosk compositor (the session)
    - seatd                # seat management fallback if the logind seat path fails
    - xdg-utils
    - fonts-dejavu-core
    - util-linux           # rtcwake — the PRIMARY wake source (D-W4)
    - network-manager      # quirk 5: powersave off, and the netplan renderer
    # ---- the media sync (OI-15): the panel PULLS, so it needs a cifs client ---
    - cifs-utils           # mount.cifs — the read-only mount of the media share
    - rsync                # the mirror itself (`rsync -a --delete`)
    - python3              # wall-media-manifest.py (JSON escaping, not bash).
                           # Present anyway (cloud-init needs it); listed so the
                           # dependency is explicit rather than inherited by luck.
    - alsa-utils           # audio sink pinning (WSN-012 lives in the app's runbook)
    - pulseaudio-utils
    - va-driver-all        # VA-API decode; quirk 6 says PROVE it is engaged
    - vainfo
    - unattended-upgrades  # same hands-off patching posture as the AWOW
    - openssh-server
    # ---- the Electron runtime's shared libraries (IF-005 / PKG-1) -----------
    # The shell artifact ships its own Electron binary but NOT the ~24 system
    # libraries it links against — those are the image's job. Every name below
    # is derived from the shipped binary's own DT_NEEDED list and is enforced:
    # ./electron-runtime-deps.tsv maps soname -> package, and the wall builder
    # (vmtest/lib/common.sh assert_electron_runtime_deps) refuses to bake an
    # artifact whose dependencies are not all covered here. Do not prune this
    # list by eye — a missing library is a BLACK WALL, not an error message:
    # Electron exits before painting, wall-kiosk.sh restarts it every 3 s, and
    # `[ -x ]` stays true so the NOT INSTALLED screen never fires either.
    # The `t64` suffixes are 24.04's 64-bit-time_t renames; the old names do
    # not exist in noble and apt would fail the install outright.
    - libx11-6
    - libxcomposite1
    - libxdamage1
    - libxext6
    - libxfixes3
    - libxrandr2
    - libasound2t64
    - libatk1.0-0t64
    - libatk-bridge2.0-0t64
    - libatspi2.0-0t64
    - libcairo2
    - libcups2t64
    - libdbus-1-3
    - libexpat1
    - libgbm1
    - libglib2.0-0t64
    - libgtk-3-0t64
    - libnspr4
    - libnss3
    - libpango-1.0-0
    - libudev1
    - libxcb1
    - libxkbcommon0

  late-commands:
    # ---- 1. Remote management (lighter than the AWOW's: no Cockpit) -----------
    # A panel is reimage-not-repair, so it gets SSH + unattended-upgrades and
    # deliberately NOT Cockpit — one less always-listening web surface on a box
    # that is asleep half the time anyway.
    - curtin in-target --target=/target -- bash -c 'echo "unattended-upgrades unattended-upgrades/enable_auto_updates boolean true" | debconf-set-selections'
    - curtin in-target --target=/target -- dpkg-reconfigure -f noninteractive unattended-upgrades
    - curtin in-target --target=/target -- systemctl enable unattended-upgrades

    # ---- 2. Lighten the image ------------------------------------------------
    # Nothing here uses snaps, and this is a 2016 U-class machine behind a wall.
    - curtin in-target --target=/target -- bash -c 'DEBIAN_FRONTEND=noninteractive apt-get purge -y snapd 2>/dev/null || true; apt-get autoremove -y --purge'

    # ---- 3. Place the payload ------------------------------------------------
    # The build step copies the repo tree (plus the shell artifact) into
    # deploy-payload/, and it must land under /opt/wall-panel/ — the wall
    # variant's files are then at /opt/wall-panel/stack/autoinstall/wall/, which
    # is where every later late-command copies its units from.
    #
    # /cdrom IS NOT ENOUGH, and finding that out cost a whole install cycle
    # (2026-08-03). On the REPACKED path /cdrom is the combined ISO and carries
    # /deploy-payload, so this worked. On the LIGHT path — the one this repo
    # recommends by default — /cdrom is the STOCK Ubuntu ISO, which has no such
    # directory, and the CIDATA seed that does is mounted only transiently by
    # cloud-init to read user-data. So the payload rode along on the seed and
    # NOTHING EVER READ IT. The old line ended in `|| true`, so the install
    # sailed past it and died four commands later on a missing wall.env.example,
    # naming nothing useful. Mount the seed by its label instead.
    #
    # AND FAIL LOUDLY. Unlike the hub — which has a documented degraded mode
    # where firstboot pulls images instead — a wall image without its payload
    # cannot work at all: the units, the scripts and wall.env.example all come
    # from it. Better to stop here, saying so, than to install a panel that
    # cannot boot into anything.
    - mkdir -p /target/opt/wall-panel
    - >-
      bash -c 'set -e;
      for d in /cdrom /media /media/* /run/media/*; do
      if [ -d "$d/deploy-payload" ]; then cp -a "$d/deploy-payload/." /target/opt/wall-panel/; echo "wall: payload copied from $d/deploy-payload"; exit 0; fi;
      done;
      dev=$(blkid -L CIDATA 2>/dev/null || true);
      if [ -n "$dev" ]; then m=$(mktemp -d);
      if mount -o ro "$dev" "$m" 2>/dev/null; then
      if [ -d "$m/deploy-payload" ]; then cp -a "$m/deploy-payload/." /target/opt/wall-panel/; echo "wall: payload copied from the CIDATA seed at $dev"; umount "$m"; exit 0; fi;
      umount "$m"; fi; fi;
      echo "wall: FATAL - no deploy-payload found. Looked under /cdrom, /media, /run/media/* and on the CIDATA volume ($dev).";
      echo "wall: the seed ISO carries it at its root; on the light path nothing mounts that volume for you.";
      exit 1'

    # ---- 3b. Unpack the shell artifact (IF-005 / PKG-1) ----------------------
    # The payload carries OfficeWallNaglight's panel tarball at
    # /opt/wall-panel/wall-app/officewall-shell-*-linux-x64.tar.gz (staged by
    # vmtest/lib/common.sh stage_wall_shell_into_payload). Unpacking it here
    # produces /opt/wall-panel/app/, so WALL_APP_CMD=/opt/wall-panel/app/wall-shell
    # is executable and cage runs THE app instead of the "NOT INSTALLED" screen.
    #
    # `tar`, AS ROOT, IS NOT A FORMALITY — and it is why this is a tar and not a
    # directory in the payload. app/runtime/chrome-sandbox must arrive
    # root:root 4755: Ubuntu 24.04 sets
    # kernel.apparmor_restrict_unprivileged_userns=1, which closes the namespace
    # sandbox, so the SUID helper is Electron's only remaining route and it
    # refuses to start without it. A `cp`, an unzip or an rsync from an unpacked
    # tree drops the bit silently; tar carries mode+uid+gid inside the archive.
    # This runs in the INSTALLER (root, /target mounted), not in-target, because
    # the archive is a whole self-contained runtime and needs no chroot.
    #
    # ABSENT IS TOLERATED, BROKEN IS NOT. A real-hardware image may legitimately
    # be built without the artifact (the panel then shows the explicit
    # NOT INSTALLED screen — a visible event, by design). But a tarball that is
    # present and fails to unpack must kill the install: the alternative is a
    # panel that crash-loops silently, which is the one failure mode with no
    # symptom on the screen at all.
    - >-
      bash -c 'set -e;
      t=$(ls -1 /target/opt/wall-panel/wall-app/officewall-shell-*-linux-x64.tar.gz 2>/dev/null | head -n1);
      if [ -z "$t" ]; then echo "wall: no shell artifact in the payload - the panel will show the NOT INSTALLED screen"; exit 0; fi;
      echo "wall: unpacking $t into /target/opt/wall-panel";
      tar -xzf "$t" -C /target/opt/wall-panel;
      [ -x /target/opt/wall-panel/app/wall-shell ] || { echo "wall: FATAL - unpacked but app/wall-shell is not executable"; exit 1; };
      [ -u /target/opt/wall-panel/app/runtime/chrome-sandbox ] || { echo "wall: FATAL - chrome-sandbox lost its setuid bit; Electron will refuse to start"; exit 1; };
      echo "wall: shell installed - $(cat /target/opt/wall-panel/app/VERSION 2>/dev/null)"'

    # ---- 4a. Install a pre-filled wall.env if the payload carries one --------
    # The PRODUCTION/SIM seam, same shape as the hub image's site/ directory:
    # a build that materialised the panel's config puts it at
    # deploy-payload/site/wall.env and it lands here 0600. The wall builder
    # writes a SIM one (vmtest/lib/common.sh render_sim_wall_env); nothing
    # emits a production one yet, and the builder refuses to pretend otherwise.
    # Step 4 below then no-ops, because the file already exists.
    # `install -m 0600` and not `cp`: the payload copy's mode comes from whatever
    # filesystem the ISO was staged on, and a build run under WSL on /mnt/c
    # produces 0777 — the file carries the Wi-Fi PSK. The payload copy is
    # tightened for the same reason.
    - curtin in-target --target=/target -- bash -c '[ -f /opt/wall-panel/site/wall.env ] && { install -d -m 0755 /etc/wall-panel && install -m 0600 /opt/wall-panel/site/wall.env /etc/wall-panel/wall.env && chmod 0600 /opt/wall-panel/site/wall.env; } || true'
    # cifs.creds, when a production build staged one: MEDIA_CIFS_CREDENTIALS
    # defaults to exactly this path, and wall-sync.sh mounts the media share
    # with it. Absent, the sync fails loudly at boot — which is intended, not a
    # silent degrade (a wall with no music and a green unit would be a lie).
    - curtin in-target --target=/target -- bash -c '[ -f /opt/wall-panel/site/cifs.creds ] && { install -d -m 0755 /etc/wall-panel && install -m 0600 /opt/wall-panel/site/cifs.creds /etc/wall-panel/cifs.creds && chmod 0600 /opt/wall-panel/site/cifs.creds; } || true'

    # ---- 4. Seed wall.env from the example if not pre-filled ------------------
    # Root-only: it carries the Wi-Fi PSK and (if enabled) music credentials.
    - curtin in-target --target=/target -- bash -c '[ -f /etc/wall-panel/wall.env ] || { mkdir -p /etc/wall-panel && cp /opt/wall-panel/stack/autoinstall/wall/wall.env.example /etc/wall-panel/wall.env && chmod 0600 /etc/wall-panel/wall.env; }'

    # ---- 5. First-boot + per-boot units --------------------------------------
    # wall-firstboot   — once: renders every config file the quirks need.
    # wall-wakeprep    — EVERY boot: ACPI/USB wake enablement does not persist.
    # wall-sleep/-wake — the D-W4 sleep window; their .timer files are RENDERED
    #                    by firstboot from SLEEP_START/SLEEP_END (systemd cannot
    #                    interpolate an env var into OnCalendar).
    # wall-sync        — ONCE AFTER BOOT, ON EVERY RESUME, and on demand over
    #                    SSH: mirror the library share's Music/ + FrameVideos/
    #                    into the panel's media cache (OI-15). No timer, by the
    #                    ruling. The resume trigger is wall-sync-resume.service
    #                    (OI-16a): the panel suspends nightly and a resume is not
    #                    a boot, so boot-only would go weeks stale.
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-firstboot.service /target/etc/systemd/system/wall-firstboot.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-firstboot.sh /target/usr/local/sbin/wall-firstboot.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-firstboot.sh
    - curtin in-target --target=/target -- systemctl enable wall-firstboot.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-wakeprep.service /target/etc/systemd/system/wall-wakeprep.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-wakeprep.sh /target/usr/local/sbin/wall-wakeprep.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-wakeprep.sh
    - curtin in-target --target=/target -- systemctl enable wall-wakeprep.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sleep.service /target/etc/systemd/system/wall-sleep.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-wake.service /target/etc/systemd/system/wall-wake.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sleep.sh /target/usr/local/sbin/wall-sleep.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-sleep.sh
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-kiosk.sh /target/usr/local/bin/wall-kiosk.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/bin/wall-kiosk.sh
    # wall-sync — the media pull (OI-15). Boot-once + on-demand oneshot; NO timer,
    # by the ruling. The manifest generator is installed NEXT TO the script because
    # wall-sync.sh looks for it there first (and in the payload dir as a fallback).
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sync.service /target/etc/systemd/system/wall-sync.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sync.sh /target/usr/local/sbin/wall-sync.sh
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-media-manifest.py /target/usr/local/sbin/wall-media-manifest.py
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-sync.sh /usr/local/sbin/wall-media-manifest.py
    - curtin in-target --target=/target -- systemctl enable wall-sync.service
    # wall-sync-resume — the OI-16a hook: WantedBy=suspend.target, so every wake
    # from the D-W4 nightly suspend re-triggers wall-sync (detached, --no-block —
    # the wake is never delayed). Enabling it is what plants the suspend.target
    # symlink; without that the hook exists but never fires.
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sync-resume.service /target/etc/systemd/system/wall-sync-resume.service
    - curtin in-target --target=/target -- systemctl enable wall-sync-resume.service
    # Seat access for the kiosk user (cage needs the DRM/input devices).
    - curtin in-target --target=/target -- usermod -aG video,input,render panel

    # ---- 6. mem_sleep_default=deep — NOTE, deliberately NOT applied ----------
    # D-W4 wants S3 ("deep"), not s2idle: on this hardware generation s2idle
    # often saves little more than backlight-off, which would defeat L2 entirely.
    # The 2026-07-26 baseline confirmed `deep` is SUPPORTED and a full
    # suspend/resume cycle PASSED — but whether `deep` is the RUNNING DEFAULT is
    # read off /sys/power/mem_sleep, which no one can do from here.
    # wall-firstboot.sh therefore READS it and warns loudly if it shows
    # `[s2idle] deep`. Editing the kernel cmdline is left as this ONE explicit
    # command rather than done silently, because a bad cmdline on a wall-mounted
    # machine with no keyboard is an unpleasant recovery:
    #
    #   sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 mem_sleep_default=deep"/' /etc/default/grub && update-grub
    #
    # Run it over SSH after the first boot IF firstboot reported s2idle, then
    # re-run the suspend/resume test (WALL-BURN-IN.md §4).

  # No reboot prompt — straight into the panel.
  shutdown: reboot
