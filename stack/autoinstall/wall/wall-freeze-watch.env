# Wall panel freeze watchdog. Restart wall-freeze-watch.service after editing.

# Seconds between probes.
INTERVAL=30

# A probe that takes longer than this counts as "no frame". A healthy panel
# answers in ~0.25s, so 8 is generous by more than an order of magnitude.
PROBE_TIMEOUT=8

# Consecutive failed probes before declaring a freeze and capturing. 2 means a
# wedge is declared after roughly a minute, which is long enough that a single
# slow probe (a heavy sensor frame, a sync burst) cannot trigger it.
FAIL_THRESHOLD=2

# 0 = capture evidence and LEAVE THE PANEL FROZEN (default).
# 1 = capture evidence, then restart getty@tty1 to recover.
#
# Default is 0 because these freezes are still unexplained and a restart
# destroys the live state. The bundle is always written BEFORE any restart, so
# turning this on does not cost you evidence -- it costs you the ability to go
# and poke at a live wedge by hand.
RECOVER=1

# Forensic bundles to retain under /var/log/wall-freeze.
KEEP=20
