# /etc/wall-panel/audio-trim.conf — GENERATED. Do not edit this file by hand.
#
# WHAT IT IS. The speaker leg's 2-to-8 channel route: front out stays stereo,
# and an (L+R)/2 mono sum goes to BOTH the centre channel and the LFE channel
# (Owner D4). It is the ONLY definition of `pcm.speaker_multi`, which
# asound-bus-mode.conf loads through an `errors false` hook and names as
# speaker_out's default slave.
#
# WHY IT IS A SEPARATE, GENERATED FILE. Review finding 8 asked for a
# per-channel trim "in the ALSA ttable from day one", and the Owner ruled that
# the tuning itself is a dedicated effort after everything else is in. So the
# six numbers had to be movable during a listening session, by someone standing
# at the amplifier, without editing ALSA syntax and without reinstalling a
# payload file. They are not:
#
#     sudo wall-audio-output trim                    # show the table
#     sudo wall-audio-output trim center=0.35 sub=0.6
#     sudo wall-audio-output trim front_l=0.95       # per channel, if needed
#
# Each of those rewrites /etc/wall-panel/audio-trim.env (the six values) and
# then this file, and restarts the speaker leg if it is running, so the change
# is audible within a second.
#
# THE CHANNEL ORDER IS THE HARDWARE'S AND IS NOT NEGOTIABLE. Measured on the
# panel 2026-09-13/14: the CM106's 8-channel altsetting carries a FIXED map,
# FL FR FC LFE RL RR SL SR, so ttable output indices are
#     0 FL   1 FR   2 FC   3 LFE   4 RL   5 RR   6 SL   7 SR
# and 4..7 are written as explicit zeros rather than left out, because "silent
# on purpose" and "forgotten" should not look the same in a generated file. The
# rear pair is wired to the desktop's input (item 23 revision 2) and must never
# carry the room's music.
#
# THE OTHER TRIM, AND WHY IT IS NOT THIS ONE. The adapter also has eight
# independent hardware values in `Speaker Playback Volume` (0..197, -36.93 dB
# to 0 dB). Those are left where the Owner's bench work put them -- read on the
# panel 2026-09-14 as 66,66,24,24,0,0,24,24, with the rear pair deliberately at
# zero -- and the tuning session moves THESE coefficients instead: they are
# per-source as well as per-channel, so "less of the right channel in the sub"
# is expressible here and is not expressible there.

pcm.speaker_multi {
    type route
    slave {
        pcm "speaker_hw8"
        channels 8
    }
    # front: stereo, straight through
    ttable.0.0 1.0
    ttable.1.0 0.0
    ttable.0.1 0.0
    ttable.1.1 1.0
    # centre: (L+R)/2
    ttable.0.2 0.5
    ttable.1.2 0.5
    # sub: the same mono sum. The subwoofer is assumed to have its own low-pass;
    # nothing here band-limits it.
    ttable.0.3 0.5
    ttable.1.3 0.5
    # rear and side: silent, on purpose. Rear is the desktop's input.
    ttable.0.4 0.0
    ttable.1.4 0.0
    ttable.0.5 0.0
    ttable.1.5 0.0
    ttable.0.6 0.0
    ttable.1.6 0.0
    ttable.0.7 0.0
    ttable.1.7 0.0
}
