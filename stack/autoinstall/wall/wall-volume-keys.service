# wall-volume-keys.service — make the side rocker a real volume control.
#
# THE MEASUREMENT THIS EXISTS FOR (2026-09-12): the panel's side buttons already
# emit standard keycodes. Parsing the KEY capability bitmaps in
# /sys/class/input/*/device/capabilities/key found:
#     AT Translated Set 2 keyboard    VOLUMEUP VOLUMEDOWN MUTE
#     Intel Virtual Buttons           VOLUMEUP VOLUMEDOWN
# so no driver work or hotkey quirk is needed — nothing was consuming them.
#
# It reads evdev rather than binding in the compositor because wall-kiosk.sh
# runs Electron under cage from a tty autologin session, which offers no place
# to put a binding and gets restarted routinely.
#
# It adjusts `Master` on card PCH: the last stage before the headphone jack that
# feeds the amplifier, and therefore the only true overall speaker volume.

[Unit]
Description=Wall panel: bind the side volume rocker to the amplifier output level
Documentation=file:///opt/wall-panel/stack/panel-audio/README.md
After=sound.target
Wants=sound.target wall-volume-request.socket
After=wall-volume-request.socket

[Service]
Type=simple
# Reading /dev/input/event* is the whole job, so this runs as a member of the
# input group rather than as root.
#
# A STATIC IDENTITY, NOT DynamicUser (2026-11-09). This unit was DynamicUser
# until then, and on systemd 255 a DynamicUser unit's RuntimeDirectory is NOT
# /run/wall-volume-gesture: it is /run/private/wall-volume-gesture behind a
# symlink, and /run/private is root 0700. The kiosk runs as `panel`, so its
# read of the preview document below failed with EACCES on every poll and the
# renderer was never handed a single preview -- measured on the panel: `ls
# /run/wall-volume-gesture/` as panel is "Permission denied". The overlay only
# ever rose from the confirmed audio-state file, which is why it looked fine
# while unmuted and showed nothing at all on Mute, where the applier refuses
# the set and that file does not change (WSN-120 never reached the glass).
# `wall-firstboot.sh` creates this system user before it installs the unit.
# It owns no files outside the runtime directory, as the dynamic one did not.
User=wall-volume-keys
Group=wall-volume-keys
SupplementaryGroups=input audio
# The two DynamicUser implied that are not already spelled out below.
RemoveIPC=true
# THE PREVIEW DOCUMENT'S DIRECTORY, AND THE DEFECT IT REPAIRS. Measured on the
# panel 2026-09-19: every press since WSN-063 shipped logged
#
#   volume gesture stamp: [Errno 13] Permission denied:
#       '/run/wall-panel/volume-gesture.json'
#
# because /run/wall-panel is created by root units at 0755 and this unit is
# DynamicUser with ProtectSystem=strict. The overlay-on-press path had
# therefore never once run on the real panel, and the rocker responsiveness
# plan's whole preview protocol would have inherited the same silence.
#
# It is deliberately NOT `RuntimeDirectory=wall-panel`: systemd chowns a
# RuntimeDirectory to the unit's user on every start, which would hand this
# uid the directory root writes the audio state into. This daemon gets its
# own, at 0755 so the kiosk can read the document, and Preserve=yes so a
# restart mid-gesture does not take the directory out from under a reader.
# The 0755 was not enough on its own while the unit was DynamicUser: see the
# identity note above for the parent directory that defeated it.
RuntimeDirectory=wall-volume-gesture
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /usr/local/lib/wall-panel/panel-volume-keys.py
Restart=always
RestartSec=3
# 69 = no volume-key device, 77 = not permitted to read one. Both mean this
# panel simply has no rocker to bind; that is not a degraded boot.
SuccessExitStatus=0 69 77

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The mixer is reached by running amixer, and key events arrive on evdev. This
# service requests only up/down through the restricted local helper.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
