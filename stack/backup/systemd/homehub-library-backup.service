# The LIBRARY backup (E2 / Phase 2) — a one-shot that drives the FileBackup
# container. Triggered by homehub-library-backup.timer.
#
# This is the SECOND backup unit on the box and it is not a replacement for the
# first: homehub-backup.service keeps cifs ingest, the volume: sets, the
# Mini-serv set and WoL; this one takes the nine library path: sets with dedup
# and snapshot history. Both must exist for the household to be covered.
#
# Runs as root: it drives docker, reads /proc/self/mountinfo, holds the drive
# awake with hdparm and write-probes as uid 65532 via runuser. The CONTAINER is
# non-root (65532) and read-only — none of that privilege reaches the backup
# itself.
[Unit]
Description=HomeHub library backup (FileBackup container, one-shot)
Documentation=file:///opt/homehub/stack/backup/README.md
Wants=network-online.target homehub-backup.service
# homehub-backup.service IS PULLED IN AND ORDERED AHEAD - the Owner, 2026-08-30.
# Back-to-back is the POINT, not a side-effect: BACKUP_DRIVE_STANDBY parks the
# 8 TB after 30 idle minutes, so the old six-hour gap guaranteed a spin-down and
# a spin-up between the two runs every night. Adjacent runs cost a few seconds of
# the nightly's ~98 files and save the platter a stop/start cycle.
#
# WANTS= IS LOAD-BEARING, AND IT WAS MISSING - added after an adversarial review
# on 2026-08-30. `After=` alone orders nothing unless the other unit's start job
# is ALSO in flight; it does not cause that unit to start. Measured on the box:
# ordering DOES hold across separate transactions - start A, then start B two
# seconds later, and B waits for A to finish - so the daily path was already
# fine. The hole was the case where this unit's job is created while the nightly
# has NO job at all, which `Persistent=true` on both timers makes reachable after
# downtime: whichever catch-up is handled first wins, and if it is this one then
# `After=` is vacuous and the two runs overlap on one USB spindle.
#
# `Wants=` closes that by putting the nightly into every transaction that starts
# this unit, so `After=` always has something to order against. systemd merges
# jobs for the same unit, so when both timers catch up together this coalesces
# with the nightly's own job rather than queueing a second run of it.
#
# WANTS=, NOT Requires= OR BindsTo=, and that distinction is the design. If the
# nightly fails - an absent drive is its designed refusal - this unit must still
# run and still report, rather than being silently cancelled with it. A skipped
# backup nobody was told about is the failure mode this lane exists to prevent.
After=network-online.target docker.service homehub-backup.service
# NOT RequiresMountsFor= on the data drives, and that is the same deliberate
# call homehub-backup.service makes: systemd would refuse to START the unit, so
# NOTHING would reach NagLight — an unreported non-run, which is worse than a
# red one. The wrapper's step 2 refuses instead, loudly, through the feed.

[Service]
Type=oneshot
ExecStart=/opt/homehub/stack/backup/library-backup.sh
User=root
# THE FIRST REAL RUN IS A MULTI-DAY JOB. ~2 TiB over USB, hashed per file. The
# systemd default is DefaultTimeoutStartSec=90s, and for a Type=oneshot that
# ceiling applies to the whole ExecStart — so without this line the very first
# library backup would be SIGTERM'd ninety seconds in, every night, forever,
# leaving a half-written manifest behind each time. Later incremental runs are
# minutes; the first one is not, and this unit has to survive it.
TimeoutStartSec=infinity
# WITHDRAW THE IN-PROGRESS PHASE ON EVERY EXIT PATH, including the ones the
# script itself can never see. ExecStart's own handlers cover success and
# failure; they do not run on SIGKILL, an OOM kill, or `systemctl stop`, and a
# run that dies that way would otherwise leave the wall showing "backing up"
# forever. systemd runs ExecStopPost regardless of how ExecStart ended.
#
# --reconcile-run-state is lock-aware, not a timeout: it posts idle only if it
# can TAKE the backup lock, i.e. only once no run is actually in progress. That
# matters because this fires for a start that REFUSED because another run holds
# the lock — without the lock check it would clear a live run's phase.
#
# `-` so a failure here can never change the unit's own verdict.
ExecStopPost=-/opt/homehub/stack/backup/library-backup.sh --reconcile-run-state
# Politeness, not throttling: the hub serves DNS, the kiosk site and the shares
# while this runs, and a multi-day IO-heavy job must not be what makes the panel
# stutter. `idle` yields to every other IO on the box.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
