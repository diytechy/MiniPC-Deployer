[Unit]
Description=Run the AWOW backup-drive mount health report every 10 minutes
Documentation=file:/opt/homehub/stack/samba/library-guard.sh

[Timer]
# Same cadence as the library timer. Affordable because the check never touches
# the device (see the .service header) — it cannot fight the spin-down policy.
OnBootSec=3min
OnUnitActiveSec=10min
# Offset from the library timer's jitter window so the two reports do not land
# on the tracker in the same instant every cycle.
RandomizedDelaySec=45s
Persistent=false

[Install]
WantedBy=timers.target
