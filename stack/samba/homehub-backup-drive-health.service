[Unit]
# Periodic "is the BACKUP drive actually there?" report (Personal A21).
#
# The library drive has had this since A14. The backup drive had nothing: it was
# looked at exactly once a night, by the backup run itself — and because the
# generated fstab carries `nofail`, an absent drive left $BACKUP_TARGET as an
# empty directory on the system disk that the run wrote into and reported GREEN.
# backup.sh now refuses to run in that state; this unit is the other half, so a
# drive that drops at 09:00 is a red check by 09:10 instead of a surprise at
# 03:30 the next morning.
#
# SAFE ON A SLEEPING DRIVE. The check reads /proc/self/mountinfo and nothing
# else — the answer comes from the kernel's mount table, no request reaches the
# device. That is what makes a 10-minute cadence compatible with the WI-10.10
# spin-down policy: it can never be the thing that wakes the disk.
Description=AWOW backup-drive mount health report
Documentation=file:/opt/homehub/stack/samba/library-guard.sh
After=network-online.target docker.service

[Service]
Type=oneshot
# WHICH PATH THIS CHECKS, AND WHY IT IS NO LONGER BACKUP_TARGET (2026-09-07).
# This unit used to read BACKUP_TARGET out of backup.env. That was right while
# BACKUP_TARGET meant "the root of the backup drive" — and wrong the moment the
# flat layout (2026-09-01) repointed it at /srv/library/Configs, a FOLDER on the
# LIBRARY drive. The lane then failed in two ways at once:
#   * the guard asks whether the path it is handed is ITSELF a mountpoint, and a
#     folder is not, so it posted RED every 10 minutes on a perfectly healthy
#     box — for six days, while every backup ran green;
#   * and the path it was given named the LIBRARY drive, so even taken
#     charitably this lane had stopped watching the backup drive. The 8 TB could
#     have dropped and nothing here would have gone red.
# The second is the one that mattered: a health lane pointed at the wrong drive
# is worse than no lane, because it LOOKS like coverage. So the mountpoint is
# now its own knob instead of being inferred from a path that is free to move.
#
# The resolution itself lives in samba/backup-drive-health.sh rather than inline
# here, installed as /usr/local/sbin/homehub-backup-drive-health the same way
# library-guard.sh is. Systemd un-escapes backslashes before /bin/sh ever sees
# an ExecStart, so the old one-liner had to double every one of them inside a
# sed, and a wrong count failed at RUNTIME rather than at install. Out there it
# is ordinary shell, and it can be run by hand to see what it resolves.
#
# Still config, not a constant — BACKUP_DRIVE_MOUNT comes from backup.env. The
# fallback is /mnt/backup-drive (what the storage map and drive-identity.conf
# both name) and it is LOGGED when used: an unset knob must not turn the report
# off, because a lane that silently stops reporting is the silent-green shape
# this unit exists to prevent.
ExecStart=/usr/local/sbin/homehub-backup-drive-health
Environment=LIBRARY_FEED_CHECK=backup-drive-mounted
# A failing report must not leave the unit permanently failed and mask a later
# recovery — the REPORT is the signal, not the exit code. (Same as the library.)
SuccessExitStatus=0 1
