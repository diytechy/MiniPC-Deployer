#!/bin/sh
# Managed launcher for @KEY@, install identity @IDENTITY@ (generated by provision-ai-clis.sh; do not edit).
# It belongs to exactly ONE identity: it execs that identity's entrypoint by ABSOLUTE path, so a
# wrapper of an older identity keeps running the older CLI after a newer one is installed.
# Lines of the form "#<key># ..." are emitted, uncommented, only into that key's wrapper.
# Updater controls (plan section 3.5). Codex has no replacing updater, so it exports nothing.
#claude# export DISABLE_AUTOUPDATER=1
#gemini# export GEMINI_CLI_SYSTEM_SETTINGS_PATH=/etc/gemini-cli/settings.json
#opencode# export OPENCODE_DISABLE_AUTOUPDATE=true
#opencode# export OPENCODE_CONFIG_CONTENT='{"autoupdate":false}'
#claude# exec "@ROOT@/@ENTRY@" "$@"
#codex# exec "@ROOT@/@ENTRY@" "$@"
#opencode# exec "@ROOT@/@ENTRY@" "$@"
#gemini# exec "@NODE@" "@ROOT@/@ENTRY@" "$@"
