# /etc/kids-kiosk/kids.env — the kids kiosk's configuration (SR-138, SR-139).
#
# Shell-sourced, root-only (0600). A production build installs the one
# HomeHub's Materialize-Deploy.ps1 -Image kids rendered; otherwise this example
# is copied as-is. After editing it on the box, re-run
#     sudo /usr/local/sbin/kids-firstboot.sh
# and restart the session (sudo systemctl restart getty@tty1).
#
# Nothing here is a secret today; the file is root-only so that one can be
# added later without a permissions change.

# The output that carries the TOUCH MONITOR: OtterTube lives there, touch is
# mapped to it, and every other output mirrors it. A sway output name
# (HDMI-A-1) or its make/model/serial in quotes, as `swaymsg -t get_outputs`
# prints them. Empty: the first active output by name, which on the spare
# mini-PC is the lower-numbered HDMI socket.
KIDS_TOUCH_OUTPUT=

# The program the session runs. The image's own OtterTube; change it only to
# test another build.
KIDS_APP_CMD=/opt/kids-kiosk/app/ottertube-desktop

# OtterTube's configured catalogue (its config.json "catalog"): an https URL,
# or empty for the built-in catalogue only. Written into OtterTube's
# config.json only when that file does not exist yet, so a parent's later
# changes are never overwritten.
KIDS_OTTERTUBE_CATALOG=
