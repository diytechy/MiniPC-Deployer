#cloud-config
# Ubuntu Server autoinstall (cloud-init) for the OFFICE WALL PANEL — the second
# image target of this repo (OI-12 / D-W0, ratified 2026-07-29).
#
# HOW THIS DIFFERS FROM ../user-data (the AWOW always-on core), and why:
#   - GRAPHICAL, not headless: the deliverable is one fullscreen app on a wall,
#     so this image installs a Wayland kiosk compositor (`cage`) and autologs a
#     single unprivileged user into it. No desktop environment, no display
#     manager, no login screen.
#   - NO DOCKER, NO STACK: the panel is a thin client that holds nothing but a
#     disposable cache. It runs no containers and hosts no services, so none of
#     the AWOW's docker/compose/Technitium machinery is installed here.
#   - Wi-Fi, not ethernet: the R5-471T has no RJ45 (hardware baseline,
#     2026-07-26). Credentials come from wall.env (see wall-firstboot.sh).
#   - LIGHTER GATES (OI-12b): the panel's needs are SN-013, not SN-001's
#     headless zero-click bar. A panel that fails is REIMAGED, not repaired
#     (REMOTE_MANAGEMENT.md) — nothing on it is precious.
#   - Its own hardware quirk fixes: a wall-mounted convertible is a hostile
#     configuration for default Linux power/input behaviour. Six quirks, each
#     with a config-level fix, are applied by wall-firstboot.sh.
#
# SECURITY: this template ships with PLACEHOLDERS. The identity block (username +
# SSH PUBLIC key) is materialised by the household secret tooling; never commit a
# filled-in copy. The panel is SSH key-only, exactly like the AWOW.
#
# See ./README.md for the payload contract and ./WALL-BURN-IN.md for everything
# only the real hardware can settle.

autoinstall:
  version: 1

  # Non-interactive: the installer must never stop to ask. A panel being imaged
  # is usually on a bench with no keyboard attached.
  interactive-sections: []

  locale: en_US.UTF-8

  # TIMEZONE IS LOAD-BEARING ON THIS IMAGE, not cosmetic. The D-W4 sleep window
  # is two wall-clock times (SLEEP_START/SLEEP_END), and BOTH consumers read the
  # machine's LOCAL time: wall-firstboot.sh renders them into OnCalendar=, which
  # systemd resolves locally, and wall-sleep.sh arms the RTC with
  # `date -d "today $SLEEP_END"`. Subiquity's default is UTC, so a panel imaged
  # without this line runs the window at whatever UTC offset the site happens to
  # have — measured on the real panel 2026-09-05: `SLEEP_START=22:00` put it to
  # sleep at 17:00 local and woke it at 01:30, i.e. dark through the evening it
  # exists to be watched in, awake all night. Setting it here (rather than in
  # firstboot) means it is right from the installer onward, including for the
  # first night before anyone logs in.
  timezone: REPLACE_WITH_TIMEZONE
  keyboard:
    layout: us

  # ── Network: Wi-Fi only ─────────────────────────────────────────────────────
  # THE INSTALLER NO LONGER NEEDS THIS (2026-08-06). It used to: apt ran against
  # the Ubuntu archive during `packages:`, so a panel whose Wi-Fi did not
  # associate installed nothing and said so three steps downstream. `packages:`
  # is now empty and every deb comes off the payload (see ./packages.list and
  # late-command 3c), so this block exists for the RUNNING panel — the kiosk
  # origin, the media shares, SSH — and an install can complete on a bench with
  # no AP in range. The SSID/PSK are still substituted here because the panel
  # needs them the moment it reboots.
  #
  # Two hardware-driven settings, both from quirk 5:
  #   - `wifis`, because the panel has no Ethernet port.
  #   - MAC randomization OFF. The live boot showed it ON by default, which
  #     breaks anything keyed to the real MAC — including AP-side filtering.
  # NetworkManager's powersave-off (also quirk 5) is applied post-install by
  # wall-firstboot.sh — it is a NetworkManager setting, not a netplan one.
  #
  # STATIC, NOT A DHCP RESERVATION (the Owner, 2026-08-06). The kiosk site's /32
  # allow-list means this address can never move, and it used to be held by a
  # reservation on the panel's hardware MAC. Three things were wrong with that:
  #
  #   * The address lived in the ROUTER. A router reset or replacement loses the
  #     reservation, the panel silently takes a dynamic lease, and Caddy answers
  #     it 403 — a blank wall whose cause is two devices away from the symptom.
  #   * It made the panel's address depend on a MAC nobody had written down,
  #     which blocked the VM lab from reproducing it at all.
  #   * Caddy matches the SOURCE IP, never the MAC. The reservation was a long
  #     way round to a value the panel can simply assert.
  #
  # Set it here and keep the address OUTSIDE the router's DHCP pool. The panel
  # now carries its own identity, the lab reproduces it exactly, and nothing has
  # to agree with the router.
  #
  # NAMESERVER IS THE HUB, deliberately: split-horizon means the kiosk hostname
  # must resolve through Technitium or it resolves to the public address. The
  # panel is useless without the hub anyway, so this adds no dependency that
  # was not already there — but it does mean a panel INSTALL needs the hub
  # serving DNS, which is why the lab installs them in that order.
  # ── THE NETDEF IS KEYED BY THE REAL INTERFACE NAME, AND MUST BE ───────────
  # This block used to read `wlan0:` + `match: name: "wl*"` + `set-name: wlan0`,
  # copied from ./netplan-wifi.yaml.template where it is legal. It is not legal
  # HERE, and it cost an install on 2026-09-03:
  #
  #   ERROR wlan0: networkd backend does not support wifi with match:,
  #                only by interface name
  #
  # Subiquity renders netplan with NETWORKD (NetworkManager is not in the Ubuntu
  # Server live image at all — verified against every squashfs layer: no daemon,
  # no nmcli, no unit). networkd accepts `match:` on `ethernets:` but refuses it
  # on `wifis:`. So `netplan apply` exits 1, the Network controller raises, and
  # the install dies with a network_fail crash BEFORE it looks at a disk.
  #
  # `renderer: NetworkManager` LOOKS like the fix and is not: netplan would then
  # emit /run/NetworkManager/system-connections/netplan-*, which sets
  # `restart_nm` in netplan's apply.py, and the NM *start* call there is NOT
  # guarded by nm_running() the way the stop call is. It shells out to
  # `systemctl start NetworkManager.service` through subprocess.check_call, the
  # unit does not exist in the live image, and apply fails again — same crash,
  # one stage later. Keying by the real name emits no /run/NetworkManager files
  # at all, so that path is never entered.
  #
  # WHY A HARDWARE-SPECIFIC NAME IS NOT A NEW CONSTRAINT: `wl*` bought
  # portability this image never had. It is already pinned to one machine by
  # `storage: match: serial:`, so a second value read off that same machine
  # costs nothing. wlp1s0 is the panel's Qualcomm Atheros QCA6174 (PCI 01:00.0),
  # read from its 2026-09-02 hardware baseline.
  #
  # ── AND ./netplan-wifi.yaml.template MUST USE THE SAME NETDEF ID ──────────
  # Nothing disables cloud-init's netplan, so on the running panel BOTH this
  # block (as 50-cloud-init.yaml) and firstboot's 60-wall-wifi.yaml describe
  # this one radio. Netplan merges them BY NETDEF ID: same id, and the
  # higher-numbered file cleanly overrides — which is how NetworkManager takes
  # ownership at the second boot. Different ids would be two netdefs for one
  # device, which is that template's own "up but unreachable". Change one of
  # these two files and you must change the other.
  network:
    version: 2
    wifis:
      wlp1s0:
        addresses: [REPLACE_WITH_PANEL_CIDR]
        routes:
          - to: default
            via: REPLACE_WITH_LAN_GATEWAY
        nameservers:
          addresses: [REPLACE_WITH_HUB_IP]
        # Still pinned: a randomized MAC breaks AP-side filtering and makes the
        # panel unrecognisable in the router's client list, even though nothing
        # now depends on it for addressing.
        macaddress: permanent
        access-points:
          "REPLACE_WITH_WIFI_SSID":
            password: "REPLACE_WITH_WIFI_PSK"

  identity:
    hostname: wall-panel
    realname: "Office Wall Panel"
    username: panel
    # SSH KEY-ONLY (same posture as the AWOW): "!" is a locked hash, so there is
    # no usable password login. The kiosk session is reached by AUTOLOGIN on tty1
    # (wall-firstboot.sh writes the getty drop-in), which needs no password.
    password: "!"

  # install-server: FALSE, AND SSHD IS STILL INSTALLED — the hub's user-data
  # carries the full argument. In short: `install-server: true` adds
  # openssh-server to the SAME pre-late-command apt run `packages:` uses, which
  # is the run that has no baked repo to draw on. openssh-server is in
  # ./packages.list and is installed offline by late-command 3c, which also
  # enables ssh.service.
  #
  # authorized-keys is unaffected — subiquity applies it through the target's
  # cloud-init user config. allow-pw is NOT, and this comment used to say both
  # were. Measured on an installed box: sshd -T reports `passwordauthentication
  # yes` and sshd_config.d is empty. Late-command 3c-ter installs the drop-in
  # that enforces what this line declares.
  ssh:
    install-server: false
    allow-pw: false
    authorized-keys:
      # REPLACE with your real public key(s). allow-pw:false means the panel is
      # unreachable over SSH until at least one valid key is here — and while it
      # is asleep (D-W4) it is unreachable regardless. See WALL-BURN-IN.md.
      - "ssh-ed25519 AAAA_REPLACE_WITH_YOUR_PUBLIC_KEY you@host"

  # Whole-disk automatic layout (LVM), same shape as the AWOW image. The panel's
  # disk is a 256 GB M.2 SATA (hardware baseline 2026-07-26; the machine shipped
  # with no disk at all). Nothing here is precious — quirk 4b makes unclean
  # power-cuts routine, which is survivable precisely because the panel is a
  # cache. See WALL-BURN-IN.md for the fsck-must-not-block check.
  # DESTRUCTIVE and unattended — same warning as the AWOW variant. Without a
  # `match:` the installer picks a disk by its own heuristic and every attached
  # disk is a candidate.
  #
  # Pinned by MODEL rather than path: the panel's internal disk is SATA
  # (KINGSTON RBU-SNS8152S3256GG2, 238.5 GB — 2026-07-26 baseline) and so
  # enumerates as `sd*`, exactly like the USB install stick. A `path:` match
  # would therefore be a coin flip on enumeration order, and losing it means
  # imaging the stick you booted from. The model string is stable and, unlike a
  # serial, is not device-identifying, so it is safe in this public repo.
  storage:
    layout:
      name: lvm
      match:
        model: KINGSTON*RBU-SNS8152S3256GG2

  # EMPTY, DELIBERATELY AND PERMANENTLY (2026-08-06). The list moved to
  # ./packages.list; late-command 3c installs it from a repo of frozen .debs
  # carried on the payload, so the install needs no network at all — which on
  # this image also means it needs no ASSOCIATED Wi-Fi.
  #
  # The hub's ../user-data carries the full argument for why not one name may
  # stay here. Short version: `packages:` runs during curtin's install step,
  # before any late-command, so no local apt source can serve it; every entry is
  # one more thing the install fetches from the archive, and fetching from the
  # archive at all is the failure. On this image it would additionally be the
  # ONE thing that still made an install depend on a radio.
  #
  # The Electron runtime's ~24 shared libraries moved with the rest, and the
  # checks that guard them moved too: assert_electron_runtime_deps and
  # test-wall-artifact.sh both read packages.list now. A soname that maps to a
  # package missing from that file still fails the BUILD, with the soname named.
  packages: []

  # THE ORDER CHANGED ON 2026-08-06, for the reason the hub's did: sections 1
  # and 2 configured packages that had not been installed yet under the new
  # scheme. Everything that needs an installed package now runs after 3c, which
  # installs from the repo the payload carries — so it cannot run before step 3
  # has put the payload on the target. Sections 1 and 2 are gone rather than
  # renumbered, so 3, 3a, 3b, 4a, 4, 5 and 7 keep their identities.
  late-commands:
    # ---- 3. Place the payload ------------------------------------------------
    # The build step copies the repo tree (plus the shell artifact) into
    # deploy-payload/, and it must land under /opt/wall-panel/ — the wall
    # variant's files are then at /opt/wall-panel/stack/autoinstall/wall/, which
    # is where every later late-command copies its units from.
    #
    # /cdrom IS NOT ENOUGH, and finding that out cost a whole install cycle
    # (2026-08-03). On the REPACKED path /cdrom is the combined ISO and carries
    # /deploy-payload, so this worked. On the LIGHT path — the one this repo
    # recommends by default — /cdrom is the STOCK Ubuntu ISO, which has no such
    # directory, and the CIDATA seed that does is mounted only transiently by
    # cloud-init to read user-data. So the payload rode along on the seed and
    # NOTHING EVER READ IT. The old line ended in `|| true`, so the install
    # sailed past it and died four commands later on a missing wall.env.example,
    # naming nothing useful. Mount the seed by its label instead.
    #
    # AND FAIL LOUDLY. Unlike the hub — which has a documented degraded mode
    # where firstboot pulls images instead — a wall image without its payload
    # cannot work at all: the units, the scripts and wall.env.example all come
    # from it. Better to stop here, saying so, than to install a panel that
    # cannot boot into anything.
    - mkdir -p /target/opt/wall-panel
    - >-
      bash -c 'set -e;
      for d in /cdrom /media /media/* /run/media/*; do
      if [ -d "$d/deploy-payload" ]; then cp -a "$d/deploy-payload/." /target/opt/wall-panel/; echo "wall: payload copied from $d/deploy-payload"; exit 0; fi;
      done;
      dev=$(blkid -L CIDATA 2>/dev/null || true);
      if [ -n "$dev" ]; then m=$(mktemp -d);
      if mount -o ro "$dev" "$m" 2>/dev/null; then
      if [ -d "$m/deploy-payload" ]; then cp -a "$m/deploy-payload/." /target/opt/wall-panel/; echo "wall: payload copied from the CIDATA seed at $dev"; umount "$m"; exit 0; fi;
      umount "$m"; fi; fi;
      echo "wall: FATAL - no deploy-payload found. Looked under /cdrom, /media, /run/media/* and on the CIDATA volume ($dev).";
      echo "wall: the seed ISO carries it at its root; on the light path nothing mounts that volume for you.";
      echo "wall: since 2026-08-06 the payload also carries the BAKED APT REPO - packages: is empty, so without it this panel installs no openssh-server and no cage.";
      exit 1'

    # ---- 3a. Decide the payload's PERMISSIONS --------------------------------
    # THE HUB'S 2026-08-04 DEFECT IS THIS IMAGE'S DEFECT TOO. Booting the hub
    # gate VM found /opt/homehub and 230 paths under it world-writable, because
    # a WSL build stages onto an NTFS mount where DrvFs reports 0777, Rock Ridge
    # records that faithfully and the `cp -a` above copies it faithfully.
    # /opt/wall-panel is populated by the identical mechanism, so it arrived the
    # identical way — and here it compounds OI-18, which found the staged
    # credentials readable by `panel` through a uid-1000 collision. At 0777 they
    # were readable by everyone, collision or not.
    #
    # ORDER IS LOAD-BEARING: this runs BEFORE step 3b, which untars the shell
    # artifact. `app/runtime/chrome-sandbox` must land 4755 root:root or Electron
    # refuses to start (Ubuntu 24.04 closes the unprivileged-userns sandbox), and
    # a recursive chmod AFTER the untar would strip the setuid bit and leave a
    # permanently dark panel with `[ -x ]` still true — the one failure mode with
    # no symptom on the screen. Nothing under app/ exists yet at this point.
    #
    # `chown -R 0:0` is OI-18's ownership lesson generalised: `-rock` preserves
    # the BUILDER's uid, and on an ordinary single-user builder that is 1000 —
    # which is `panel` on this machine. Late-command 4a/4b still DELETE the
    # staged credential copies outright; this only narrows the window before
    # they run, and the two agree about site/ being 0700.
    - >-
      bash -c 'R=/target/opt/wall-panel;
      if [ ! -d "$R" ]; then echo "wall: FATAL - no $R to normalise, though step 3 reported a copy"; exit 1; fi;
      chown -R 0:0 "$R" || { echo "wall: FATAL - could not take ownership of $R"; exit 1; };
      chmod -R go-w "$R" || { echo "wall: FATAL - could not clear group/world write on $R"; exit 1; };
      chmod 0755 "$R";
      if [ -d "$R/site" ]; then chmod 0700 "$R/site"; find "$R/site" -type f -exec chmod 0600 {} +; fi;
      find "$R" -type f -name "*.creds" -exec chmod 0600 {} + ;
      bad=$(find "$R" -perm /022 | head -n 5);
      if [ -n "$bad" ]; then
      echo "wall: FATAL - $R is STILL group- or world-writable after normalisation:";
      echo "$bad";
      echo "wall: a writable payload on a box whose units run as root is a local privilege escalation, and the panel autologins a kiosk user. Refusing to finish that install.";
      exit 1;
      fi;
      echo "wall: /opt/wall-panel normalised - root-owned, nothing group- or world-writable"'

    # ---- 3b. Unpack the shell artifact (IF-005 / PKG-1) ----------------------
    # The payload carries OfficeWallNaglight's panel tarball at
    # /opt/wall-panel/wall-app/officewall-shell-*-linux-x64.tar.gz (staged by
    # vmtest/lib/common.sh stage_wall_shell_into_payload). Unpacking it here
    # produces /opt/wall-panel/app/, so WALL_APP_CMD=/opt/wall-panel/app/wall-shell
    # is executable and cage runs THE app instead of the "NOT INSTALLED" screen.
    #
    # `tar`, AS ROOT, IS NOT A FORMALITY — and it is why this is a tar and not a
    # directory in the payload. app/runtime/chrome-sandbox must arrive
    # root:root 4755: Ubuntu 24.04 sets
    # kernel.apparmor_restrict_unprivileged_userns=1, which closes the namespace
    # sandbox, so the SUID helper is Electron's only remaining route and it
    # refuses to start without it. A `cp`, an unzip or an rsync from an unpacked
    # tree drops the bit silently; tar carries mode+uid+gid inside the archive.
    # This runs in the INSTALLER (root, /target mounted), not in-target, because
    # the archive is a whole self-contained runtime and needs no chroot.
    #
    # ABSENT IS TOLERATED, BROKEN IS NOT. A real-hardware image may legitimately
    # be built without the artifact (the panel then shows the explicit
    # NOT INSTALLED screen — a visible event, by design). But a tarball that is
    # present and fails to unpack must kill the install: the alternative is a
    # panel that crash-loops silently, which is the one failure mode with no
    # symptom on the screen at all.
    - >-
      bash -c 'set -e;
      t=$(ls -1 /target/opt/wall-panel/wall-app/officewall-shell-*-linux-x64.tar.gz 2>/dev/null | head -n1);
      if [ -z "$t" ]; then echo "wall: no shell artifact in the payload - the panel will show the NOT INSTALLED screen"; exit 0; fi;
      echo "wall: unpacking $t into /target/opt/wall-panel";
      tar -xzf "$t" -C /target/opt/wall-panel;
      [ -x /target/opt/wall-panel/app/wall-shell ] || { echo "wall: FATAL - unpacked but app/wall-shell is not executable"; exit 1; };
      [ -u /target/opt/wall-panel/app/runtime/chrome-sandbox ] || { echo "wall: FATAL - chrome-sandbox lost its setuid bit; Electron will refuse to start"; exit 1; };
      echo "wall: shell installed - $(cat /target/opt/wall-panel/app/VERSION 2>/dev/null)"'

    # ---- 3c. INSTALL EVERY PACKAGE, FROM THE PAYLOAD, WITH NO NETWORK --------
    # Identical in mechanism to the hub's 3c and identical in wording where it
    # can be — see ../user-data for the full reasoning (why the repo is a local
    # path inside the target, why the list is the exporter's own record, and why
    # nothing is written to /etc/apt). What differs is only the payload root.
    #
    # IT MATTERS MORE HERE. The panel's ONLY network was Wi-Fi, and a Wi-Fi
    # association at install time is the least reliable thing in this project —
    # it is also the one thing the VM lab can never test (Hyper-V has no
    # synthetic 802.11 device). An install that needs no network needs no radio,
    # so the gap between what the lab proves and what the bench does just closed
    # by the width of the whole apt phase.
    #
    # --no-remove for the reason ../user-data spells out in full: naming one
    # binary of the systemd source family drags the whole family's version, and
    # apt will happily DELETE a sibling the baked repo cannot match rather than
    # fail. Measured on this very image (2026-08-08): libnss-systemd and
    # systemd-timesyncd were both removed at install and nobody noticed, because
    # a panel with no time synchronisation still boots and still paints. This
    # install may upgrade and install; it may not remove.
    - >-
      curtin in-target --target=/target -- bash -c 'set -e;
      R=/opt/wall-panel;
      [ -s "$R/apt/Packages" ] || { echo "wall: FATAL - no baked apt repo at $R/apt (no Packages index)."; echo "wall: packages: is empty by design, so this install would produce a panel with no cage, no shell libraries and no sshd. Refusing."; exit 1; };
      [ -s "$R/apt/packages.baked.list" ] || { echo "wall: FATAL - $R/apt carries no packages.baked.list, so nothing here knows what to install."; exit 1; };
      mkdir -p /run/baked-apt/parts;
      echo "deb [trusted=yes] file://$R/apt ./" > /run/baked-apt/sources.list;
      APT="-o Dir::Etc::sourcelist=/run/baked-apt/sources.list -o Dir::Etc::sourceparts=/run/baked-apt/parts -o APT::Get::List-Cleanup=0";
      export DEBIAN_FRONTEND=noninteractive;
      apt-get $APT update;
      xargs -a "$R/apt/packages.baked.list" apt-get $APT install -y --no-install-recommends --no-remove;
      echo "wall: installed $(wc -l < "$R/apt/packages.baked.list") package(s) from the baked repo, with no network at all"'
    # sshd is the panel's ONLY door once it is on a wall: tty1 autologins into
    # cage, the console password is locked, and the machine is out of reach. A
    # unit that is installed but not enabled is a service that does not exist,
    # and curtin runs the chroot behind a policy-rc.d, so this is explicit.
    - curtin in-target --target=/target -- systemctl enable ssh

    # ---- 3c-bis. AND THE PANEL NEEDS THIS MORE THAN THE HUB DOES -------------
    # Same defect, same fix, worse consequence. `panel` is in the sudo group and
    # `password: "!"` is a locked hash, so sudo demanded a password that cannot
    # exist. On the hub that still left an undocumented escape — the `docker`
    # group, whose socket is root by design. THE PANEL HAS NO DOCKER, no Cockpit
    # (deliberately, see 3d below) and a console that autologins into cage. So
    # its only root path was a keyboard at the wall and init=/bin/bash at GRUB.
    #
    # WHAT THAT ACTUALLY COST: unattended-upgrades runs here and stages kernel
    # patches that need a reboot, and `systemctl reboot` needs root — so the one
    # action the panel periodically requires could not be performed remotely at
    # all. Suspend/resume reuses the same kernel, so the pending-reboot state
    # never cleared itself either. A panel is reimage-not-repair (SN-013), but
    # that ruling is about not spending time REPAIRING one; it was never meant to
    # mean a reboot needs a trip across the office.
    #
    # The full argument for the ALL and for validating first is on the hub image,
    # at the same step. The short version: this is the cloud-image posture
    # (locked password + key-only SSH + NOPASSWD sudo, exactly what Ubuntu's own
    # cloud.cfg ships), and a malformed sudoers file on a box with a locked
    # password is the no-way-in state, so it is checked before it is installed.
    - |
      curtin in-target --target=/target -- bash -c '
      set -e
      T=$(mktemp)
      printf "%s\n" \
        "# Managed by the WallPanel autoinstall. See wall/user-data 3c-bis." \
        "# The SSH key is the credential: this account has a LOCKED password, and" \
        "# this panel has no docker group and no Cockpit, so without this line" \
        "# there is NO root path at all short of a keyboard at the wall." \
        "panel ALL=(ALL) NOPASSWD:ALL" > "$T"
      visudo -cf "$T"
      install -o root -g root -m 0440 "$T" /etc/sudoers.d/90-wallpanel-ops
      rm -f "$T"
      echo "wall: /etc/sudoers.d/90-wallpanel-ops installed and validated"'

    # ---- 3c-ter. THE HARDENING `allow-pw: false` NEVER APPLIED ----------------
    # The hub's user-data carries the full argument at the same step; it was
    # measured there, on an installed box, and this image renders the ssh: block
    # exactly the same way, so it has the same hole. In short: allow-pw is
    # applied by cloud-init's set_passwords during the in-target pass that
    # `install-server: false` turns off, so the KEYS land and the HARDENING does
    # not — sshd -T reports `passwordauthentication yes` on a machine whose
    # documented posture is key-only.
    #
    # ON THE PANEL IT MATTERS MORE. This box hangs on a wall in a room, its only
    # door is sshd, and it is invisible: there is no Cockpit, no console anyone
    # can reach past the cage autologin, and nothing that would ever surface the
    # fact that password authentication is quietly accepted from the whole LAN.
    #
    # Validated DIFFERENTIALLY, exactly as on the hub and for the reason spelled
    # out there: inside curtin's chroot `sshd -t` can fail over missing host keys
    # no matter what the config says, so it is run with the drop-in and then
    # without. Failing both ways is the chroot's fault and the file is kept;
    # failing only with it means the file is broken and the install stops. A
    # panel with a broken sshd_config is a panel that has to come off the wall.
    - |
      curtin in-target --target=/target -- bash -c '
      set -e
      D=/etc/ssh/sshd_config.d
      mkdir -p "$D"
      F="$D/90-wallpanel-hardening.conf"
      printf "%s\n" \
        "# Managed by the WallPanel autoinstall. See wall/user-data 3c-ter." \
        "# autoinstall ssh.allow-pw: false does NOT survive install-server: false." \
        "# sshd is this panel ONLY door; assert-installed.sh checks sshd -T." \
        "PasswordAuthentication no" \
        "KbdInteractiveAuthentication no" \
        "PermitRootLogin no" \
        "PubkeyAuthentication yes" > "$F"
      chmod 0644 "$F"
      if sshd -t 2>/tmp/sshd-t.with; then
        echo "wall: $F installed and validated (sshd -t)"
      else
        mv "$F" /tmp/90-wallpanel-hardening.conf
        if sshd -t 2>/dev/null; then
          echo "wall: FATAL - the sshd hardening drop-in does not parse:" >&2
          cat /tmp/sshd-t.with >&2
          echo "wall: removed it. sshd is the only door this panel has." >&2
          exit 1
        fi
        install -o root -g root -m 0644 /tmp/90-wallpanel-hardening.conf "$F"
        echo "wall: WARN - sshd -t cannot run in this chroot (it fails with and without" >&2
        echo "wall: the drop-in). Keeping it; assert-installed.sh checks sshd -T on the box." >&2
        cat /tmp/sshd-t.with >&2
      fi'

    # ---- 3d. Remote management (lighter than the AWOW's: no Cockpit) ---------
    # A panel is reimage-not-repair, so it gets SSH + unattended-upgrades and
    # deliberately NOT Cockpit — one less always-listening web surface on a box
    # that is asleep half the time anyway. unattended-upgrades is also what
    # catches the panel up on whatever the frozen debs are behind on, the first
    # time it associates.
    - curtin in-target --target=/target -- bash -c 'echo "unattended-upgrades unattended-upgrades/enable_auto_updates boolean true" | debconf-set-selections'
    - curtin in-target --target=/target -- dpkg-reconfigure -f noninteractive unattended-upgrades
    - curtin in-target --target=/target -- systemctl enable unattended-upgrades

    # ---- 3e. Lighten the image ----------------------------------------------
    # Nothing here uses snaps, and this is a 2016 U-class machine behind a wall.
    # Purge and autoremove are local dpkg/apt operations and need no network.
    - curtin in-target --target=/target -- bash -c 'DEBIAN_FRONTEND=noninteractive apt-get purge -y snapd 2>/dev/null || true; apt-get autoremove -y --purge'

    # ---- 4a. Install a pre-filled wall.env if the payload carries one --------
    # The PRODUCTION/SIM seam, same shape as the hub image's site/ directory:
    # a build that materialised the panel's config puts it at
    # deploy-payload/site/wall.env and it lands here 0600. The wall builder
    # writes a SIM one (vmtest/lib/common.sh render_sim_wall_env); nothing
    # emits a production one yet, and the builder refuses to pretend otherwise.
    # Step 4 below then no-ops, because the file already exists.
    # `install -m 0600 -o root -g root` and not `cp`: the payload copy's mode AND
    # OWNERSHIP come from whatever filesystem the ISO was staged on.
    #
    # AND THE PAYLOAD COPY IS DELETED, NOT MERELY CHMODDED. It used to be
    # `chmod 0600 <payload copy>`, which fixes the mode and leaves the OWNER
    # alone — and the owner is the builder's uid, carried through Rock Ridge
    # (`-rock`, which preserves uid/gid) and then through `cp -a` in late-command
    # 3. On the ordinary single-user Linux/WSL builder that uid is 1000, and the
    # panel's `panel` user is ALSO 1000, so `/opt/wall-panel/site/wall.env`
    # (Wi-Fi PSK) stayed readable by the kiosk user for the life of the install.
    # There is no reason to keep a second copy once /etc has the real one.
    - >-
      curtin in-target --target=/target -- bash -c 'set -e;
      s=/opt/wall-panel/site/wall.env;
      if [ ! -f "$s" ]; then echo "wall: no site/wall.env in the payload - step 4 seeds from wall.env.example"; exit 0; fi;
      install -d -m 0755 /etc/wall-panel;
      install -m 0600 -o root -g root "$s" /etc/wall-panel/wall.env;
      rm -f "$s";
      echo "wall: installed /etc/wall-panel/wall.env (0600 root:root); payload copy REMOVED"'
    # ONE credential file, when a production build staged it (Q-S7, the Owner,
    # 2026-08-05). The panel has TWO media sources on TWO hosts, but only the
    # frame one authenticates:
    #   cifs-frame.creds -> MEDIA_FRAME_CIFS_CREDENTIALS, the Mini-serv `share`
    #                       account (A11(v)/A10(v))
    #   (music)          -> NOTHING. //homehub/Media is an anonymous read-only
    #                       share, so wall-sync mounts it with `guest`.
    # The wall.env default points at exactly this path. Absent, wall-sync fails
    # loudly — which is intended, not a silent degrade (a blank picture frame
    # with a green unit would be a lie); note that this is a CONFIGURATION
    # defect and is fatal, unlike the frame flow's designed "Mini-serv is
    # asleep" skip.
    #
    # `install -m 0600 -o root -g root` and not `cp`: the payload copy's mode and
    # ownership come from whatever filesystem the ISO was staged on, and a build
    # run under WSL on /mnt/c produces 0777. Still loud per file, and still a
    # loop, because the count in the journal line is what an operator reads to
    # know the image was staged as intended.
    #
    # THE PAYLOAD COPIES ARE DELETED, NOT CHMODDED — this was a real on-box
    # credential exposure. `vmtest/lib/common.sh stage_wall_site_files` writes
    # them 0600, but owned by whoever ran the build; the ISO is written with
    # `-rock`, which PRESERVES uid/gid; late-command 3's `cp -a` carries that uid
    # into /opt/wall-panel/site. The old `chmod 0600 "$s"` therefore fixed a mode
    # that was already right and left the ownership alone, so on a builder with
    # the ordinary uid 1000 — the same uid the panel gives `panel` — the kiosk
    # user could read the Samba passwords out of /opt/wall-panel/site for the
    # life of the install. /etc/wall-panel now holds the only copy.
    #
    # NOTE there is no `cifs-music.creds` to install since Q-S7 (2026-08-05):
    # the music mount is anonymous. A stale one is refused by the BUILDER
    # (stage_wall_site_files), so it never reaches the payload and this loop
    # never sees it — the refusal belongs upstream, where the operator can act
    # on it, not on a panel three hours into an install.
    - >-
      curtin in-target --target=/target -- bash -c 'set -e;
      install -d -m 0755 /etc/wall-panel;
      n=0;
      for f in cifs-frame.creds; do
      s=/opt/wall-panel/site/$f;
      if [ -f "$s" ]; then
      install -m 0600 -o root -g root "$s" "/etc/wall-panel/$f";
      rm -f "$s";
      n=$((n + 1));
      echo "wall: installed /etc/wall-panel/$f (0600 root:root); payload copy REMOVED";
      else
      echo "wall: NO site/$f - that media source cannot be mounted and wall-sync will FAIL loudly until it is placed by hand";
      fi;
      done;
      rmdir /opt/wall-panel/site 2>/dev/null || true;
      echo "wall: $n of 1 cifs credential file(s) installed (music mounts anonymously - Q-S7)"'

    # ---- 4. Seed wall.env from the example if not pre-filled ------------------
    # Root-only: it carries the Wi-Fi PSK and (if enabled) music credentials.
    - curtin in-target --target=/target -- bash -c '[ -f /etc/wall-panel/wall.env ] || { mkdir -p /etc/wall-panel && cp /opt/wall-panel/stack/autoinstall/wall/wall.env.example /etc/wall-panel/wall.env && chmod 0600 /etc/wall-panel/wall.env; }'

    # ---- 5. First-boot + per-boot units --------------------------------------
    # wall-firstboot   — once: renders every config file the quirks need.
    # wall-wakeprep    — EVERY boot: ACPI/USB wake enablement does not persist.
    # wall-sleep/-wake — the D-W4 sleep window; their .timer files are RENDERED
    #                    by firstboot from SLEEP_START/SLEEP_END (systemd cannot
    #                    interpolate an env var into OnCalendar).
    # wall-occupancy   — EVERY MINUTE (a .timer), and ONLY when
    #                    WALL_ABSENCE_ENABLED=true: the SN-015 presence tick.
    #                    Enabled/disabled by wall-firstboot.sh step 6b, not here.
    # wall-sync        — ONCE AFTER BOOT, ON EVERY RESUME, and on demand over
    #                    SSH: mirror BOTH media shares into the panel's cache
    #                    (OI-15; two sources since OI-18). No timer on THIS unit,
    #                    by the ruling. The resume trigger is
    #                    wall-sync-resume.service (OI-16a): the panel suspends
    #                    nightly and a resume is not a boot, so boot-only would go
    #                    weeks stale.
    # wall-sync-frame  — EVERY MINUTE (a .timer): the frame flow only, because
    #                    storage-map §4d gives it that cadence and the music flow
    #                    a different one. Same script, `--only frame`.
    # `install -m 0644`, NOT `cp`, for every unit below - same defect the hub's
    # user-data carried, found the same day (2026-08-28) by TC-H-R07. The payload
    # is staged from a Windows checkout through a DrvFs mount that hands every
    # file mode 0777, and `cp` PRESERVES that, so every one of these units landed
    # on the panel executable. systemd loads them anyway and prints "marked
    # executable ... Proceeding anyway" into a journal nobody reads on a wall-
    # mounted box with no keyboard. Nothing fails, which is why it survived.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-firstboot.service /target/etc/systemd/system/wall-firstboot.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-firstboot.sh /target/usr/local/sbin/wall-firstboot.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-firstboot.sh
    - curtin in-target --target=/target -- systemctl enable wall-firstboot.service
    # wall-door-stream — WSN-019. Installed here; firstboot creates the
    # unprivileged account and enables/starts it only after wall.env and the
    # packaged application broker both exist.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-door-stream.service /target/etc/systemd/system/wall-door-stream.service
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-wakeprep.service /target/etc/systemd/system/wall-wakeprep.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-wakeprep.sh /target/usr/local/sbin/wall-wakeprep.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-wakeprep.sh
    - curtin in-target --target=/target -- systemctl enable wall-wakeprep.service
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sleep.service /target/etc/systemd/system/wall-sleep.service
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-wake.service /target/etc/systemd/system/wall-wake.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sleep.sh /target/usr/local/sbin/wall-sleep.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-sleep.sh
    # wall-occupancy — SN-015. The every-minute presence tick and the pure
    # decider it calls. The TIMER IS NOT ENABLED HERE: wall-firstboot.sh step 6b
    # enables or disables it from WALL_ABSENCE_ENABLED, which is false by
    # default, so a stock image behaves exactly as it did before SN-015.
    # Unlike the two sleep timers this one is a fixed cadence, so it is a
    # tracked unit file rather than one rendered from the env.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-occupancy.service /target/etc/systemd/system/wall-occupancy.service
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-occupancy.timer /target/etc/systemd/system/wall-occupancy.timer
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-occupancy.py /target/usr/local/sbin/wall-occupancy.py
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-occupancy.py
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-kiosk.sh /target/usr/local/bin/wall-kiosk.sh
    - curtin in-target --target=/target -- chmod +x /usr/local/bin/wall-kiosk.sh
    # wall-sync — the media pull (OI-15). Boot-once + on-demand oneshot; NO timer
    # on this unit, by the ruling. The manifest generator is installed NEXT TO the
    # script because wall-sync.sh looks for it there first (and in the payload dir
    # as a fallback).
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sync.service /target/etc/systemd/system/wall-sync.service
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-sync.sh /target/usr/local/sbin/wall-sync.sh
    - cp /target/opt/wall-panel/stack/autoinstall/wall/wall-media-manifest.py /target/usr/local/sbin/wall-media-manifest.py
    - curtin in-target --target=/target -- chmod +x /usr/local/sbin/wall-sync.sh /usr/local/sbin/wall-media-manifest.py
    - curtin in-target --target=/target -- systemctl enable wall-sync.service
    # wall-sync-frame — the frame flow's every-minute cadence (OI-18 exit (b),
    # storage-map §4d). Only the TIMER is enabled: nothing should start the
    # service at boot, because wall-sync.service already mirrors both flows there.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sync-frame.service /target/etc/systemd/system/wall-sync-frame.service
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sync-frame.timer /target/etc/systemd/system/wall-sync-frame.timer
    - curtin in-target --target=/target -- systemctl enable wall-sync-frame.timer
    # wall-sync-resume — the OI-16a hook: WantedBy=suspend.target, so every wake
    # from the D-W4 nightly suspend re-triggers wall-sync (detached, --no-block —
    # the wake is never delayed). Enabling it is what plants the suspend.target
    # symlink; without that the hook exists but never fires.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sync-resume.service /target/etc/systemd/system/wall-sync-resume.service
    - curtin in-target --target=/target -- systemctl enable wall-sync-resume.service
    # wall-sync-suspend — the mirror image of the resume hook (D1, 2026-09-05):
    # WantedBy=sleep.target + Before=sleep.target, so the media sync is stopped
    # BEFORE the freezer runs. Measured on the real panel: an active rsync on a
    # cifs mount cannot reach a freeze checkpoint inside the kernel's 20 s
    # window, so the nightly suspend failed twice (deep, then s2idle) and left
    # the panel awake with the screen on. Enabling is what plants the
    # sleep.target symlink; without it the unit exists and never fires.
    - install -m 0644 /target/opt/wall-panel/stack/autoinstall/wall/wall-sync-suspend.service /target/etc/systemd/system/wall-sync-suspend.service
    - curtin in-target --target=/target -- systemctl enable wall-sync-suspend.service
    # Seat access for the kiosk user (cage needs the DRM/input devices).
    - curtin in-target --target=/target -- usermod -aG video,input,render panel

    # ---- 6. mem_sleep_default=deep — NOTE, deliberately NOT applied ----------
    # D-W4 wants S3 ("deep"), not s2idle: on this hardware generation s2idle
    # often saves little more than backlight-off, which would defeat L2 entirely.
    # The 2026-07-26 baseline confirmed `deep` is SUPPORTED and a full
    # suspend/resume cycle PASSED — but whether `deep` is the RUNNING DEFAULT is
    # read off /sys/power/mem_sleep, which no one can do from here.
    # wall-firstboot.sh therefore READS it and warns loudly if it shows
    # `[s2idle] deep`. Editing the kernel cmdline is left as this ONE explicit
    # command rather than done silently, because a bad cmdline on a wall-mounted
    # machine with no keyboard is an unpleasant recovery:
    #
    #   sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/GRUB_CMDLINE_LINUX_DEFAULT="\1 mem_sleep_default=deep"/' /etc/default/grub && update-grub
    #
    # Run it over SSH after the first boot IF firstboot reported s2idle, then
    # re-run the suspend/resume test (WALL-BURN-IN.md §4).

    # ---- 7. REFUSE TO FINISH AN INSTALL THAT DID NOT PRODUCE ITS ARTIFACTS ----
    # Same reasoning and same limits as the hub's step 6 - see that file. It
    # matters more here, not less: this machine is wall-mounted with no
    # keyboard, so "boots but is incomplete" is the most expensive possible
    # outcome. Caught before the reboot, or not at all until it is on a wall.
    #
    # THE PAYLOAD ROOT IS /opt/wall-panel, and this block said /opt/homehub
    # until 2026-08-06 - copied from the hub's step 6 and never re-read. A path
    # this image NEVER creates cannot be missing on purpose, so the check could
    # only ever fail; it had not been reached yet because the failure it guards
    # comes after a payload copy that has never run on real panel hardware. Both
    # heads of the same copy-paste are fixed together: vmtest/assert-installed.sh
    # asked for the same wrong path.
    #
    # The package loop is the hub's, for the hub's reason: cage, the ~24 Electron
    # libraries and openssh-server are the panel's whole reason to exist, and a
    # missing one of them is a black wall or a locked-out machine rather than an
    # error message.
    - |
      curtin in-target --target=/target -- bash -c '
        missing=""
        for p in /opt/wall-panel /usr/sbin/sshd \
                 /etc/systemd/system/wall-firstboot.service; do
          [ -e "$p" ] || missing="$missing $p"
        done
        if [ -n "$missing" ]; then
          echo "wall: FATAL - the install is incomplete. Missing:$missing" >&2
          echo "wall: refusing to reboot into a panel that looks installed and is not." >&2
          exit 1
        fi
        L=/opt/wall-panel/apt/packages.baked.list
        if [ ! -s "$L" ]; then
          echo "wall: FATAL - $L is absent, so late-command 3c cannot have installed anything." >&2
          exit 1
        fi
        notinst=""
        while read -r pkg; do
          [ -n "$pkg" ] || continue
          dpkg-query -W -f=\${Status} "$pkg" 2>/dev/null | grep -q "^install ok installed$" \
            || notinst="$notinst $pkg"
        done < "$L"
        if [ -n "$notinst" ]; then
          echo "wall: FATAL - the baked repo did not install:$notinst" >&2
          echo "wall: a missing Electron library is a BLACK WALL with no message on it, and a missing" >&2
          echo "wall: openssh-server is a wall-mounted machine with no way in. Refusing to reboot." >&2
          exit 1
        fi
        echo "wall: install completeness check passed ($(wc -l < "$L") baked package(s) installed)."
      '

    # ── ACER FIRMWARE: MAKE THE SPEC'S FALLBACK BOOT PATH SELF-SUFFICIENT ─────
    # WHY THIS EXISTS (2026-09-03, and it cost an evening). This panel's Insyde
    # firmware DISCARDS the NVRAM boot entry the installer creates. Observed, not
    # inferred: `efibootmgr -c` put `ubuntu` at the head of BootOrder; one reboot
    # later BootOrder listed only the firmware's own entries and `ubuntu` was gone.
    #
    # UEFI requires firmware to boot \EFI\Boot\BOOTX64.EFI with no NVRAM entry at
    # all — it is how a USB stick boots on a machine that has never seen it.
    # shim-signed installs itself there, so the panel HAS that path. What it lacks
    # is the second stage: shim loads grubx64.efi FROM ITS OWN DIRECTORY, and
    # grub-install only ever writes one into \EFI\ubuntu\. So the fallback path
    # loaded shim and dead-ended, and the firmware said "Default Boot Device
    # Missing or Boot Failed".
    #
    # AND THE DEAD END WAS NOT QUIET. shim runs \EFI\Boot\fbx64.efi when it cannot
    # find its entry; fbx64 re-creates the entry from BOOTX64.CSV and RESETS the
    # machine so the firmware picks it up. Against firmware that discards the entry
    # every boot, that recovery becomes a loop — create, reset, discard, create —
    # about ten seconds per cycle, appending one new Boot#### each time. This panel
    # reached 131 identical entries, and a boot-variable store that full is its own
    # class of firmware misbehaviour.
    #
    # So: put GRUB beside shim in the fallback directory, and disable the
    # re-creator. The panel then boots by the one mechanism this firmware actually
    # honours, and a dropped NVRAM entry degrades to a clean failure instead of a
    # self-amplifying loop. Ubuntu's grubx64.efi carries /EFI/ubuntu as its
    # compiled-in prefix, so it still finds grub.cfg and /boot from either path.
    #
    # WALL IMAGE ONLY, STRUCTURALLY. This file is the panel's seed; the hub builds
    # from ../user-data and cannot be reached from here. The hub is a different
    # machine with different firmware and has never shown this — which is why the
    # fix lives in the seed of the box that needs it rather than in the shared
    # builder.
    #
    # NON-FATAL BY DESIGN. Every failure below is reported and skipped. A panel
    # that installed correctly must not be denied its reboot because a workaround
    # for somebody else's firmware could not be applied.
    # AND IT IS RE-ASSERTED, NOT PERFORMED ONCE (2026-09-03, adversarial review).
    # grub-efi-amd64-signed's postinst re-runs grub-install on EVERY upgrade, and
    # this box has grub2/no_efi_extra_removable false, so an upgrade refreshes
    # \EFI\BOOT\BOOTX64.EFI with a NEW shim and restores fbx64.efi — while a
    # grubx64.efi copied here at install time is never touched again. A one-shot
    # repair therefore leaves the panel booting an install-day GRUB that no
    # security update reaches, and re-arms the reset loop for the day a newer
    # shim refuses that stale GRUB. unattended-upgrades is in ./packages.list, so
    # this is a matter of weeks, not theory.
    #
    # So the install-time step below only lays down the MECHANISM:
    #   /usr/local/sbin/wall-efi-fallback-sync   the idempotent repair itself
    #   /etc/apt/apt.conf.d/99-wall-efi-fallback fires it after any apt run, so
    #                                            an upgrade is undone before the
    #                                            next boot can hit it
    #   wall-efi-fallback.service                every boot, as the backstop for
    #                                            a hand-run grub-install or a
    #                                            hook that did not fire
    # then runs it once for this install. The sync copies GRUB only when the
    # content differs, which is what keeps the fallback path CURRENT rather than
    # frozen.
    - |
      set -u
      esp=/target/boot/efi
      pay=/target/opt/wall-panel/stack/autoinstall/wall
      ok=1
      for f in "$pay/wall-efi-fallback-sync.sh" "$pay/wall-efi-fallback.service"; do
        [ -f "$f" ] || { echo "wall: EFI boot repair SKIPPED - $f is not on the payload."; ok=0; }
      done
      if [ ! -d "$esp/EFI/BOOT" ] || [ ! -f "$esp/EFI/ubuntu/grubx64.efi" ]; then
        echo "wall: EFI boot repair SKIPPED - $esp/EFI/{BOOT,ubuntu} is not laid out as expected."
        ok=0
      fi
      if [ "$ok" = 1 ]; then
        install -D -m 0755 "$pay/wall-efi-fallback-sync.sh" /target/usr/local/sbin/wall-efi-fallback-sync \
          && echo "wall: EFI boot repair - installed /usr/local/sbin/wall-efi-fallback-sync." \
          || { echo "wall: EFI boot repair - could NOT install the sync script (continuing)."; ok=0; }
        install -D -m 0644 "$pay/wall-efi-fallback.service" /target/etc/systemd/system/wall-efi-fallback.service \
          && echo "wall: EFI boot repair - installed wall-efi-fallback.service." \
          || echo "wall: EFI boot repair - could NOT install the unit (continuing)."
        # Enabled by the wants symlink rather than `systemctl enable`: there is no
        # booted systemd in /target to ask, and this is exactly what enable writes.
        mkdir -p /target/etc/systemd/system/multi-user.target.wants \
          && ln -sf /etc/systemd/system/wall-efi-fallback.service \
                    /target/etc/systemd/system/multi-user.target.wants/wall-efi-fallback.service \
          && echo "wall: EFI boot repair - wall-efi-fallback.service enabled for multi-user.target." \
          || echo "wall: EFI boot repair - could NOT enable the unit (continuing)."
        # `|| true` inside the hook on purpose: this must never be able to fail an
        # apt run. The unit re-tries at the next boot and the failure is logged.
        printf '%s\n' 'DPkg::Post-Invoke { "if [ -x /usr/local/sbin/wall-efi-fallback-sync ]; then /usr/local/sbin/wall-efi-fallback-sync || true; fi"; };' \
          > /target/etc/apt/apt.conf.d/99-wall-efi-fallback \
          && chmod 0644 /target/etc/apt/apt.conf.d/99-wall-efi-fallback \
          && echo "wall: EFI boot repair - apt hook installed (re-asserts after every upgrade)." \
          || echo "wall: EFI boot repair - could NOT install the apt hook (continuing)."
        # Run it now, against the target's ESP, so this install boots repaired.
        if [ "$ok" = 1 ]; then
          WALL_ESP="$esp" bash "$pay/wall-efi-fallback-sync.sh" \
            && echo "wall: EFI boot repair - applied to this install." \
            || echo "wall: EFI boot repair - the sync reported a problem (see above); continuing."
        fi
        sync
      fi

  # ── If the install does not run, SAY WHY, on the console (2026-08-06) ──────
  # Identical in purpose to the AWOW variant's block, and identical in text on
  # purpose — the operator standing at a halted machine should not have to
  # notice which image they booted to read the same diagnosis. See the hub's
  # user-data for the full reasoning; the short version is that Subiquity's
  # `Failed to find matching device for {...}` does not say what THIS machine
  # reports, and the shell it offers cannot be accepted before the box reboots.
  #
  # The panel's pin is materialised to a serial from Personal, same as the hub,
  # so it is read back from the seed rather than written into this public file.
  error-commands:
    - |
      {
        echo
        echo "=============================================================="
        echo " THE INSTALL FAILED."
        echo "=============================================================="
        echo
        # See the hub's user-data for why this is DETERMINED rather than
        # asserted: the earlier version of this banner claimed "Nothing was
        # written to any disk" unconditionally and, on 2026-08-06, said so over
        # a disk that had already been imaged.
        if grep -q ' /target ' /proc/mounts 2>/dev/null; then
          TARGET_MOUNTED=yes
          echo "STATE: /target IS MOUNTED - the target disk HAS been written."
          echo "       This is NOT the storage-pin halt. A PARTIAL INSTALL exists."
        else
          TARGET_MOUNTED=no
          echo "STATE: /target is not mounted."
          echo "       Most likely nothing was written by THIS run - but that is"
          echo "       an inference from what is visible now, not a guarantee."
        fi
        echo
        if [ "$TARGET_MOUNTED" = yes ] && cp -a /var/log/installer /target/var/log/installer-failed 2>/dev/null; then
          echo "LOGS: saved to /var/log/installer-failed/ ON THE TARGET DISK."
        else
          echo "LOGS: could NOT be saved to the target. They are at"
          echo "      /var/log/installer here and die at reboot. Copy them now."
        fi
        echo
        echo "-- the tail of the installer's own log --"
        tail -n 25 /var/log/installer/subiquity-server-debug.log 2>/dev/null \
          || echo "   (no subiquity-server-debug.log - the failure was very early)"
        echo
        echo "-- the disk this image expects (its pin, read back from the seed) --"
        for f in /autoinstall.yaml /cdrom/nocloud/user-data; do
          [ -f "$f" ] || continue
          sed -n '/^  storage:/,/^  [a-z]/p' "$f" | grep -E '^ +(serial|model|path|wwn):' && break
        done
        echo
        echo "-- the disks this machine actually reports --"
        lsblk -dn -o NAME,SIZE,MODEL,SERIAL 2>/dev/null
        echo
        echo "-- udev ID_SERIAL per disk (THIS is what 'match: serial' compares) --"
        for d in /dev/sd? /dev/nvme?n? /dev/mmcblk?; do
          [ -b "$d" ] || continue
          echo "   $d  $(udevadm info --query=property --name="$d" 2>/dev/null | sed -n 's/^ID_SERIAL=//p')"
        done
        echo
        if [ "$TARGET_MOUNTED" = yes ]; then
          echo "THE DISK WAS ALREADY WRITTEN, so this is NOT the pin halting and"
          echo "the unpinned GRUB entry will not help. The cause is in the log"
          echo "above and in /var/log/installer-failed/ on the installed system."
        else
          echo "If a disk above IS this machine's internal disk, the pin is most"
          echo "likely the SHORT serial. Subiquity matches udev ID_SERIAL, usually"
          echo "MODEL_SERIAL_LUN - not the bare serial on the sticker or in lsblk."
          echo "NOTE: on this panel the internal disk is SATA and enumerates as"
          echo "sd*, exactly like the USB stick you booted from. Read the sizes."
          echo
          echo "TO INSTALL ON THIS MACHINE ANYWAY, now, without rebuilding the ISO:"
          echo "  reboot, and at the GRUB menu (10 second timeout) choose"
          echo "    Install - choose target disk manually (unpinned)"
          echo "  It stops at the storage screen for you to pick and confirm a disk."
          echo
          echo "TO LOOK AROUND FIRST: choose 'Diagnostic Shell (no autoinstall)'."
        fi
        echo "=============================================================="
        echo
      } > /dev/console 2>&1

  # No reboot prompt — straight into the panel.
  shutdown: reboot
