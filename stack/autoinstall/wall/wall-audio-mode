#!/bin/sh
# wall-audio-mode {trigger|panel|status} — switch the panel's output chain.
#
# WHY THIS IS A SCRIPT AND NOT A MIXER SETTING: `pcm.!default` is static in ALSA
# configuration, so the mode has to swap an included file. Three consequences
# follow, and all three were found by review rather than by use:
#
# 1. ALSA RESOLVES `default` WHEN A CLIENT OPENS IT. Swapping the symlink does
#    not retarget a PCM that is already open, so the kiosk keeps playing into
#    the old chain -- into a loopback nothing is forwarding any more, or onto
#    the panel speaker while the amplifier waits for a trigger that never comes.
#    The kiosk is restarted here for that reason. It runs from a tty autologin
#    loop rather than a unit, so killing it is how it reloads.
#
# 2. dmix and dsnoop keep their parameters in SysV IPC, and a segment left from
#    the previous mode is REUSED rather than rebuilt. Clients then read a stale
#    layout and get garbage that looks convincingly like a signal, with nothing
#    logged anywhere.
#
# 3. The forwarding and trigger units must be DISABLED in panel mode, not merely
#    stopped: panel mode defines no `kiosk_monitor`, so on the next boot an
#    enabled wall-kiosk-loop would fail and be restarted every two seconds for
#    as long as the panel stays in that mode.
#
# AUTO-MUTE STAYS DISABLED IN BOTH MODES, for opposite reasons: in trigger mode
# so a pulled trigger cable cannot unmute the panel's own speaker into a
# full-scale tone, and in panel mode so an inserted one cannot mute the speaker
# that is supposed to be playing.
set -eu

MODE_FILE=/etc/wall-panel/audio-mode
LINK=/etc/wall-panel/audio-out.conf
CONF_DIR=/etc/wall-panel
# Card ids are generated into audio-cards.env by firstboot from wall.env, and
# the defaults below are only a fallback for a panel whose file predates it.
ADAPTER=ICUSBAUDIO7D
BUILTIN=PCH
# shellcheck source=/dev/null
[ -r /etc/wall-panel/audio-cards.env ] && . /etc/wall-panel/audio-cards.env
ADAPTER=${WALL_AUDIO_ADAPTER_CARD:-$ADAPTER}
BUILTIN=${WALL_AUDIO_BUILTIN_CARD:-$BUILTIN}
FAILED=0

usage() { echo "usage: $0 {trigger|panel|status}" >&2; exit 2; }

note_failure() {
    FAILED=$((FAILED + 1))
    echo "FAILED: $*" >&2
}

# Mixer changes are reported, not swallowed. A Headphone left muted means the
# trigger tone exists with no voltage behind it; a Speaker left unmuted in
# trigger mode means a full-scale tone on the wall.
mix() {
    _card=$1; shift
    amixer -c "$_card" -q sset "$@" 2>/dev/null || note_failure "amixer -c $_card sset $*"
}

unit() {
    _action=$1; shift
    systemctl "$_action" "$@" 2>/dev/null || note_failure "systemctl $_action $*"
}

start_if_enabled() {
    case "$(systemctl is-enabled "$1" 2>/dev/null)" in
        disabled|masked) echo "$1 left stopped (disabled)" ;;
        *) unit start "$1" ;;
    esac
}

# Remove only OUR direct-plugin IPC: the segments carry ipc_gid=audio, which is
# what distinguishes them, and shared memory is removed only when nothing is
# attached. A blanket sweep of low-numbered keys would take unrelated services'
# objects and could pull a segment out from under a client still using it.
clear_ipc() {
    ipcs -m -c 2>/dev/null | awk '$6 == "audio" {print $1}' | while read -r id; do
        nattch=$(ipcs -m -i "$id" 2>/dev/null | awk '/nattch/ {print $NF}')
        [ "${nattch:-1}" = "0" ] && ipcrm -m "$id" 2>/dev/null || true
    done
    ipcs -s -c 2>/dev/null | awk '$6 == "audio" {print $1}' | while read -r id; do
        ipcrm -s "$id" 2>/dev/null || true
    done
}

# The kiosk holds its PCM across a mode change unless it is restarted. It is not
# a systemd service -- wall-kiosk.sh runs it from an autologin tty in a restart
# loop -- so this is how it reloads.
restart_kiosk() {
    if pgrep -f 'runtime/electron' >/dev/null 2>&1; then
        pkill -f 'runtime/electron' 2>/dev/null || true
        echo "kiosk restarted so it reopens its PCM"
    fi
}

apply_trigger() {
    ln -sfn "$CONF_DIR/asound-trigger-mode.conf" "$LINK"
    printf 'trigger\n' > "$MODE_FILE"
    mix "$BUILTIN" 'Auto-Mute Mode' Disabled
    mix "$BUILTIN" Speaker mute
    mix "$BUILTIN" Master 100% unmute
    mix "$BUILTIN" Headphone 100% unmute
    mix "$ADAPTER" Speaker unmute
    unit enable wall-kiosk-loop.service wall-amp-trigger.service
}

apply_panel() {
    ln -sfn "$CONF_DIR/asound-panel-mode.conf" "$LINK"
    printf 'panel\n' > "$MODE_FILE"
    mix "$BUILTIN" 'Auto-Mute Mode' Disabled
    mix "$BUILTIN" Master 100% unmute
    mix "$BUILTIN" Speaker unmute
    # Muted so a trigger cable still plugged in cannot be driven, and so the
    # amplifier is not commanded while the panel plays its own speaker.
    mix "$BUILTIN" Headphone mute
    mix "$ADAPTER" Speaker mute
    # Disabled, not just stopped: this mode defines no kiosk_monitor, so an
    # enabled unit would restart-loop after every boot.
    unit disable wall-kiosk-loop.service wall-amp-trigger.service
}

case "${1:-}" in
  trigger|panel)
    [ "$(id -u)" -eq 0 ] || { echo "must be root" >&2; exit 1; }
    mkdir -p "$CONF_DIR"
    unit stop wall-amp-trigger.service wall-kiosk-loop.service wall-line-in.service
    # bluealsa-aplay IS A CLIENT OF `default` LIKE THE KIOSK, and consequence 1
    # above applies to it word for word: it resolves `default` when it opens a
    # stream, so a connected phone would keep playing into the OLD chain after a
    # mode switch -- into a loopback nothing forwards any more, or onto the panel
    # speaker while still driving the amplifier's detector. Consequence 2 bites
    # harder still: clear_ipc skips any segment with attachments, so an aplay
    # holding the old dmix would leave a stale segment behind for the next mode
    # to reuse, which is the failure that "looks convincingly like a signal".
    # Stopped here and started again below, on exactly the kiosk's reasoning.
    unit stop bluealsa-aplay.service
    restart_kiosk
    # Give the kiosk a moment to release its PCM before the segments go.
    sleep 2
    clear_ipc
    if [ "$1" = trigger ]; then apply_trigger; else apply_panel; fi
    alsactl store 2>/dev/null || note_failure "alsactl store"
    # Only start what the operator has left enabled. WALL_LINE_IN_ENABLED and
    # WALL_VOLUME_KEYS_ENABLED are expressed as the unit's enablement, so a mode
    # switch must not quietly re-enable something firstboot was told to leave
    # off. The trigger daemon is different: its unit always runs and it idles on
    # WALL_AMP_ENABLED, so that the kiosk's loopback -- which is part of the
    # audio path in this mode, not part of the trigger -- keeps forwarding.
    start_if_enabled wall-line-in.service
    # Enabled-only, like wall-line-in: a mode switch must not quietly turn
    # Bluetooth audio back on for a panel that was configured without it.
    start_if_enabled bluealsa-aplay.service
    if [ "$1" = trigger ]; then
        unit start wall-kiosk-loop.service
        start_if_enabled wall-amp-trigger.service
    fi
    if [ "$FAILED" -ne 0 ]; then
        echo "mode: $1 (with $FAILED failure(s) above -- audio may be wrong)" >&2
        exit 1
    fi
    echo "mode: $1"
    ;;
  status|"")
    printf 'mode:   %s\n' "$(cat "$MODE_FILE" 2>/dev/null || echo trigger)"
    printf 'chain:  %s\n' "$(readlink -f "$LINK" 2>/dev/null || echo MISSING)"
    for u in wall-line-in wall-kiosk-loop wall-amp-trigger bluealsa bluealsa-aplay; do
        printf '%-18s %-10s %s\n' "$u:" \
            "$(systemctl is-active "$u.service" 2>/dev/null)" \
            "$(systemctl is-enabled "$u.service" 2>/dev/null)"
    done
    ;;
  *) usage ;;
esac
