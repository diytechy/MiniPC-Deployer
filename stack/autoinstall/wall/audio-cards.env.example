# /etc/wall-panel/audio-cards.env — GENERATED by wall-firstboot.sh.
#
# The same card map as audio-cards.conf, in a form shell and Python can read.
# ALSA reads the .conf; wall-audio-mode, panel-amp-trigger.py and
# panel-volume-keys.py read this. The two must agree.
WALL_AUDIO_ADAPTER_CARD=ICUSBAUDIO7D
WALL_AUDIO_BUILTIN_CARD=PCH
WALL_AUDIO_LOOPBACK_CARD=Loopback
