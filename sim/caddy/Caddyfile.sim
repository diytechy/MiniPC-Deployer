# Caddyfile.sim — SIM variant of stack/caddy/Caddyfile (WI-10.14).
#
# Structurally the real Caddyfile's auth model: tracker -> oauth2-proxy; the
# admin portal (*.admin.<domain>) -> ONE admin login via admin-auth, the same
# (protect_admin) snippet, sign-in route and HSTS as the real file; the old
# actual./dns. names -> redirects into the admin namespace. Only what the sim
# genuinely cannot reproduce differs, and each is a documented REAL↔SIM delta:
#
#   1. TLS: `local_certs` (Caddy's internal CA) instead of public ACME — a local
#      box cannot ACME a real public domain. vhost/auth structure is unchanged.
#   2. dns.admin proxies to `technitium:5380` (a bridge service name here) rather
#      than the admin bridge gateway — in the sim Technitium is a bridge
#      container, not host-networked.
#   3. The admin login's credential is a committed fixture (a fictional bcrypt of
#      "simpass" for `simadmin`, sim/admin-auth/htpasswd.sim) — see the overlay.
#   4. the wall kiosk site is NOT host-published (the real stack binds it to
#      LAN_IP, which is fictional here and unbindable on the WSL host). The gate's
#      probes reach it over the compose network instead — see the site's banner.
#   5. NO @lan remote_ip gates and NO throttle. The sim has never carried the
#      LAN gates (LAN_CIDR is not a sim knob; every probe comes from the compose
#      bridge), and the throttle needs the rate_limit ordering this file does
#      not declare. Both are proven by HomeHub's admin-portal harness instead.
#      Only admin., actual.admin. and dns.admin. are reproduced: Kuma and Dozzle
#      are disabled in the sim, and Homepage's profile is off (admin. therefore
#      answers 502 after sign-in, as the real one does with the profile off).

{
    # Internal CA — self-signed roots minted locally; no ACME, no public domain.
    local_certs
}

# ── the admin gate — IDENTICAL to the real Caddyfile's snippet ────────────────
(protect_admin) {
    forward_auth admin-auth:4180 {
        uri /oauth2/auth
        @unauth status 401
        handle_response @unauth {
            redir * https://{$ADMIN_HOST}/oauth2/sign_in?rd=https://{hostport}{%uri}
        }
    }
}
(hsts) {
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# ── tracker.<domain> — NagLight via oauth2-proxy (no admin login) — IDENTICAL ─
{$TRACKER_HOST} {
    encode zstd gzip
    reverse_proxy oauth2-proxy:4180 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}

# ── {$WALL_HOST}:{$WALL_PORT} — office-wall kiosk site — IDENTICAL structure ───
# The security-critical site (SR-016). Byte-for-byte the same handler shape as the
# real Caddyfile: the /32 remote_ip matcher, strip-then-inject on /api/*, the
# static shell root, and the 403 default. Read the real file's banner for WHY.
#
# The ONLY sim deltas, both unavoidable and neither touching the security model:
#   - PANEL_IP is the simclient's STATIC address on the sim-only `simlan` network
#     (sim/docker-compose.sim.yml), because a /32 allow-list needs an address that
#     is known before Caddy loads its config. The gate then reaches this site
#     twice: over `simlan` (source == PANEL_IP -> the panel) and over the default
#     network (source != PANEL_IP -> must 403). That is how the off-panel leg is
#     exercised without a second box.
#   - the document root is a fictional stand-in for the OfficeWallNaglight build
#     (../sim/wall-shell), since IF-005's artifact contract does not exist yet.
{$WALL_HOST}:{$WALL_PORT} {
    encode zstd gzip

    @panel remote_ip {$PANEL_IP}/32

    handle @panel {
        handle /api/* {
            reverse_proxy tracker:8787 {
                # No `-X-Forwarded-User` delete — Caddy applies deletes AFTER
                # sets, so it would erase the injection (the real Caddyfile
                # carries the full explanation; this leg is what caught it).
                header_up -X-Forwarded-Email
                header_up X-Forwarded-User {$PANEL_USER_SUB}
            }
        }
        handle {
            root * /srv/wall-shell
            file_server
        }
    }

    handle {
        respond "wall: panel only" 403
    }
}

# ── admin.<domain> — the sign-in host (Homepage behind it; profile off here) ─
admin.{$DOMAIN} {
    import hsts
    handle /oauth2/* {
        @plainrd expression `{http.request.uri.query.rd}.startsWith("http:")`
        respond @plainrd "sign-in: https only" 400
        reverse_proxy admin-auth:4180 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
    handle {
        import protect_admin
        reverse_proxy homepage:3000
    }
}

# ── actual.admin.<domain> — Actual behind the admin login — IDENTICAL shape ───
actual.admin.{$DOMAIN} {
    import hsts
    import protect_admin
    reverse_proxy actual:5006
}

# ── dns.admin.<domain> — Technitium console behind the admin login ───────────
# DELTA: sim Technitium is a bridge container -> proxy to `technitium:5380`
# (the real Caddyfile uses {$ADMIN_NET_GATEWAY}:5380 for the host-net container).
dns.admin.{$DOMAIN} {
    import hsts
    import protect_admin
    reverse_proxy technitium:5380
}

# ── the old names — one-release redirects into the admin namespace ────────────
{$ACTUAL_HOST} {
    redir https://actual.admin.{$DOMAIN}{uri}
}
dns.{$DOMAIN} {
    redir https://dns.admin.{$DOMAIN}{uri}
}

# ── apex — bare domain answers on-LAN too — IDENTICAL ─────────────────────────
{$DOMAIN} {
    respond "AWOW always-on core (SIM). Try https://{$TRACKER_HOST}" 200
}
