# Weekly cumulative metrics archive, directly on the backup drive (Owner,
# 2026-11-06). Outside the Library and FileBackup store; never pruned here.
# The script requires a real mount, validates its device and checks the
# opened root against that device before writing. A missing disk skips the run.
[Unit]
Description=HomeHub metrics log: weekly archive directly on the backup drive
Documentation=file:///opt/homehub/stack/monitoring/README.md
After=local-fs.target homehub-backup.service homehub-library-backup.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/homehub/stack/monitoring/homehub-metrics.py copy
SyslogIdentifier=homehub-metrics
# Its status file (copy-status.json) sits beside the log it copies.
StateDirectory=homehub-metrics
StateDirectoryMode=0700
# Same read access as the backup drive: root writes, backup group reads.
Group=filebackup
UMask=0027
TimeoutStartSec=1800
Nice=15
IOSchedulingClass=idle
CPUAccounting=true
CPUQuota=25%
MemoryAccounting=true
MemoryMax=128M
TasksMax=16
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
