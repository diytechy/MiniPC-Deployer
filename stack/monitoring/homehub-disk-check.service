# homehub-disk-check - free space on the configured NVMe filesystems (SN-048,
# SR-087); alerts once per crossing and once on recovery. Never statfs's a
# filesystem that is not on the NVMe, so the parked USB drives stay asleep.
[Unit]
Description=HomeHub low-disk alarm (NVMe filesystems only)
Documentation=file:///opt/homehub/stack/monitoring/README.md
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/homehub/stack/monitoring/homehub-disk-check.py
SyslogIdentifier=homehub-disk-check
StateDirectory=homehub-monitor
StateDirectoryMode=0700
UMask=0077
# Bounded like the panel's recorder: a monitor must never be the reason the hub
# is slow, and a run stuck behind a stalled read cannot pile up behind its timer.
TimeoutStartSec=60
Nice=10
CPUAccounting=true
CPUQuota=20%
MemoryAccounting=true
MemoryMax=64M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
