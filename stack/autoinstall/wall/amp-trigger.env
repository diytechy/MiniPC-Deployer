# Tunables for wall-amp-trigger.service. Defaults are the measured values; a key
# left out, unparseable, non-finite or out of range falls back or is clamped,
# with a log line, rather than failing to start -- a nan hold-off would
# otherwise leave the amplifier on forever, and a nan attack would leave it off
# forever, both silently.
#
# firstboot installs this file ONCE and never overwrites it, so tuning survives
# a re-run. The on/off knob is in wall.env (WALL_AMP_TRIGGER_ENABLED) and is
# rendered into WALL_AMP_ENABLED below.

# false makes the daemon idle without opening or emitting anything. Set from
# wall.env; changing it here works too, then restart wall-amp-trigger.
WALL_AMP_ENABLED=true
#
# Thresholds are dBFS on the DC-stripped RMS of the louder channel, stated
# relative to each source's nominal full scale. The measured noise floor is
# -83 dBFS, so the default -60 sits 23 dB clear of it.
#WALL_AMP_ON_DBFS=-60
#WALL_AMP_OFF_DBFS=-68

# Sustained audio required before the relay closes -- a click must not cycle it.
#WALL_AMP_ATTACK_SECONDS=0.3

# Idle before the amplifier powers down. Minutes, not seconds: gaps between
# tracks and quiet passages all dip below any usable threshold.
#WALL_AMP_HOLD_OFF_SECONDS=240

# Contact and amplifier protection, independent of what the audio does.
#WALL_AMP_MIN_ON_SECONDS=30
#WALL_AMP_MIN_OFF_SECONDS=10

# Trigger tone frequency. Higher leaves less ripple on the smoothing cap; the
# 2.6 V bridged figure was measured at 440 Hz and a headphone amplifier is flat
# across this range, but confirm if you change it.
#WALL_AMP_TONE_HZ=1000
