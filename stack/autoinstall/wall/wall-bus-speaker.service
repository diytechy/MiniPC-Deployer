# wall-bus-speaker.service — the switch on Speaker: bus to the detector's tap.
#
# HALF OF THE SPEAKER LEG. This forwards the merged bus into speaker_tap_mix;
# wall-speaker-out.service forwards the other end of that tap to the adapter.
# The amplifier detector reads the tap in between.
#
# WHY TWO UNITS AND NOT ONE. The detector has to watch the speaker bus AFTER the
# switch (review finding 2): watching the sources, as it does today, holds the
# amplifier on while the room is muted or the audio is in a headset. ALSA has no
# way to observe a playback stream in flight, so the tap is a second snd-aloop
# substream -- the same pattern the kiosk loopback has used since 2026-09-12,
# for the same reason, and Owner ruling 9 says keep it.
#
# It also means the detector sees the signal BEFORE the volume control, which is
# deliberate: a listener who turns the music down must not have the amplifier
# switch itself off underneath them.
#
# NOT ENABLED. wall-audio-output starts and stops this unit from the stored
# switch position; enabling it would let a boot start audio in a position the
# Owner did not leave it in.

[Unit]
Description=Wall panel: merged bus to the speaker tap (switch position Speaker)
Documentation=file:///opt/wall-panel/docs/design/audio-routing-2026-09-13.md
After=sound.target
Wants=sound.target
StartLimitIntervalSec=60
StartLimitBurst=10
BindsTo=dev-wall_audio_adapter.device
After=dev-wall_audio_adapter.device
# NO BOOT-MINUTE ORDERING HERE, AND NONE ON THE OTHER HALF EITHER. The first
# answer to the 2026-09-14 underruns was `After=wall-firstboot.service` on both
# halves; review found it a first-boot DEADLOCK -- firstboot starts these units
# synchronously, through wall-audio-mode and wall-audio-state, so ordering them
# after firstboot parks the start job behind the job that is waiting for it. The
# fix now lives in wall-speaker-out.service as a larger alsaloop ring, and the
# whole argument is written out there. This half keeps its 30 ms: the measured
# underruns were on speaker_out, not on the tap.

[Service]
Type=simple
ExecCondition=/bin/sh -c '[ "$(cat /etc/wall-panel/audio-mode 2>/dev/null || echo trigger)" = bus ]'
ExecStart=/usr/local/lib/wall-panel/wall-alsaloop-guard.py \
    --max-errors 20 --window 10 -- \
    /usr/bin/alsaloop \
    --cdevice bus_monitor \
    --pdevice speaker_tap_mix \
    --format S16_LE --rate 48000 --channels 2 \
    --tlatency 30000 --sync 5
Restart=always
RestartSec=2
Nice=-5
CPUSchedulingPolicy=rr
CPUSchedulingPriority=15
LimitRTPRIO=15
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
SupplementaryGroups=audio
StandardOutput=journal
StandardError=journal
