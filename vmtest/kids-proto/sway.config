# Prototype kids-kiosk sway session: one app, fullscreen, on the touch output;
# every other output mirrors it through wl-mirror (kids-outputs.sh).
xwayland disable
default_border none
default_floating_border none
focus_follows_mouse no
focus_on_window_activation none
seat * hide_cursor 1000
output * bg #000000 solid_color

# The kiosk app always lives on workspace "kiosk"; mirrors each get their own.
for_window [app_id="^ottertube"] fullscreen enable, move container to workspace kiosk
for_window [app_id="^at.yrlf.wl_mirror$"] fullscreen enable, inhibit_idle visible

exec /proto/kids-outputs.sh
exec /proto/kids-app-loop.sh
