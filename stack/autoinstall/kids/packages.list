# stack/autoinstall/kids/packages.list — every package the KIDS KIOSK installs.
#
# The hub's ../packages.list carries the full argument for why this list lives
# in a file instead of in the user-data's `packages:` (which runs before any
# late-command and so can only ever reach for the archive).
#
# Read by, and never retyped in:
#   vmtest/export-apt.sh --target kids     bakes the closure into an apt repo
#   kids/user-data late-command 3c         installs FROM that repo
#   kids/user-data late-command 7          asserts each name is installed
#   vmtest/test-kids-session.sh            installs exactly this list in a
#                                          container, runs ldd on OtterTube and
#                                          drives the session there
#
# FORMAT: one package per line, `#` comments to end of line, blank lines ignored.
#
# REBUILD THE BAKED REPO WHEN YOU CHANGE THIS FILE:
#   bash vmtest/export-apt.sh --target kids --out vmtest/.out-kids/apt

# ── the session ───────────────────────────────────────────────────────────────
sway                   # the compositor: maps touch to one output, workspaces per output
wl-mirror              # draws the touch output on every other output (the TV)
jq                     # kids-outputs.sh reads sway's IPC replies; firstboot writes JSON with it
dbus-user-session      # the session bus Electron and pipewire expect in the autologin session
libegl-mesa0           # wlroots' EGL; --no-install-recommends leaves mesa out
libgl1-mesa-dri        # the iris driver for the HD 500; without it sway renders in software
intel-media-va-driver  # VA-API for Apollo Lake (iHD), so hardware decode can be tried without a reimage
vainfo
fonts-dejavu-core
ca-certificates

# ── audio: OtterTube talks PulseAudio; pipewire serves it in the user session ─
pipewire
pipewire-pulse
wireplumber
alsa-ucm-conf          # per-card use-case configs; without them many codecs never route output
speech-dispatcher      # Chromium's Web Speech on Linux (OtterTube enables it)

# ── network ───────────────────────────────────────────────────────────────────
wpasupplicant          # networkd's 802.11 backend; without it there is no Wi-Fi at all
wireless-regdb         # kernel regulatory data; without it whole channels are invisible
iw                     # kids-firstboot.sh turns Wi-Fi power saving off
systemd-resolved       # /etc/resolv.conf; without it the kiosk resolves nothing

# ── base-installed siblings, pinned so --no-remove has nothing to remove ──────
# ../wall/packages.list: naming one systemd binary drags the family's version,
# and these were silently removed from the panel at install until listed.
udev
systemd-timesyncd
libnss-systemd
systemd-sysv
libpam-systemd
# The glib family, for the same reason (export-apt.sh's offline proof,
# 2026-11-01): baking libglib2.0-0t64 takes the noble-updates build, and the
# base's libglib2.0-bin and gir1.2-glib-2.0 are strict-versioned against it.
# Unnamed, apt resolves by REMOVING them, and with them networkd-dispatcher,
# apport, packagekit and the ubuntu-server metapackage.
libglib2.0-bin
gir1.2-glib-2.0

# ── remote management ─────────────────────────────────────────────────────────
openssh-server
unattended-upgrades

# ── OtterTube's Electron runtime (DT_NEEDED of ottertube-desktop) ─────────────
libasound2t64
libatk1.0-0t64
libatk-bridge2.0-0t64
libatspi2.0-0t64
libcairo2
libcups2t64
libdbus-1-3
libexpat1
libgbm1
libglib2.0-0t64
libgtk-3-0t64
libnspr4
libnss3
libpango-1.0-0
libudev1
libx11-6
libxcb1
libxcomposite1
libxdamage1
libxext6
libxfixes3
libxkbcommon0
libxrandr2
