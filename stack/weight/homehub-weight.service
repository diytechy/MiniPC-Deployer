[Unit]
# The hub's weight feeder (SR-022, SN-040). A plain service, no container —
# the same reasoning A40 applied to the AI CLI service and B7 applied to the
# usage feeder: the vendor half is an OAuth refresh token a human minted
# interactively through a browser, and a container would have to mount the
# directory it lives in.
#
# ONESHOT, DRIVEN BY A TIMER. There is nothing to keep alive between reads, and
# a long-lived process holding a health-data session open is a bigger surface
# than a process that exists for a second every fifteen minutes.
Description=HomeHub weight feeder (SR-022, posts the weight gauge to NagLight)
Documentation=file:///opt/homehub/stack/weight/README.md
After=network-online.target homehub-firstboot.service
Wants=network-online.target
ConditionPathExists=/opt/homehub/stack/.env

[Service]
Type=oneshot

# A DEDICATED UNPRIVILEGED ACCOUNT, and never `hub` (which carries (ALL)
# NOPASSWD: ALL) and never root. setup-weight.sh writes User=/Group= into a
# drop-in from WEIGHT_USER_ACCOUNT so the account certified is the account that
# runs — the cross-review V2 lesson, which found a unit hard-coding one name
# while every check validated another.
User=homehub-weight
Group=homehub-weight
NoNewPrivileges=yes

# READ-ONLY EVERYWHERE EXCEPT ONE FILE. `open_for_write` refuses any path but
# the state file; this is the second, independent line. ProtectHome=read-only
# is deliberate rather than `yes` — the feeder must still READ the refresh
# token, which normally lives under this account's home. A refresh token the
# Owner minted at a browser does not survive being truncated: it costs a person
# a trip back to a browser.
ProtectHome=read-only
StateDirectory=homehub-weight
StateDirectoryMode=0700
WorkingDirectory=/var/lib/homehub-weight

# ONE DEFINITIONS FILE IS MOUNTED READ-ONLY, NEVER THE DIRECTORY. The goal
# lives in the user's definitions (SN-040), which are the tracker's data - this
# feeder READS them and must never be able to write one. setup-weight.sh
# resolves WHICH file declares WEIGHT_ITEM_CATEGORY by reading frontmatter (the
# filename is NagLight's slug rule, not ours to guess) and writes ONE
# `BindReadOnlyPaths=-<that file>:/var/lib/homehub-weight/definitions/<name>`
# line into the drop-in, plus an EnvironmentFile= that points
# WEIGHT_DEFINITIONS_DIR at the mount target.
#
# WHY ONE FILE AND NOT THE DIRECTORY. The directory is one household member's
# subtree of a volume holding EVERY member's tracker data; a single-user gauge
# must not hand this account read access to all of it. It is also the only
# shape that WORKS: the definitions directory is 0700 hub:hub under root-only
# ancestors, so binding it at its own path leaves this account unable to
# traverse to it (measured on the hub, 2026-09-09).
#
# THE LEADING `-` IS LOAD-BEARING. Without it a source that has been renamed
# away fails the unit at 226/NAMESPACE before the feeder runs, every fifteen
# minutes, with no diagnosis; with it the mount is skipped and the feeder makes
# its own named "no goal" refusal instead.
#
# STALE INODES ARE NOT A CONCERN, and the oneshot shape is why. NagLight
# applies definitions by MkdirTemp + populate + rename-into-place, so the
# `definitions` directory is REPLACED wholesale on each sync. A long-lived
# process would be holding the retired inode; this unit's namespace is torn
# down and rebuilt on every timer tick, so each run resolves the path afresh.

EnvironmentFile=/opt/homehub/stack/.env
# --check re-runs the identity and destination refusals as their own process,
# under this unit's User=, so a box configured to guess an identity or to post
# off-box fails BEFORE the real run.
ExecStartPre=/usr/bin/python3 /opt/homehub/stack/weight/weight_feeder.py --check
ExecStart=/usr/bin/python3 /opt/homehub/stack/weight/weight_feeder.py

# A feeder that takes longer than this has a wedged source, and a wedged source
# must become an "unavailable" gauge rather than a stuck unit.
TimeoutStartSec=120

ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# NO Restart=. A failed cycle must NOT be retried into a hot loop against a
# health API; the timer brings the next one round soon enough, and a source
# that failed has already posted its "unavailable" gauge.

[Install]
WantedBy=multi-user.target
