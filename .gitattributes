# Line-ending policy for the scaffolded repo. Without this, a Windows clone with
# core.autocrlf=true rewrites the sh-based git hook with CRLF, and its `#!/bin/sh`
# shebang then breaks (incl. under Git Bash) — the pilot hit exactly this.

# Sensible default; the more specific rules below win (last match applies).
* text=auto eol=lf

# The pre-commit hook is an extensionless sh script — LF required on every
# platform (a CRLF shebang breaks `#!/bin/sh`).
.githooks/pre-commit text eol=lf

# Shell + macOS double-clickable launchers are sh scripts — same LF requirement.
*.sh text eol=lf
*.command text eol=lf

# Native-Windows scripts: CRLF (LF can misparse batch labels / `goto`).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# sim/mini-serv-sim binary fixtures — never line-ending-normalise these (they are
# real zip jars / opaque blobs; CRLF rewriting would corrupt them).
*.jar binary
*.sav binary
*.mca binary
*.dat binary
*.lock binary

# The panel's 2026-09-15 drop-in, byte for byte (it is CRLF on the panel). Its
# sha256 is the identity firstboot retires it by (SR-112), so a line-ending
# rewrite here would make the fixture stop being the file the test is about.
tests/fixtures/wall-sync-frame.timer.d-10-cadence.conf -text

# The frozen IF-020 PCM frame fixture. Byte-identical in OfficeWallNaglight, so
# a line-ending rewrite here would be a silent, cross-repository contract change.
*.bin binary

# OtterTube's update channel (SR-125): the signature covers update.json's exact
# bytes. The folder is git-ignored; should a copy ever be tracked, it must
# never be line-ending-normalised.
stack/ottertube/updates/update*.json binary
stack/ottertube/updates/update*.json.sig binary
