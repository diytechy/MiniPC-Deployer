# Office wall panel — configuration (the panel's own knobs).
#
# Copy to /etc/wall-panel/wall.env (the autoinstall seeds it from this file) and
# fill in. NOTHING here is committed filled: only this .example is tracked
# (SN-007). The real file is root-only 0600 — it carries the Wi-Fi PSK.
#
# QUOTING RULE (same as stack/.env.example): this file is shell-sourced by
# wall-firstboot.sh and wall-sleep.sh, so any value containing a SPACE must be
# double-quoted (KEY="a b") or first boot dies at the source line.
#
# NOT here on purpose:
#   - PANEL_USER_SUB — the panel never learns its own NagLight identity. The
#     kiosk site INJECTS it (stack/caddy/Caddyfile); a value on the panel would
#     be a copy of a secret-ish fact for no reason.
#   - MEDIA_ROOT — that is the AWOW-side library root, and the panel has no
#     business knowing it. The panel knows only the SHARE it pulls from
#     (MEDIA_SHARE_UNC below) and its own cache (D-W8 rider / OWN-D5 / OI-15).
#   - the shell's own knobs (HEARTBEAT_URL, LOCAL_LIBRARY, SUBSONIC, …) — those
#     live in the shell's config.json, which is IF-005's remaining contract.
#     See ./README.md "What IF-005 still owes".

# ── The kiosk site the shell loads ──────────────────────────────────────────
# Must match WALL_HOST / WALL_PORT in the AWOW's stack/.env — this is the origin
# that serves the shell AND proxies /api/* to the tracker (same-origin: NagLight
# sends no CORS headers). Reachable ONLY on the LAN, by design.
WALL_HOST=wall.example.tld
WALL_PORT=8443

# ── Wi-Fi (quirk 5) — the panel has no RJ45 ─────────────────────────────────
# The PSK is the one genuinely secret value on the panel. Give the panel a DHCP
# RESERVATION on its HARDWARE MAC: the kiosk site's /32 allow-list depends on the
# address never moving, and MAC randomization is pinned off for the same reason.
WIFI_SSID=REPLACE_WITH_WIFI_SSID
WIFI_PSK=REPLACE_WITH_WIFI_PSK

# ── Sleep window (D-W4) ─────────────────────────────────────────────────────
# suspend  = S3 "deep" (L2). ~0.5-1.5 W, and — the better argument — near-zero
#            heat and no fan noise for the window. NO LAN presence at all while
#            asleep: no SSH, no fixing it, until the RTC alarm fires.
# backlight = L1 fallback. Machine stays fully up and SSH-able, backlight off,
#            ~7-10 W. Use this if resume ever proves unreliable on this
#            firmware — that is the classic 2016-consumer-hardware failure and
#            the reason the knob exists at all.
SLEEP_MODE=suspend
# Window boundaries, box-local 24h HH:MM. Both modes share this one schedule.
SLEEP_START=22:00
SLEEP_END=06:30
# The wake is RTC-PRIMARY: wall-sleep.sh arms /sys/class/rtc/rtc0/wakealarm for
# SLEEP_END *before* suspending, so the morning wake never depends on anyone
# nudging the mouse. The USB mouse is the manual/early wake on top of that (and
# it is REQUIRED, not optional: the internal touchscreen is an I2C-HID device and
# will almost certainly NOT wake the machine from S3).
# Set false ONLY to test the USB-only path deliberately.
SLEEP_RTC_WAKE=true

# ── Media sync (OI-15, ruled by the Owner 2026-07-29) — THE PANEL PULLS ─────
# The media lives on a network share on the AWOW; the panel MIRRORS two subtrees
# of it into a local cache and the shell then serves /media/* panel-locally. Run
# by wall-sync.service once after boot, and on demand with:
#     sudo systemctl start wall-sync.service        # <- the dedicated command
#
# The share to pull FROM — a //host/share UNC, mounted READ-ONLY. Its ROOT must
# contain the two subtrees `Music/` and `FrameVideos/`; nothing else is copied
# (the sync mirrors those two and only those two). Which share and which library
# paths are correct is answered by the pathing SSOT
# (Personal\deploy\storage-map.md), not by guessing from this example.
MEDIA_SHARE_UNC=//REPLACE_WITH_LIBRARY_HOST/REPLACE_WITH_LIBRARY_SHARE
#
# Where the mirrored copy LIVES on the panel. Disposable by design: it is a
# CACHE, and reimaging the panel throws it away (the library is the only copy
# that matters). It must be an ABSOLUTE path — it is an `rsync --delete`
# destination. The Electron host maps /media/* onto this directory, so the
# shell's default manifest paths resolve to <cache>/music/index.json and
# <cache>/frame/playlist.json.
WALL_MEDIA_CACHE=/var/cache/wall-media
#
# MIRROR SEMANTICS — READ THIS ONCE: the sync is `rsync -a --delete`, so the
# panel cache is made to MATCH the share. Content REMOVED from the LAN source
# DISAPPEARS from the panel on the next sync. That is the ruling, and from the
# panel's side it is irreversible.
#
# MIRROR SAFETY (the backup service's ingest step learned this the hard way): if
# a subtree MOUNTS but turns out to hold no files — wrong share name, a source
# that came up without its data volume — mirroring it would ERASE a good cache,
# so the sync REFUSES and fails loudly instead. Set this to true only for a run
# where the library really is (or is meant to become) empty.
WALL_SYNC_ALLOW_EMPTY=false
#
# cifs credentials for the media share. Same convention as the backup service
# (stack/backup/backup.env.example): prefer a root-only credentials FILE with
# `username=`/`password=` lines over an inline password.
MEDIA_CIFS_CREDENTIALS=/etc/wall-panel/cifs.creds
# ...or inline (less safe — it then lives in this file AND in the mount options):
# MEDIA_CIFS_USER=REPLACE_WITH_SHARE_USER
# MEDIA_CIFS_PASS=REPLACE_WITH_SHARE_PASSWORD
MEDIA_CIFS_EXTRA=vers=3.0
#
# BENCH/TEST HOOK — leave commented on a real panel. Names a LOCAL directory to
# mirror from instead of mounting the share, which is how the mirror, the guards
# and the manifest generation are exercised on a machine with no Samba host. The
# sync announces loudly when it is set, so a run in the journal can never be
# mistaken for a real pull.
# MEDIA_SOURCE_OVERRIDE=/tmp/fake-library

# ── Optional music credentials — COMMENTED ON PURPOSE ───────────────────────
# Music plays from the panel's local synced copy (D-W8 rider), so Navidrome
# streaming and Pandora are BOTH optional. Un-comment a pair only when you
# actually enable that source — and note the consequence for the household secret
# tooling: an uncommented KEY here makes the emitter DEMAND its store key and
# refuse to emit until it exists (FieldSchema completeness rule).
# NAVIDROME_USER=REPLACE_WITH_NAVIDROME_USER
# NAVIDROME_PASSWORD=REPLACE_WITH_NAVIDROME_PASSWORD
# PANDORA_USER=REPLACE_WITH_PANDORA_USER
# PANDORA_PASSWORD=REPLACE_WITH_PANDORA_PASSWORD

# ── Kiosk app (IF-005 PLACEHOLDER — see ./README.md) ────────────────────────
# The command cage runs fullscreen. The real value depends on how the
# OfficeWallNaglight Electron app is packaged, which is exactly the part of
# IF-005 that is NOT decided yet. Until it is, this path is a placeholder and the
# kiosk session will log a loud, explicit "artifact missing" screen instead of
# silently showing a black wall.
WALL_APP_CMD=/opt/wall-panel/app/wall-shell

# ── Input quirk 3 — internal keyboard + touchpad face the mount ─────────────
# Folded flat, the keys press against the wall: one held key is an input storm.
# The fix is a udev rule, but it needs THIS MACHINE's device names, which no one
# can know from here (they are read off the running panel — see
# ./WALL-BURN-IN.md §3 for the exact one-liner that prints them).
# Leave EMPTY and the rule is NOT installed (firstboot says so loudly rather than
# guessing and disabling the touchscreen by accident).
# PIPE-separated exact udev NAMEs (pipes, because the names themselves contain
# spaces), e.g.  WALL_DISABLE_INPUT="AT Translated Set 2 keyboard|ELAN Touchpad"
# The touchscreen must NOT be listed — it is the panel's only input device.
WALL_DISABLE_INPUT=
