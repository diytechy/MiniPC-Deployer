def log(message):
    """One line to the journal. stderr, so systemd stamps the unit identity."""
    print(message, file=sys.stderr, flush=True)


def read_env(path, key, default):
    """One KEY=value out of a generated env file, or the default."""
    try:
        for line in Path(path).read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith(key + "="):
                value = line.split("=", 1)[1].strip().strip('"').strip("'")
                if value:
                    return value
    except OSError:
        pass
    return default


def current_mode():
    """trigger | panel | bus. A missing file means trigger, as it always has."""
    try:
        value = MODE_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return "trigger"
    return value if value in ("trigger", "panel", "bus") else "trigger"


def adapter_present(card, proc_asound=PROC_ASOUND):
    """Whether the configured 5.1 adapter card is enumerated now.

    The ALSA id is stable while its number and USB path are not. An absent
    adapter is an expected slow-boot/replug state; a present adapter whose
    mixer or legs fail remains an apply failure.
    Implements: SR-038, LLR-936
    """
    try:
        candidates = proc_asound.glob("card*/id")
    except OSError:
        return False
    for identifier in candidates:
        try:
            if identifier.read_text(encoding="utf-8").strip() == card:
                return True
        except OSError:
            continue
    return False


def headset_card(proc_asound=PROC_ASOUND):
    """The ALSA card id of the headset adapter, or None if it is not plugged in.

    Two files per card, both measured on the panel 2026-09-13:
    `/proc/asound/cardN/usbid` carries "0d8c:0014" for exactly this device, and
    `/proc/asound/cardN/id` carries the id ALSA knows it by. The id file is read
    rather than the sibling `/proc/asound/<id> -> cardN` symlink: both exist, but
    only one of them is a plain read that cannot be confused by a second card
    whose id differs only by a suffix.

    This is the only place the panel decides which card is the headset, and it is
    recomputed on every apply -- a re-enumeration can change the index and, on a
    panel with a second nameless adapter, even the id (Device, Device_1).
    """
    try:
        entries = sorted(Path(proc_asound).glob("card*/usbid"))
    except OSError:
        return None
    for usbid in entries:
        try:
            if usbid.read_text(encoding="utf-8").strip().lower() != HEADSET_USB_ID:
                continue
            card = (usbid.parent / "id").read_text(encoding="utf-8").strip()
        except OSError:
            continue
        # An id with a space or a slash in it would be unquotable in the
        # EnvironmentFile and unusable as an ALSA card name; refuse rather than
        # hand alsaloop something that will fail obscurely.
        if card and card == card.strip() and not set(card) & set(" \t\n\"'/"):
            return card
        log("headset adapter present but its card id %r is unusable" % card)
        return None
    return None


def headset_syspath(proc_asound=PROC_ASOUND, sys_class_sound=SYS_CLASS_SOUND):
    """The sysfs path of the headset card, for udevadm. None if it is not there.

    IT IS `cardN`, NOT THE ALSA ID, AND THE DIFFERENCE IS THE WHOLE FUNCTION.
    sysfs names the class entry by the card NUMBER (`/sys/class/sound/card1`);
    the ALSA id `headset_card` returns is the name the adapter enumerates under
    ("Device" for this nameless C-Media part) and has no sysfs entry of its own.
    Looking the id up under /sys/class/sound therefore never resolves, udevadm
    is never asked, and -- because every doubt resolves to "coldplug" -- no
    runtime plug would EVER auto-switch again. Caught by review, 2026-09-13.

    So the number is taken from the same scan that finds the card: the parent
    directory of the matching `/proc/asound/cardN/usbid` IS `cardN`.
    """
    try:
        entries = sorted(Path(proc_asound).glob("card*/usbid"))
    except OSError:
        return None
    for usbid in entries:
        try:
            if usbid.read_text(encoding="utf-8").strip().lower() != HEADSET_USB_ID:
                continue
        except OSError:
            continue
        path = Path(sys_class_sound) / usbid.parent.name
        return str(path) if path.exists() else None
    return None


def device_initialized_usec(syspath, run=subprocess.run):
    """When udev first finished processing this device, in CLOCK_MONOTONIC usec.

    `USEC_INITIALIZED` is set by udev the first time it processes a device and
    is never rewritten by a later `change`, so it answers exactly the question
    the ruling asks: did this adapter come into existence before or after the
    stored position was applied? It is the same clock `time.monotonic()` reads.

    None on any doubt at all -- no udevadm, no property, an unparseable value --
    and the caller treats None as "boot", which is the safe direction: the worst
    case is an Owner who has to move the switch by hand, never a panel that
    moves it for them.
    """
    if not syspath:
        return None
    try:
        done = run(["/usr/bin/udevadm", "info", "--query=property", "--path", syspath],
                   check=False, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    for line in (done.stdout or "").splitlines():
        key, _, value = line.partition("=")
        if key == "USEC_INITIALIZED":
            try:
                return int(value.strip())
            except ValueError:
                return None
    return None


def system_is_up(run=subprocess.run):
    """Has systemd finished booting? None when the question cannot be answered.

    `systemctl is-system-running` prints `initializing`/`starting` until
    `startup-finished`, then `running` (or `degraded`, which is still up). This
    is the gate that a SLOW BOOT CANNOT OUTRUN, and it is why the design does
    not lean on systemd-udev-settle: settle only drains the queue it can see, so
    an adapter behind a slow hub that enumerates a second after settle returned
    would look like a runtime plug and fire the one-shot against the ruling.
    While systemd still says `starting`, coldplug is still plausible and the
    Owner's stored position wins. A slow boot simply stays `starting` longer --
    there is no number here to be wrong about.
    """
    try:
        done = run(["/usr/bin/systemctl", "is-system-running"],
                   check=False, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    answer = (done.stdout or "").strip()
    if answer in ("running", "degraded", "maintenance", "stopping"):
        return True
    if answer in ("initializing", "starting"):
        return False
    return None


def read_boot_stamp(path=None):
    """The monotonic microsecond at which this boot's stored position was applied.

    The path defaults to BOOT_STAMP at CALL time, not at definition time, so the
    tests can point the pair at a temp file.
    """
    path = BOOT_STAMP if path is None else path
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    value = raw.get("monotonic_usec") if isinstance(raw, dict) else None
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        # A negative stamp would sit before every real initialization time and
        # turn every coldplug into a plug event -- the exact failure this file
        # exists to prevent. Refuse it; None is read as "coldplug".
        return None
    return value


def write_boot_stamp(path=None, dry_run=False, monotonic_usec=None):
    """Mark the moment the stored position became true. Called by apply-state.

    `monotonic_usec` IS SAMPLED BY THE CALLER, AT THE START OF THE APPLY, AND
    THE FILE IS WRITTEN AT THE END. Two review findings meet here. Writing the
    file early would classify a device that enumerated during the apply as a
    plug event before the stored position had been applied at all; sampling the
    clock late would classify a plug that arrived DURING the apply -- and whose
    presence unit is sitting on the flock waiting for us -- as coldplug, and
    swallow a real one. Sampling early and publishing late is right on both
    counts: the mark means "the world as this apply found it".

    A dry run still writes a stamp that is NOT the panel's own, on exactly
    save_state's reasoning: the hermetic suite drives the real applier through
    a boot and then a plug, and the difference between them is this file.
    """
    path = BOOT_STAMP if path is None else path
    if dry_run and Path(path) == LIVE_RUN_DIR / "audio-boot-apply.json":
        print("write %s (suppressed: --dry-run on the live boot stamp)" % path)
        return
    if monotonic_usec is None:
        monotonic_usec = int(time.monotonic() * 1_000_000)
    stamp = {"monotonic_usec": max(0, int(monotonic_usec))}
    write_atomic(path, json.dumps(stamp) + "\n", mode=0o644)


def read_epoch_marker(path=None):
    """This life of the backend, as (generation, request high-water mark).

    (None, -1) means /run carries no usable marker: either the panel has just
    booted (tmpfs is empty) or somebody removed it. That is NOT "carry on with
    whatever the state file says" -- see `_locked_apply`, which treats a missing
    marker as an epoch break and refuses every request that names a generation
    until `apply-state` re-establishes one.

    THE MARK IS IN THE MARKER, NOT ONLY IN THE STATE (terra, 2026-09-14,
    finding 1). Carrying only the generation left a hole: a state file rolled
    back to an OLD `request_seq` while the marker still named the CURRENT epoch
    meant a delayed request with the live generation and a sequence above the
    rolled-back mark was accepted and applied. The high-water mark has to be
    restored from the same authority the generation is, or the rollback quietly
    re-opens every request the applier had already refused.

    Inputs:  path: the marker file (a test seam); defaults to EPOCH_MARKER at
             CALL time, so the hermetic suite's WALL_PANEL_RUN_DIR is honoured.
    Outputs: (int generation or None, int mark >= -1)
    Implements: SR-028, LLR-014
    """
    path = EPOCH_MARKER if path is None else path
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, -1
    if not isinstance(raw, dict):
        return None, -1
    value = raw.get("generation")
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        # A malformed marker is worse than none: it would pin this life to a
        # number nothing agrees on. Read it as absent and let apply-state mint a
        # fresh epoch over it.
        return None, -1
    mark = raw.get("request_seq")
    if not isinstance(mark, int) or isinstance(mark, bool) or mark < -1:
        mark = -1
    return value, mark


def write_epoch_marker(generation, request_seq=-1, path=None, dry_run=False):
    """Publish the epoch this life of the backend is running as, and its mark.

    A dry run still writes a marker it was GIVEN (the same rule save_state and
    write_boot_stamp follow), because the hermetic suite drives the real applier
    across a simulated reboot and the presence or absence of this file is the
    whole difference between "same epoch" and "new epoch".
    """
    path = EPOCH_MARKER if path is None else path
    if dry_run and Path(path) == LIVE_RUN_DIR / "audio-epoch.json":
        print("write %s (suppressed: --dry-run on the live epoch marker)" % path)
        return
    write_atomic(path, json.dumps({"generation": int(generation),
                                   "request_seq": int(request_seq)}) + "\n",
                 mode=0o644)


def open_epoch(state, dry_run=False):
    """Decide this life's generation. Only `apply-state` may call this.

    A marker in /run means this life already has an epoch and it is kept. No
    marker means /run was cleared -- a boot -- so the epoch ADVANCES by one from
    the durable value in the state file, which is what makes it monotonic across
    reboots instead of restarting at zero and colliding with requests minted
    before the power cut.

    Inputs:  state: a normalized state dict (mutated in place, like the rest of
             the apply path)
    Outputs: (state, [journal lines])
    Implements: SR-028, LLR-014
    """
    existing, mark = read_epoch_marker()
    if existing is not None:
        lines = []
        if state["generation"] != existing:
            # The durable file and the marker disagree: a state file was rolled
            # back or replaced under a running panel. The MARKER wins, because
            # every request minted in this life was stamped from it, and the
            # state file is brought back up to it.
            lines.append("epoch %d restored from the run marker (state file said %d)"
                         % (existing, state["generation"]))
            state["generation"] = existing
        if mark > state["request_seq"]:
            lines.append("request mark %d restored from the run marker "
                         "(state file said %d)" % (mark, state["request_seq"]))
            state["request_seq"] = mark
        return state, lines
    generation = state["generation"] + 1
    if generation > 9007199254740991:
        # Unreachable in practice (one per boot), but a wrapped epoch would be a
        # silently accepted stale request, so it is refused loudly instead.
        raise policy.StateError("epoch exhausted")
    state["generation"] = generation
    write_epoch_marker(generation, state["request_seq"], dry_run=dry_run)
    return state, ["epoch %d opened (no run marker: this is a new backend life)"
                   % generation]


def is_boot_presence(initialized_usec, stamp=None, system_up=None):
    """Is this presence report coldplug (a fact) or a runtime plug (an event)?

    THE MECHANISM, AND WHY IT IS THIS ONE.

    Three were available. An `/proc/uptime` threshold is a guess with a number
    in it, and the number is wrong on exactly the boot that is slow enough to
    matter -- a USB bus that enumerates at t+12 s on a cold morning would fire
    the one-shot against the ruling. An explicit `--boot` flag set by the udev
    rule cannot be written honestly: udev rules cannot portably tell a coldplug
    event from a hot-plug one (`SYNTH_UUID` semantics differ by systemd
    version), and a flag baked into the rule would also be wrong for every
    runtime re-trigger. What is left is a comparison between marks on ONE
    monotonic clock, and this function is TWO gates over that clock, not one:

    GATE 1 -- HAS THE BOOT FINISHED AT ALL? While `systemctl is-system-running`
    still says `starting`, a device appearing is still plausibly coldplug, and
    the Owner's stored position wins. A slow boot stays `starting` for longer,
    all by itself; there is no number here to be wrong about. This gate exists
    because the first draft leaned on `systemd-udev-settle`, and review was
    right that settle only drains the queue it can SEE: an adapter behind a slow
    hub that enumerates one second after settle returned would have been read as
    a plug event and fired the one-shot against the ruling.

    GATE 2 -- DID THIS DEVICE PREDATE THE STORED POSITION? `USEC_INITIALIZED`
    is when udev first processed THIS device; the stamp is what `apply-state`
    sampled when it began applying the stored position. Earlier means it was
    there across the boot. This is what catches the reports that arrive long
    after the boot has finished -- a `udevadm trigger`, a manual `systemctl
    start`, the presence unit being re-run -- none of which is a plug.

    An unanswerable gate 1 (no systemctl) is BOOT. A boot that has finished with
    no stamp at all is a RUNTIME report: `/run` has been cleared or the state
    unit never ran, and a genuine plug must still work -- and `wall_audio_state`
    refuses to auto-switch for an adapter it already believed present, which is
    what stops that fallback from firing on a device that never went anywhere.
    """
    if system_up is None:
        system_up = system_is_up()
    if system_up is not True:
        return True
    if stamp is None:
        stamp = read_boot_stamp()
    if stamp is None:
        return False
    if initialized_usec is None:
        return True
    return initialized_usec <= stamp


@contextlib.contextmanager
def apply_lock(path=None, dry_run=False):
    """Serialize applies. Blocking, because every caller's work must still land.

    A rocker press that gave up because a udev event held the lock would be a
    volume change the Owner made and cannot see. The critical section is a
    handful of subprocess calls, so waiting is bounded in practice.
    """
    if dry_run:
        yield
        return
    if fcntl is None:
        # Only reachable off Linux, where there is no panel to serialize against.
        # The panel itself always has fcntl, so this is never the live path; it
        # is here so the applier can be imported and driven by the dev box tests.
        yield
        return
    path = Path(path or LOCK_FILE)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = os.open(path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield
    finally:
        os.close(handle)


class Applier:
    """Runs (or, with dry_run, prints) the privileged half of one apply."""

    def __init__(self, dry_run=False, run=subprocess.run):
        self.dry_run = dry_run
        self._run = run
        self.commands = []

    def command(self, argv, required=True, quiet=False, timeout=15):
        """Run one command; returns 0 on success, 1 on a failure that counts.

        `required` False means a failure is logged rather than counted -- a card
        that has just been unplugged has no controls to set, which is the normal
        headset case and not an error. `quiet` suppresses the log line for an
        attempt that is expected to fail and will be retried, so that a normal
        start does not put twenty identical lines in the journal.
        """
        self.commands.append(list(argv))
        if self.dry_run:
            print(" ".join(argv))
            return 0
        try:
            done = self._run(argv, check=False, capture_output=True, text=True,
                             timeout=timeout)
        except (OSError, subprocess.SubprocessError) as exc:
            if not quiet:
                log("FAILED: %s: %s" % (" ".join(argv), exc))
            return 1 if required else 0
        if done.returncode != 0:
            detail = (done.stderr or done.stdout or "").strip().splitlines()
            if not quiet:
                log("%s: %s: %s" % ("FAILED" if required else "note",
                                    " ".join(argv), detail[0] if detail else "no detail"))
            return 1 if required else 0
        return 0

    def capture(self, argv, timeout=15):
        """Run one command for its STDOUT. Returns the text, or None.

        Separate from `command` because a read is not a change: it is not
        recorded in `self.commands` as something that was done to the panel, and
        under `dry_run` it still runs, because a dry run that cannot read the
        hardware cannot tell the caller what it would have written. Every
        failure -- a missing binary, a timeout, a non-zero exit -- answers None,
        and every caller must treat None as "leave the hardware alone".
        """
        try:
            done = self._run(argv, check=False, capture_output=True, text=True,
                             timeout=timeout)
        except (OSError, subprocess.SubprocessError) as exc:
            log("could not read %s: %s" % (" ".join(argv), exc))
            return None
        if done.returncode != 0:
            return None
        return done.stdout


def write_atomic(path, text, mode=0o644, dry_run=False):
    """Replace a file in one rename, so no reader ever sees half a state.

    The state file is read by the amplifier detector and by the broker's status
    path while it is being written; a truncate-then-write would hand them an
    empty output field, which `normalize` would answer with `speaker` -- audio
    in the room at a moment nobody asked for it.
    """
    if dry_run:
        print("write %s" % path)
        return
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".new")
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def _muted_default():
    """The default state, with the microphone MUTED.

    What an unreadable or unparseable state file falls back to. `default_state()`
    is Speaker and UNMUTED, which is right for a panel that has never been
    configured and wrong for one whose state file we just failed to read: the
    applier PERSISTS what it loaded before it applies it, so an unreadable file
    was being rewritten as a valid, unmuted one and the units' own gate then saw
    consent that nobody gave (terra, round 4).
    """
    state = policy.default_state()
    state["input_muted"] = True
    return state


def load_state(path=STATE_FILE):
    """The stored state, normalized. A missing or unreadable file is the default.

    Returns (state, note) where note is a journal line when the file had to be
    replaced -- a state file that silently reverted to speaker at full level is
    exactly the kind of change the Owner must be able to find afterwards.
    """
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        # A panel that has never been configured. There is no prior mute to
        # lose, so this is the ONE fallback that stays unmuted; a fresh image
        # whose microphone needed a button press nobody has a button for yet
        # (the chrome is step 5) would be a worse failure than the one below.
        return policy.default_state(), "no state file yet; defaults applied"
    except (OSError, ValueError) as exc:
        # A file that EXISTS and cannot be read is different in kind: it may
        # have said `input_muted: true` a moment ago, and the applier PERSISTS
        # what it loaded before it applies it -- so returning the unmuted
        # default here rewrote an unreadable file into valid, unmuted consent
        # that nobody gave, and the units' own gate then saw it (terra, round 4).
        return _muted_default(), ("state file unusable (%s); defaults applied "
                                  "with the MICROPHONE MUTED" % exc)
    state = policy.normalize(raw)
    # What was ACTUALLY replaced, field by field: the loaded document against
    # the normalized one. The previous spelling compared the normalized state
    # with itself, which is equal by construction, so a partial or
    # malformed-but-parseable file was silently corrected -- exactly the
    # "reverted to speaker at full level with nothing in the journal" case this
    # note exists to prevent.
    replaced = sorted(key for key, value in state.items()
                      if not isinstance(raw, dict) or raw.get(key) != value)
    if replaced:
        return state, "state file repaired: %s" % ", ".join(replaced)
    return state, None


def save_state(state, path=STATE_FILE, dry_run=False):
    """Persist the state. A dry run still writes a state file it was GIVEN.

    --dry-run suppresses the privileged half -- systemctl, amixer, /run -- and
    nothing else, so that a test can drive a sequence of real requests through
    the real applier and read back what each one decided. Writing the PANEL's
    own state file from a dry run would defeat the word, so that one alone is
    refused, out loud.
    """
    if dry_run and Path(path) == STATE_FILE:
        print("write %s (suppressed: --dry-run on the live state file)" % path)
        return
    write_atomic(path, json.dumps(state, indent=2, sort_keys=True) + "\n", mode=0o644)


# How long to wait for the softvol control to appear after a leg starts, and
# how often to look. Sized from the forwarders' own start: alsaloop opens its
# PCMs immediately, so this is a fraction of a second in the normal case and the
# ceiling only matters on a panel that is already struggling.
BUS_CONTROL_ATTEMPTS = 20
BUS_CONTROL_INTERVAL_SECONDS = 0.1
# After this many fruitless attempts (0.5 s), open the leg's PCM ourselves once
# rather than keep waiting for someone else to. See set_bus_level.
BUS_CONTROL_PREOPEN_AFTER = 5
# The PCM that DECLARES the softvol for each position. Named here because the
# pre-open must open the plugin that creates the control, not the bus: `Bus`
# lives on speaker_out and headset_out in asound-bus-mode.conf, and opening
# `bus` would create nothing.
BUS_CONTROL_PCM = {"speaker": "speaker_out", "headset": "headset_out"}



def PRE_OPEN_ARGS(pcm):
    """The pre-open: open `pcm`, write ONE frame of digital silence, exit.

    It was `aplay -q -D <pcm> /dev/null`, which never opens the device at all:
    aplay reads a WAV header first and /dev/null has none ("read_header: read
    error", exit 1). Measured on the panel 2026-09-14 00:58 -- every probe and
    every softvol pre-open had been failing silently, which is why the Bus
    control "never appeared" on the first mode switch and why the 8-channel
    speaker chain always "would not open" while `aplay -D speaker_multi` of a
    real file played fine. Raw S16 stereo at the bus rate with `-s 1` writes a
    single zero frame: inaudible, and the chain is genuinely opened.
    """
    return ["/usr/bin/aplay", "-q", "-D", pcm, "-t", "raw", "-f", "S16_LE",
            "-r", "48000", "-c", "2", "-s", "1", "/dev/zero"]

def declare_bus_control(applier, pcm):
    """Open the leg's PCM once so softvol creates its control, before any audio.

    `aplay -D speaker_out` of one raw zero frame opens the plugin chain (see PRE_OPEN_ARGS)
    and exits; the control it declares stays on the Loopback card afterwards.
    Called BEFORE the forwarder starts, and that ordering is the point: review
    found that creating the control after the leg was already running left a
    window in which a freshly created softvol sat at its default -- full scale --
    with the forwarder feeding it. Nothing is audible during the pre-open
    itself, because there is no source and no frames.

    Never required, and given a short timeout of its own: this runs while the
    apply lock is held, so an ALSA open that wedges must not hold the switch.
    """
    return applier.command(PRE_OPEN_ARGS(pcm),
                           required=False, quiet=True, timeout=5) == 0


def set_bus_level(applier, card, level, expected=True, sleep=time.sleep, pcm=None):
    """Set the bus softvol, retrying until the control exists. True if it took.

    `expected` False means no leg is running (mute, or headset with no adapter),
    so the control legitimately does not exist and one attempt is enough.

    `pcm` IS THE FIX FOR THE 2026-09-13 INSTALL FAILURE. `wall-audio-mode bus`
    ran the first apply of the boot and logged `amixer sset Bus 60%` failing:
    softvol creates its control when a CLIENT OPENS the PCM that declares it,
    and on a panel that has just had its whole graph swapped there may be no
    client for longer than the retry window. Waiting harder would only make the
    window a bigger guess, so after BUS_CONTROL_PREOPEN_AFTER fruitless
    attempts the applier opens the PCM itself -- `aplay -D <pcm>` of one raw zero frame (PRE_OPEN_ARGS),
    which opens, writes no frames and exits, so the control exists afterwards
    and not one sample reaches the room. It is tried once, it is not required,
    and the retry loop stays bounded either way.
    Implements: SR-028, LLR-014
    """
    attempts = BUS_CONTROL_ATTEMPTS if expected else 1
    preopened = False
    for attempt in range(attempts):
        if pcm and expected and attempt == BUS_CONTROL_PREOPEN_AFTER and not preopened:
            preopened = True
            applier.command(PRE_OPEN_ARGS(pcm),
                            required=False, quiet=True)
        # required=True so that a missing control is REPORTED to this loop as a
        # failure; the caller decides what it means, and never counts it as a
        # failed apply -- the audio is playing either way, only the level is in
        # question.
        if applier.command(["/usr/bin/amixer", "-c", card, "-q", "sset",
                            BUS_CONTROL, "%d%%" % level],
                           quiet=attempt < attempts - 1) == 0:
            return True
        if attempt < attempts - 1:
            sleep(BUS_CONTROL_INTERVAL_SECONDS)
    return not expected


def load_trim(path=None):
    """The six trim coefficients, with a note for anything that had to be replaced.

    Field by field, exactly as `policy.normalize` treats the state file and for
    the same reason: a typo in one number must not throw the other five away and
    leave the room with no centre channel.

    Inputs:  path: the env file, or None for TRIM_ENV
    Outputs: (dict of TRIM_KEYS -> float, [journal lines])
    Implements: SR-028, LLR-014
    """
    path = TRIM_ENV if path is None else Path(path)
    values = dict(TRIM_DEFAULTS)
    notes = []
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return values, []
    except OSError as exc:
        return values, ["trim file unusable (%s); defaults applied" % exc]
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, _, raw = line.partition("=")
        name = name.strip()
        if not name.startswith(TRIM_ENV_PREFIX):
            continue
        key = name[len(TRIM_ENV_PREFIX):].lower()
        if key not in TRIM_DEFAULTS:
            notes.append("trim %s is not a channel this panel has: ignored" % key)
            continue
        ok, value = parse_trim_value(raw.strip().strip('"').strip("'"))
        if not ok:
            notes.append("trim %s=%r refused (%s); using %.3f"
                         % (key, raw.strip(), value, TRIM_DEFAULTS[key]))
            continue
        values[key] = value
    return values, notes


def parse_trim_value(raw):
    """(True, float) for an acceptable coefficient, (False, reason) otherwise."""
    try:
        value = float(raw)
    except (TypeError, ValueError):
        return False, "not a number"
    if value != value or value in (float("inf"), float("-inf")):
        return False, "not a finite number"
    if value < 0.0:
        # A negative coefficient is a phase inversion, which on a summed mono
        # feed to a centre and a sub is a cancellation, not a trim. If anyone
        # ever wants one it should be a deliberate new knob with its own name.
        return False, "negative: a phase inversion is not a trim"
    if value > TRIM_MAX:
        return False, ("above %.1f (%+.1f dB): that is a wiring problem, not a trim"
                       % (TRIM_MAX, TRIM_MAX_DB))
    return True, value


def render_trim_conf(values):
    """The ALSA `route` for the speaker leg, as text. Pure; the caller writes it.

    This is the ONLY definition of `pcm.speaker_multi`. asound-bus-mode.conf
    loads it through a hook with `errors false`, so a missing or unreadable file
    leaves the name undefined rather than taking the whole configuration -- and
    with it `default`, the bus and the headset leg -- down with it. The applier's
    probe then finds the multi chain unopenable and falls back to stereo.
    Implements: SR-028, LLR-014
    """
    lines = [
        "# /etc/wall-panel/audio-trim.conf — GENERATED by `wall-audio-output trim`.",
        "# Edit with that command, not by hand: this file is rewritten whole.",
        "# The 8-channel map is the adapter's and is fixed:",
        "#   0 FL  1 FR  2 FC  3 LFE  4 RL  5 RR  6 SL  7 SR",
        "pcm.speaker_multi {",
        "    type route",
        "    slave {",
        '        pcm "speaker_hw8"',
        "        channels 8",
        "    }",
    ]
    for key in TRIM_KEYS:
        source, destination = TRIM_TTABLE[key]
        lines.append("    ttable.%d.%d %.4f  # %s" % (source, destination,
                                                     values[key], key))
    # The cross terms the six knobs do not name: front stays stereo because L
    # does not reach FR and R does not reach FL.
    lines.append("    ttable.1.0 0.0000  # R does not reach FL: front stays stereo")
    lines.append("    ttable.0.1 0.0000  # L does not reach FR")
    for channel in TRIM_SILENT_CHANNELS:
        # Written out rather than left implicit: "silent on purpose" and
        # "forgotten" must not look the same in a generated file. Rear carries
        # the desktop's input, and the room's music must never reach it.
        lines.append("    ttable.0.%d 0.0000" % channel)
        lines.append("    ttable.1.%d 0.0000" % channel)
    lines.append("}")
    return "\n".join(lines) + "\n"


def render_trim_env(values):
    """The six coefficients, as the env file the next run reads back."""
    lines = ["# GENERATED by `wall-audio-output trim`. Must agree with audio-trim.conf."]
    for key in TRIM_KEYS:
        lines.append("%s%s=%.4f" % (TRIM_ENV_PREFIX, key.upper(), values[key]))
    return "\n".join(lines) + "\n"


def parse_trim_assignments(assignments, values):
    """Fold `key=value` arguments into a copy of `values`, or raise ValueError.

    NOTHING IS WRITTEN UNTIL EVERY ARGUMENT HAS PARSED. A tuning session that
    typed three changes and fat-fingered the fourth must not end up with the
    first three applied and no idea which: the command either moves the whole
    table or none of it.
    """
    wanted = dict(values)
    for assignment in assignments:
        name, separator, raw = assignment.partition("=")
        if not separator:
            raise ValueError("%r is not KEY=VALUE (keys: %s)"
                             % (assignment,
                                ", ".join(sorted(TRIM_GROUPS) + list(TRIM_KEYS))))
        key = name.strip().lower()
        ok, value = parse_trim_value(raw.strip())
        if not ok:
            raise ValueError("%s=%s refused: %s" % (key, raw.strip(), value))
        if key in TRIM_GROUPS:
            for member in TRIM_GROUPS[key]:
                wanted[member] = value
        elif key in TRIM_DEFAULTS:
            wanted[key] = value
        else:
            raise ValueError("%r is not a channel this panel has (keys: %s)"
                             % (key, ", ".join(sorted(TRIM_GROUPS) + list(TRIM_KEYS))))
    return wanted


def trim_command(arguments):
    """`wall-audio-output trim [--render] [KEY=VALUE ...]`. Returns an exit code.

    WHY THIS IS A SUBCOMMAND AND NOT A DOCUMENTED FILE EDIT. Owner ruling on
    finding 8: the level tuning is a dedicated session after everything else is
    in. That session happens standing at an amplifier, one number at a time, and
    it must not require anybody to remember that an ALSA ttable indexes
    destination channels in the hardware's fixed order -- nor to restart the
    right unit afterwards for the change to be heard.

    IT TAKES THE APPLY LOCK, AND THE FIRST DRAFT DID NOT. The trim is a property
    of the ROOM rather than of the switch position, so it looked orthogonal to
    everything `apply_lock` serializes. Review found the interleaving that makes
    it not: this command reads "the speaker leg is running", an apply for Mute or
    Headset then stops that leg, and the `restart` below starts it again --
    leaving the graph in a position the Owner did not choose, with a forwarder
    running against a stopped tap. The window is small and the fix is free, so
    the whole of read, render and restart happens under the same lock every
    other writer takes.

    And it asks the STORED POSITION as well as systemd. `is-active` alone is a
    fact about a moment; `output == "speaker"` is what the Owner chose. Only
    when both agree is a restart something the Owner would recognize.
    Implements: SR-028, LLR-014
    """
    values, notes = load_trim(arguments.trim_env)
    for line in notes:
        log(line)
    try:
        wanted = parse_trim_assignments(arguments.value or [], values)
    except ValueError as exc:
        log("refused: %s" % exc)
        return 1

    changed = [key for key in TRIM_KEYS if abs(wanted[key] - values[key]) > 1e-9]
    if not arguments.render and not arguments.value:
        # The bare command is a report, and it says where both files live so
        # that the next person does not have to find them.
        print(json.dumps({"trim": {key: round(wanted[key], 4) for key in TRIM_KEYS},
                          "env": str(arguments.trim_env),
                          "conf": str(arguments.trim_conf),
                          "chain": read_env(SPEAKER_CHAIN_ENV, SPEAKER_CHAIN_VAR,
                                            SPEAKER_CHAIN_MULTI)},
                         indent=2, sort_keys=True))
        return 0

    write_atomic(arguments.trim_env, render_trim_env(wanted), mode=0o644,
                 dry_run=arguments.dry_run)
    write_atomic(arguments.trim_conf, render_trim_conf(wanted), mode=0o644,
                 dry_run=arguments.dry_run)
    for key in changed:
        log("trim %s %.3f -> %.3f" % (key, values[key], wanted[key]))
    if not changed:
        log("trim unchanged; %s re-rendered" % arguments.trim_conf)

    # ALSA reads a plugin's configuration when the PCM is OPENED, so a running
    # leg keeps the table it started with. Restart it -- but only if it is
    # already running, because starting it here would put audio in the room from
    # a command that was only meant to move a number.
    applier = Applier(dry_run=arguments.dry_run)
    state, _ = load_state(arguments.state)
    selected = state["output"] == "speaker" and current_mode() == "bus"
    # `required=True` on the probe on purpose, so that a systemctl that is
    # missing or that errors counts as NOT RUNNING and nothing is restarted.
    # With required=False an exception would answer 0 -- "active" -- and the
    # command would start audio on a panel that had none, which is the one thing
    # a number-moving command must never do. `quiet` because "not active" is the
    # normal answer here, not a fault worth a journal line.
    running = applier.command(["/usr/bin/systemctl", "is-active", "--quiet",
                               SPEAKER_OUT_UNIT], quiet=True) == 0
    if running and selected:
        if applier.command(["/usr/bin/systemctl", "restart", SPEAKER_OUT_UNIT],
                           required=False) == 0:
            log("speaker leg restarted: the new trim table is open")
    else:
        log("speaker leg is not running on Speaker: the new trim table is opened "
            "next time the switch reaches Speaker")
    return 0


# -- the mic knobs, their generated route, and the hardware they touch -----

def load_mic(path=None):
    """The mic knobs, with a note for anything that had to be replaced.

    Field by field, exactly as `load_trim` and `policy.normalize` do it: one bad
    number must not throw the rest away and leave the panel with no microphone
    policy at all.

    Outputs: (dict of MIC_KEYS -> int|float, [journal lines])
    Implements: SR-029, LLR-016
    """
    path = MIC_ENV if path is None else Path(path)
    values = dict(MIC_DEFAULTS)
    notes = []
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return values, []
    except OSError as exc:
        return values, ["mic file unusable (%s); defaults applied" % exc]
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, _, raw = line.partition("=")
        key = name.strip()
        if not key.startswith(MIC_ENV_PREFIX):
            continue
        key = key[len(MIC_ENV_PREFIX):].lower()
        if key not in MIC_DEFAULTS:
            notes.append("mic %s is not a knob this panel has: ignored" % key)
            continue
        ok, value = parse_mic_value(key, raw.strip().strip(chr(34)).strip(chr(39)))
        if not ok:
            notes.append("mic %s=%r refused (%s); using %s"
                         % (key, raw.strip(), value, MIC_DEFAULTS[key]))
            continue
        values[key] = value
    return values, notes


def parse_mic_value(key, raw):
    """(True, value) for an acceptable knob, (False, reason) otherwise.

    Refused, never clamped, for the reason the trim gives: a number this far out
    is a typo, and a microphone level is not something to guess halfway at.
    """
    if key in MIC_INT_KEYS:
        try:
            value = int(str(raw).strip())
        except (TypeError, ValueError):
            return False, "not a whole number"
        low, high = MIC_LIMITS[key]
        if not low <= value <= high:
            return False, "outside %d..%d" % (low, high)
        return True, value
    try:
        value = float(raw)
    except (TypeError, ValueError):
        return False, "not a number"
    if value != value or value in (float("inf"), float("-inf")):
        return False, "not a finite number"
    if value < 0.0:
        return False, "negative: a phase inversion is not a gain"
    if value > MIC_GAIN_MAX:
        return False, "above %.1f: that is a wiring problem, not a gain" % MIC_GAIN_MAX
    return True, value


def render_mic_conf(values):
    """The ALSA `route` that puts the mono mic on the adapter's REAR pair.

    THIS IS THE ONLY THING KEEPING THE MICROPHONE OUT OF THE SPEAKERS, and that
    is why every channel it does not own is written out as an explicit zero
    rather than left implicit. The adapter has ONE mute switch for all eight
    channels (numid 7 is a single boolean, measured 2026-09-14), so hardware
    cannot make this guarantee while the mic leg is running; `speaker_multi`'s
    matching zeros on channels 4-7 are the other half of the same bargain,
    keeping the room's music out of the desktop's input.

    Loaded by asound-bus-mode.conf through a hook with `errors false`: a missing
    file leaves `mic_rear_route` undefined and the rear leg simply does not run,
    rather than taking the whole configuration -- and with it `default`, the bus
    and both output legs -- down with it.
    Implements: SR-029, LLR-016
    """
    gain = values["rear_gain"]
    lines = [
        "# /etc/wall-panel/audio-mic.conf - GENERATED by `wall-audio-output mic`.",
        "# Edit with that command, not by hand: this file is rewritten whole.",
        "# The 8-channel map is the adapter's and is fixed:",
        "#   0 FL  1 FR  2 FC  3 LFE  4 RL  5 RR  6 SL  7 SR",
        "# Source channel 0 is the ONLY source: mic_selected is mono.",
        "pcm.mic_rear_route {",
        "    type route",
        "    slave {",
        '        pcm "usb_out_mix"',
        "        channels 8",
        "    }",
    ]
    for channel in MIC_REAR_CHANNELS:
        lines.append("    ttable.0.%d %.4f  # the microphone, to the desktop's input"
                     % (channel, gain))
    for channel in MIC_SILENT_CHANNELS:
        lines.append("    ttable.0.%d 0.0000  # the mic must never reach this channel"
                     % channel)
    lines.append("}")
    return "\n".join(lines) + "\n"


def render_mic_env(values):
    """The knobs, as the env file the next run reads back."""
    lines = ["# GENERATED by `wall-audio-output mic`. Must agree with audio-mic.conf."]
    for key in MIC_KEYS:
        value = values[key]
        lines.append("%s%s=%s" % (MIC_ENV_PREFIX, key.upper(),
                                  value if key in MIC_INT_KEYS else "%.4f" % value))
    return "\n".join(lines) + "\n"


def parse_mic_assignments(assignments, values):
    """Fold `key=value` arguments into a copy of `values`, or raise ValueError.

    NOTHING IS WRITTEN UNTIL EVERY ARGUMENT HAS PARSED -- the trim command's
    rule, and for the same reason: a bench session that typed three changes and
    fat-fingered the fourth must not be left with the first three applied.
    """
    wanted = dict(values)
    for assignment in assignments:
        name, separator, raw = assignment.partition("=")
        if not separator:
            raise ValueError("%r refused: not KEY=VALUE (keys: %s)"
                             % (assignment, ", ".join(MIC_KEYS)))
        key = name.strip().lower()
        if key not in MIC_DEFAULTS:
            # "refused" in EVERY refusal message, whatever the reason. An
            # operator scanning a bench session's output for the word should not
            # have to know that an unknown knob is worded differently from an
            # out-of-range one.
            raise ValueError("%r refused: not a knob this panel has (keys: %s)"
                             % (key, ", ".join(MIC_KEYS)))
        ok, value = parse_mic_value(key, raw.strip())
        if not ok:
            raise ValueError("%s=%s refused: %s" % (key, raw.strip(), value))
        wanted[key] = value
    return wanted


def parse_adapter_levels(text):
    """The eight values of `Speaker Playback Volume` out of `amixer cget`, or None.

    amixer prints them on a line of their own, `  : values=66,66,24,...`.
    Anything that is not exactly eight integers answers None, and the caller
    then leaves the hardware alone: a rear level is worth having, and it is not
    worth writing a guess into a control whose other six values are the Owner's
    bench work.
    """
    for line in (text or "").splitlines():
        line = line.strip()
        if not line.startswith(":") or "values=" not in line:
            continue
        raw = line.split("values=", 1)[1].strip()
        parts = raw.split(",")
        if len(parts) != 8:
            return None
        try:
            return [int(part.strip()) for part in parts]
        except ValueError:
            return None
    return None


def rear_levels(current, level):
    """The eight values with ONLY channels 4 and 5 moved to `level`.

    The other six are the Owner's bench session (66,66,24,24,*,*,24,24 measured
    2026-09-14) and this function is the promise that they are not touched.
    """
    wanted = list(current)
    for channel in MIC_REAR_CHANNELS:
        wanted[channel] = level
    return wanted


def set_rear_level(applier, adapter, level):
    """Read the adapter's eight playback values, move the rear pair, write back.

    Read-modify-write rather than a blind `cset` of all eight, because six of
    those numbers were arrived at by somebody standing at an amplifier and this
    command has no business having an opinion about them. A read that does not
    answer eight integers moves NOTHING and says so.
    """
    captured = applier.capture(["/usr/bin/amixer", "-c", adapter, "cget",
                                "numid=%d" % ADAPTER_SPEAKER_NUMID])
    current = parse_adapter_levels(captured)
    if current is None:
        log("the adapter's 8 playback levels could not be read: the mic return's "
            "rear level is left as it is (check `amixer -c %s cget numid=%d`)"
            % (adapter, ADAPTER_SPEAKER_NUMID))
        return False
    wanted = rear_levels(current, level)
    if wanted == current:
        return True
    # IT REPORTED SUCCESS WHETHER OR NOT THE WRITE LANDED (terra, round 2). The
    # direction decides, exactly as it does for the mute: failing to RAISE the
    # rear pair is a quiet mic return, while failing to LOWER it leaves the
    # desktop's input wired to live channels after the leg has gone -- which is
    # the independent hardware barrier this function exists to be.
    lowering = level < max(current[channel] for channel in MIC_REAR_CHANNELS)
    return applier.command(["/usr/bin/amixer", "-c", adapter, "-q", "cset",
                            "numid=%d" % ADAPTER_SPEAKER_NUMID,
                            ",".join(str(value) for value in wanted)],
                           required=lowering) == 0


def mic_command(arguments, dry_run=False):
    """`wall-audio-output mic [--render] [KEY=VALUE ...]`. Returns an exit code.

    Like `trim`, and deliberately so. It NEVER starts a leg that is stopped -- a
    command that only moves a number must not put a live microphone anywhere --
    and it restarts the rear leg if it is ALREADY running, because ALSA reads a
    plugin's configuration when the PCM is opened.
    Implements: SR-029, LLR-016
    """
    values, notes = load_mic()
    for note in notes:
        log(note)
    assignments = [argument for argument in arguments if argument != "--render"]
    render_only = "--render" in arguments
    if assignments:
        try:
            values = parse_mic_assignments(assignments, values)
        except ValueError as exc:
            log("mic: %s (nothing changed)" % exc)
            return 2
    applier = Applier(dry_run=dry_run)
    if assignments or render_only:
        write_atomic(MIC_ENV, render_mic_env(values), mode=0o644, dry_run=dry_run)
        write_atomic(MIC_CONF, render_mic_conf(values), mode=0o644, dry_run=dry_run)
    if assignments:
        # Only if it is ALREADY running. A missing or erroring systemctl counts
        # as not running, for the same reason the trim command counts it that
        # way: the safe answer to "is a microphone live" is no.
        if applier.command(["/usr/bin/systemctl", "is-active", "--quiet",
                            MIC_REAR_UNIT], quiet=True) == 0:
            applier.command(["/usr/bin/systemctl", "restart", MIC_REAR_UNIT],
                            required=False)
        log("mic: " + ", ".join("%s=%s" % (key, values[key]) for key in MIC_KEYS))
        return 0
    if not render_only:
        for key in MIC_KEYS:
            print("%-24s %s" % (key, values[key]))
        print("%-24s %s" % ("env", MIC_ENV))
        print("%-24s %s" % ("alsa", MIC_CONF))
    return 0


def select_mic_source(applier, source):
    """Publish which capture PCM the mic legs open. True if it CHANGED.

    THE RETURN VALUE IS LOAD-BEARING. ALSA resolves `@func getenv` when the PCM
    is OPENED, so a forwarder that is already running holds the microphone it
    started with for as long as it lives -- and `systemctl start` on an active
    unit does nothing at all. Moving the switch from Speaker to Headset would
    then leave the headset's far end listening to the PANEL's microphone, which
    is the worst kind of bug this leg can have: everything looks right, audio
    flows, and it is the wrong room. A changed source therefore RESTARTS the
    legs rather than starting them.

    The environment half is not redundant, for exactly the reason
    `select_speaker_chain` spells out: `@func getenv` reads the environment of
    the process that OPENS the PCM, and this applier's own probe of `mic_rear`
    is its own child.
    """
    previous = read_env(MIC_SOURCE_ENV, MIC_SOURCE_VAR, None)
    write_atomic(MIC_SOURCE_ENV, "%s=%s\n" % (MIC_SOURCE_VAR, source),
                 mode=0o644, dry_run=applier.dry_run)
    os.environ[MIC_SOURCE_VAR] = source
    # SAID OUT LOUD ON EVERY APPLY, not only when it changes. A microphone is
    # the one thing in this graph whose state cannot be heard from the room, so
    # "which one is open right now" has to be answerable from the journal alone
    # -- and it is what tells a real input mute (the legs stopped, below) apart
    # from a cosmetic one at three in the morning.
    log("microphone: %s%s" % (source,
                              "" if previous is None or previous == source
                              else " (was %s: the legs are restarted)" % previous))
    return previous is not None and previous != source


# ActiveState values that mean the unit is genuinely gone. `deactivating` is
# NOT one of them: it is still running. Anything else, and anything unparseable,
# is treated as "still there" by unit_active below.
UNIT_GONE_STATES = frozenset({"inactive", "failed"})


def unit_active(applier, unit):
    """True (running), False (gone) or None (could not tell). Never guesses.

    `systemctl is-active --quiet` CANNOT BE USED FOR THIS, and that is the whole
    reason this function exists (terra, round 5). It exits non-zero both for a
    unit that is inactive and for a D-Bus error, a timeout or a missing
    systemctl -- and `Applier.command` collapses all of those to 1. So "the
    microphone is gone" and "I could not ask whether the microphone is gone"
    were the same answer, which is the fail-open shape this whole control keeps
    producing.

    `systemctl show -p ActiveState --value` exits 0 and PRINTS the state, so a
    failure to query is distinguishable from an answer. None must be treated as
    "still running" by anything making a safety decision.
    """
    text = applier.capture(["/usr/bin/systemctl", "show", "-p", "ActiveState",
                            "--value", unit])
    if text is None:
        return None
    state = text.strip().splitlines()
    state = state[0].strip() if state else ""
    if not state:
        return None
    return state not in UNIT_GONE_STATES


def stop_mic_leg_hard(applier, unit):
    """Stop a mic leg, and make sure it is actually gone. True if it is.

    A STOP THAT FAILED USED TO BE COUNTED AND STEPPED OVER, and for a microphone
    that is not enough: the state is saved before the apply, `wall-mic-rear` has
    no runtime state recheck of its own, and an already-open `alsaloop` goes on
    sending the room to the desktop's input while the stored state says muted.
    Nobody in the room can hear that happen. (terra, round 4; `wall-audio-mode`
    already escalated this way and `input-mute` did not.)

    So: stop, ask, SIGKILL, ask again. The ExecCondition gate stops it coming
    back. A leg that survives all of that is a failed apply with a journal line
    that says the microphone may still be live, which is the most honest thing
    left to do from here.
    """
    applier.command(["/usr/bin/systemctl", "stop", unit], required=False)
    if unit_active(applier, unit) is False:
        return True
    log("%s did not stop, or could not be asked; killing it, because a "
        "microphone that is still open is not something anybody in the room "
        "can hear" % unit)
    applier.command(["/usr/bin/systemctl", "kill", "--signal=SIGKILL", unit],
                    required=False)
    still = unit_active(applier, unit)
    if still is False:
        return True
    log("REFUSING TO REPORT SUCCESS: %s %s after both a stop and a kill, so the "
        "microphone may still be transmitting while the state says it is muted. "
        "Check `systemctl status %s` and `fuser -v /dev/snd/*`."
        % (unit, "is still running" if still else "could not be queried", unit))
    return False


def rear_mic_possible(applier, chain=None, speaker_wanted=None):
    """Whether the mic-to-rear leg may be started right now. Journals if not.

    THE ONE PLACE WHERE STEP 3'S FALLBACK AND STEP 4'S LEG CANNOT BOTH EXIST.
    The adapter has ONE playback stream. Step 4 makes the eight-channel open a
    dmix (`usb_out_mix`) precisely so the speaker route and the mic route can
    share it. `speaker_stereo` -- the step 3 fallback, which is deliberately
    still a RAW open of the adapter, because the whole point of a fallback is
    that it is the simplest thing that can possibly work -- does not go through
    that dmix. So while the speaker leg is running on the stereo fallback, the
    adapter is held exclusively and the rear leg cannot open it.

    That is not a failure to repair here: it is the degraded chain doing exactly
    what a degraded chain should, and the Bluetooth mic return (a different
    device entirely) is unaffected. In Mute and in Headset the speaker leg is
    stopped, nothing holds the adapter, and the rear leg runs normally.
    """
    if chain is None:
        chain = os.environ.get(SPEAKER_CHAIN_VAR) or read_env(
            SPEAKER_CHAIN_ENV, SPEAKER_CHAIN_VAR, SPEAKER_CHAIN_MULTI)
    if speaker_wanted is None:
        speaker_wanted = applier.command(
            ["/usr/bin/systemctl", "is-active", "--quiet", SPEAKER_OUT_UNIT],
            quiet=True) == 0
    if speaker_wanted and chain == SPEAKER_CHAIN_STEREO:
        log("the mic return to the desktop's input is NOT running: the speaker "
            "leg fell back to %s, which opens the adapter directly rather than "
            "through %s, so there is no channel left for the rear pair. Fix the "
            "8-channel chain (see /etc/wall-panel/audio-trim.conf) and re-apply."
            % (SPEAKER_CHAIN_STEREO, "usb_out_mix"))
        return False
    return True


def mic_allowed_command(arguments):
    """`wall-audio-output mic-allowed`: exit 0 if a mic leg may run, 1 if not.

    THE UNITS' OWN GATE, AND THE ANSWER TO A RESTART BEHIND A MUTE. Both mic
    legs are `Restart=always`, so "the applier stopped it" is not a property
    anybody can rely on: a guard or alsaloop crash, an operator restart, a
    `daemon-reload` workflow, or a stop that FAILED during an apply would each
    start the leg again with the state still saying muted. Review (terra,
    2026-09-14, rounds 1 and 2) found that path twice, once per leg.

    systemd re-runs `ExecCondition=` on every start attempt INCLUDING a restart,
    and a non-zero exit from one is a clean "not started" rather than a failure,
    which is exactly the shape wanted here.

    It takes NO LOCK, for the same reason `status` does not: this is a read, and
    a read that blocks behind an apply would deadlock the very apply that is
    starting the leg. Every failure answers 1 -- an unreadable state file is not
    consent to open a microphone.
    Implements: SR-029, LLR-016
    """
    # A MISSING STATE FILE IS NOT CONSENT, and that is not a hardship: the
    # applier SAVES the state before it applies the plan, so by the time it runs
    # `systemctl start` on either mic leg the file is there. This gate and the
    # Bluetooth supervisor's own therefore answer identically in every case --
    # two gates on one privacy control must not be able to disagree.
    # IT DOES NOT USE load_state, AND THAT IS THE WHOLE POINT (terra, round 3).
    # `load_state` exists to keep the panel working: it converts a missing,
    # unreadable or unparseable file into `default_state()`, which is Speaker,
    # UNMUTED. That is right for audio and exactly wrong here -- it would have
    # started a real microphone forwarder off a corrupt file while claiming
    # "every failure answers 1", and it would have disagreed with the Bluetooth
    # supervisor, which parses the document itself and refuses.
    #
    # So this gate reads the raw JSON, and anything that is not a document it
    # can read answers 1. `normalize` then does the rest, including its own
    # rule that a document needing repair comes back muted.
    try:
        raw = json.loads(Path(arguments.state).read_text(encoding="utf-8"))
    except FileNotFoundError:
        log("no switch state on disk: refusing to start a microphone leg")
        return 1
    except (OSError, ValueError) as exc:
        log("switch state unreadable (%s): refusing to start a microphone leg" % exc)
        return 1
    try:
        return 0 if policy.mic_live(policy.normalize(raw)) else 1
    except Exception:  # noqa: BLE001 - a policy that raises must not open a mic
        return 1


def probe_speaker_chain(applier):
    """Which chain speaker_out can actually slave onto. See SPEAKER_CHAIN_*.

    ONE PROBE, TWO FAILURE MODES, AND THAT IS WHY IT IS A PROBE AND NOT A CHECK.
    The 8-channel chain is unavailable if the adapter refuses the 8-channel
    altsetting (a different model dropped into the same role: the CM106 here has
    one, measured, but nothing in the design requires the part) OR if
    /etc/wall-panel/audio-trim.conf is missing or unparseable, which is where
    `speaker_multi` is defined. Asking ALSA to open it answers both at once, and
    answers them about the graph as it is right now rather than about a file's
    existence.

    `aplay -q -D speaker_multi` of one raw zero frame (PRE_OPEN_ARGS) opens the chain and
    exits -- the same move `declare_bus_control` makes, for the same reason, and
    with the same guarantee that not one sample reaches the room. Not required
    and short-timed out: it runs under the apply lock.
    """
    # `required=True` so that an aplay that is missing, or that raises, is
    # reported to this function as a FAILURE. With required=False an exception
    # answers 0 -- "the 8-channel chain opened" -- and the leg would be pointed
    # at a chain nobody has established exists, which is the loud way to be
    # wrong. `quiet` because the fallback below is the journal line worth having.
    if applier.command(PRE_OPEN_ARGS(SPEAKER_CHAIN_MULTI), quiet=True, timeout=5) == 0:
        return SPEAKER_CHAIN_MULTI
    log("the 8-channel speaker chain (%s) would not open: falling back to stereo "
        "front out, with no centre and no sub. Check "
        "/etc/wall-panel/audio-trim.conf and `cat /proc/asound/card*/stream0` "
        "for an 8-channel altsetting." % SPEAKER_CHAIN_MULTI)
    return SPEAKER_CHAIN_STEREO


def select_speaker_chain(applier):
    """Probe, publish the answer for the unit, and put it in our own environment.

    THE ENVIRONMENT HALF IS NOT REDUNDANT. `@func getenv` reads the environment
    of the process that OPENS the PCM. wall-speaker-out.service gets the answer
    through EnvironmentFile=, but the pre-open this applier does moments later --
    `aplay -D speaker_out`, which is what creates the softvol control -- is our
    OWN child, so it inherits our environment and nothing else. Without this line
    the pre-open would open the multi chain while the leg opened the stereo one,
    and a fallback would silently create its control on the wrong graph.
    """
    # Do not probe against a device the leg itself is holding. While
    # wall-speaker-out is running, the adapter is open and any probe answers
    # "busy" -- which read as "the 8-channel chain would not open" and demoted a
    # working multi-channel leg to stereo on the next restart. Measured on the
    # panel 2026-09-14 01:20 (`volume 100` while playing). The published answer
    # from the last probe with the leg stopped stands until the leg is stopped
    # again; the probe runs only when nothing holds the adapter.
    published = read_env(SPEAKER_CHAIN_ENV, SPEAKER_CHAIN_VAR, None)
    leg_running = applier.command(["/usr/bin/systemctl", "is-active", "--quiet",
                                   SPEAKER_OUT_UNIT], quiet=True) == 0
    if leg_running and published in (SPEAKER_CHAIN_MULTI, SPEAKER_CHAIN_STEREO):
        os.environ[SPEAKER_CHAIN_VAR] = published
        return published
    chain = probe_speaker_chain(applier)
    write_atomic(SPEAKER_CHAIN_ENV, "%s=%s\n" % (SPEAKER_CHAIN_VAR, chain),
                 mode=0o644, dry_run=applier.dry_run)
    os.environ[SPEAKER_CHAIN_VAR] = chain
    return chain


def publish_adapter_independent_state(wanted, headset, applier):
    """Publish runtime facts that remain true while the USB adapter is absent.

    The input-mute status is consumed by the UI and canceller, while the mic
    source and headset-card files prevent a later leg from inheriting stale
    runtime state.  They must be refreshed on every apply, including the
    slow-enumeration deferral.
    """
    # ITEM J's EFFECTIVE MUTE, PUBLISHED BEFORE ANY LEG MOVES. The canceller
    # polls it to decide whether its status block may claim a live microphone
    # level; publishing it after the legs had moved would leave a window in
    # which the wall drew a live ring over a microphone already stopped.
    # A dry run still writes this one, on exactly save_state's and
    # write_epoch_marker's reasoning: the hermetic suite has to be able to
    # read back WHAT was published, not only that something was. The LIVE
    # path is still refused, out loud, so --dry-run never touches the
    # panel's own /run.
    if applier.dry_run and INPUT_MUTE_ENV == LIVE_RUN_DIR / "audio-input-mute.env":
        print("write %s (suppressed: --dry-run on the live input-mute file)"
              % INPUT_MUTE_ENV)
    else:
        write_atomic(INPUT_MUTE_ENV,
                     "%s=%d\n" % (INPUT_MUTE_VAR,
                                  1 if wanted["input_muted_effective"] else 0),
                     mode=0o644)
    # Journalled as well as written, because the ORDER is the property that
    # matters: an operator reading the log must be able to see that the mute
    # was published before any leg moved, not merely that it was published.
    log("input mute published to %s: %s"
        % (INPUT_MUTE_ENV,
           "muted" if wanted["input_muted_effective"] else "live"))

    # WHICH MICROPHONE, PUBLISHED BEFORE ANYTHING OPENS ONE. The mic legs read
    # this through `@func getenv` on `mic_selected`, exactly as the headset leg
    # reads its card id, so it has to be written before they are started -- and
    # before the applier's own probe of `mic_rear`, which is its own child and
    # inherits its environment.
    mic_source_changed = select_mic_source(applier, wanted["mic_source"])

    # The resolved headset card is written even when the adapter is absent (as
    # an empty value), so a later start cannot pick up a stale card id.
    write_atomic(HEADSET_ENV, "WALL_AUDIO_HEADSET_CARD=%s\n" % (headset or ""),
                 mode=0o644, dry_run=applier.dry_run)
    return mic_source_changed


def apply_builtin_capture_controls(wanted, mic_values, builtin, applier):
    """Reassert the panel codec's gain and privacy switch. Returns failures.

    Unlike the adapter mixer and rear pair, the built-in PCH codec remains
    available during USB enumeration.  A failed close is counted because this
    is the hardware half of the Owner's input-mute privacy property.
    """
    # THE CAPTURE SIDE. Item 23 D4 puts the PANEL's own microphone on the mic
    # input in Speaker position, and that microphone was found CLIPPING at the
    # level it had been left at -- peak 32768, -15.2 dBFS RMS, at capture 62 %
    # with +12 dB of boost. The seeded knob is the level measured on the panel
    # after the AEC run had lowered it live (24 %, -6.00 dB, boost 0), and it is
    # re-asserted on every apply rather than trusted to alsactl, because a level
    # that clips is not a preference somebody might have meant.
    #
    # `Capture Source` is NOT touched. It is an exclusive enum on this codec
    # (`Internal Mic` | `Headset Mic`, measured 2026-09-14) and it already reads
    # Internal Mic; the panel's own jack has no capture path at all (the
    # 2026-09-12 pin dump), so there is nothing for the other position to mean.
    applier.command(["/usr/bin/amixer", "-c", builtin, "-q", "sset", "Capture",
                     "%d%%" % mic_values["capture_percent"]], required=False)
    applier.command(["/usr/bin/amixer", "-c", builtin, "-q", "sset",
                     "Internal Mic Boost", "%d" % mic_values["boost"]],
                    required=False)
    # THE INPUT MUTE IS A REAL MUTE AND THIS IS THE HARDWARE HALF OF IT (Owner
    # ruling E). The leg half -- stopping both forwarders, so that not one
    # sample leaves this panel -- is in `wanted["legs"]` above and below, and it
    # is the half that actually guarantees the property. This one is the belt:
    # a capture switch closed on the card means an unmuted leg started by
    # anything else still records silence.
    # `required` follows the DIRECTION here for the same reason the legs do.
    # Closing a capture switch that will not close is a privacy failure worth
    # reporting; opening one that will not open is a microphone that does not
    # work, which the leg above has already said.
    return applier.command(
        ["/usr/bin/amixer", "-c", builtin, "-q", "sset", "Capture",
         "nocap" if wanted["input_muted"] else "cap"],
        required=bool(wanted["input_muted"]))


def apply_plan(state, applier):
    """Make the world match `state`. Returns the number of failures.

    ORDER MATTERS AND IT IS: stop, mute, re-point, unmute, start, level.
    Stopping first means the adapter is never fed by two legs at once; muting
    before the legs move means the switch does not click through the
    amplifier; the level is set LAST because the softvol control does not
    exist until something has opened the PCM that declares it.
    """
    failures = 0
    wanted = policy.plan(state, aec_available=aec_available())
    adapter = read_env(CARDS_FILE, "WALL_AUDIO_ADAPTER_CARD", "ICUSBAUDIO7D")
    loopback = read_env(CARDS_FILE, "WALL_AUDIO_LOOPBACK_CARD", "Loopback")
    builtin = read_env(CARDS_FILE, "WALL_AUDIO_BUILTIN_CARD", "PCH")
    headset = headset_card()
    mic_values, mic_notes = load_mic()
    for note in mic_notes:
        log(note)
    mic_source_changed = publish_adapter_independent_state(wanted, headset, applier)

    # FAILING TO START A MICROPHONE IS A DEGRADED PANEL. FAILING TO STOP ONE IS
    # A PRIVACY FAILURE. The two directions are therefore NOT symmetric, and
    # review (terra, 2026-09-14) was right that making them symmetric was
    # fail-open on the one control in this design whose failure nobody can hear:
    # a transient systemctl error would have persisted `input_muted: true`,
    # returned success, and left the microphone transmitting.
    #
    # So a mic leg that will not STOP counts as a failed apply, exactly like an
    # output leg, and says so loudly. A mic leg that will not START does not:
    # `apply-state` runs under wall-audio-state.service, which firstboot waits
    # on, and a non-zero return there is a red firstboot and a panel that looks
    # broken at the glass. That asymmetry is the whole point.
    #
    # THE MIC LEGS ARE STOPPED FIRST, BEFORE ANY OUTPUT LEG MOVES (item J). The
    # ordering matters because a coupled mute arrives as ONE request that
    # changes both: `set_output mute` mutes the room and the microphone
    # together. Stopping the output first and the microphone second would leave
    # a window -- short, but real, and it is the window in which the room has
    # gone quiet and the person believes they are unheard -- where the mic is
    # still forwarding. Doing it in this order means the coupled mute takes
    # effect NO LATER than the output change it came with.
    mic_stopped = True
    for unit in policy.MIC_LEGS:
        if not wanted["legs"].get(unit, False):
            # Stopped HARDER than the output legs, and verified: see
            # stop_mic_leg_hard for why a counted failure is not enough.
            if stop_mic_leg_hard(applier, unit):
                continue
            failures += 1
            mic_stopped = False
    for unit, should_run in wanted["legs"].items():
        if unit in policy.MIC_LEGS:
            continue
        if not should_run:
            failures += applier.command(["/usr/bin/systemctl", "stop", unit])
    # Mixer mutes are not required: a card that has just been unplugged has no
    # controls to set, and that is the normal headset case, not an error.
    applier.command(["/usr/bin/amixer", "-c", adapter, "-q", "sset", "Speaker",
                     "mute" if wanted["adapter_muted"] else "unmute"], required=False)
    if headset:
        applier.command(["/usr/bin/amixer", "-c", headset, "-q", "sset", "Speaker",
                         "mute" if wanted["headset_muted"] else "unmute"], required=False)
        failures += applier.command(
            ["/usr/bin/amixer", "-c", headset, "-q", "sset", "Mic",
             "nocap" if wanted["input_muted"] else "cap"],
            required=bool(wanted["input_muted"]))
        applier.command(["/usr/bin/amixer", "-c", headset, "-q", "sset", "Mic",
                         "%d%%" % mic_values["headset_capture_percent"]],
                        required=False)
    failures += apply_builtin_capture_controls(wanted, mic_values, builtin, applier)
    # THE REAR PAIR IS RAISED ONLY WHILE A MIC LEG IS MEANT TO RUN, and put back
    # to the 0 the tone era left it at otherwise (coordinator log 2026-09-13
    # 22:50, "adapter rear pair (RL/RR) set to 0 and stored with alsactl"). Two
    # independent things therefore have to be wrong at once before the room's
    # music can reach the desktop's input: the generated speaker route's
    # explicit zeros on channels 4-7, and this level.
    if not set_rear_level(applier, adapter,
                          mic_values["rear_level"] if wanted["mic_live"] else 0) \
            and not wanted["mic_live"]:
        # Only the LOWERING direction is counted: see set_rear_level.
        failures += 1
        log("the adapter's rear pair could NOT be returned to silence: the "
            "desktop's input is still wired to live channels. The generated "
            "route's explicit zeros are the only barrier left.")
    # THE SOFTVOL CONTROL IS DECLARED, AND SET, BEFORE THE LEG STARTS. softvol
    # creates its control when a client opens the PCM that declares it, and a
    # control that does not exist yet cannot be set -- which on 2026-09-13 made
    # `wall-audio-mode bus` log `amixer sset Bus 60%` failing on the first apply
    # of the boot. Declaring it ourselves first also closes the window review
    # found in the first fix: a control created AFTER the forwarder is already
    # running sits at the plugin default, which is full scale, with audio
    # flowing through it.
    leg_pcm = BUS_CONTROL_PCM.get(state["output"])
    # WHICH SPEAKER CHAIN, DECIDED BEFORE ANYTHING OPENS speaker_out. The
    # pre-open below and the leg itself must agree, and only this order gets
    # that: probe, publish, then declare the control on the chain that answered.
    # Nothing is probed when the speaker leg is not wanted -- in Mute, or in
    # Headset, opening the adapter at all would be audio nobody asked for.
    if state["output"] == "speaker" and any(wanted["legs"].values()):
        select_speaker_chain(applier)
    if leg_pcm and any(wanted["legs"].values()):
        if declare_bus_control(applier, leg_pcm):
            set_bus_level(applier, loopback, wanted["volume"], expected=False)
    for unit, should_run in wanted["legs"].items():
        if not should_run:
            continue
        if unit in policy.MIC_LEGS:
            if unit == MIC_REAR_UNIT and not rear_mic_possible(applier):
                continue
            applier.command(["/usr/bin/systemctl",
                             "restart" if mic_source_changed else "start", unit],
                            required=False)
        else:
            failures += applier.command(["/usr/bin/systemctl", "start", unit])
    # THE LEVEL IS SET LAST AND IT IS RETRIED. softvol creates its control when
    # a client OPENS the PCM that declares it, and `systemctl start` on a
    # Type=simple forwarder returns as soon as the process is forked -- not when
    # alsaloop has opened anything. Setting the level once, immediately, would
    # therefore leave a freshly started leg at the plugin default (full scale)
    # rather than at the Owner's remembered level, which is the loudest possible
    # way to get this wrong. An unanswered control after the whole window is a
    # journal line, not a failed apply: the audio is playing, only the level is
    # not what was asked for.
    if not set_bus_level(applier, loopback, wanted["volume"],
                         expected=any(wanted["legs"].values()),
                         pcm=leg_pcm):
        log("bus level %d%% could not be applied: the control never appeared"
            % wanted["volume"])
    if wanted["reason"]:
        log("output %s is UNAVAILABLE (%s): every output silent"
            % (state["output"], wanted["reason"]))
    # ITEM J'S EVIDENCE, NOT ITS INTENTION. `mic_legs_running` is what the
    # applier OBSERVED after the pass: true while any mic leg is meant to run,
    # and -- the case that matters -- true when a leg that was meant to STOP
    # would not, which is how the broker comes to report `inputMutedConfirmed:
    # false` instead of a success nobody can hear is a lie.
    if wanted["mic_live"]:
        state["mic_legs_running"] = True
    else:
        state["mic_legs_running"] = not mic_stopped
        if not mic_stopped:
            log("REFUSING TO CONFIRM THE INPUT MUTE: a mic leg is still "
                "transmitting. The state records it as unconfirmed.")
    return failures


def headset_event(present, forced_boot=False, forced_runtime=False):
    """One `headset` event, carrying whether it is coldplug or a runtime plug.

    The distinction is the Owner's 2026-09-13 ruling and it is made HERE, in the
    shell, because it is a fact about the machine (see is_boot_presence), not a
    policy. wall_audio_state is then told what kind of report it has, and only
    a runtime add is allowed to move the switch.

    `--boot` and `--runtime` force the answer for a caller that already knows
    it: the udev path never passes either, because the whole point is that it
    cannot honestly tell. A bare `wall-audio-output headset add` typed at a
    terminal with no udev answer available resolves to BOOT -- it records the
    adapter and leaves the switch alone -- because that is the safe direction.
    """
    if not present:
        # A remove is only ever a runtime event: a device that is not there
        # cannot be coldplugged, and the remove half of the presence unit only
        # runs when the kernel actually took the device away.
        return {"kind": "headset", "present": False, "boot": bool(forced_boot)}
    if forced_runtime:
        return {"kind": "headset", "present": True, "boot": False}
    boot = forced_boot
    if not boot:
        boot = is_boot_presence(device_initialized_usec(headset_syspath()))
    return {"kind": "headset", "present": True, "boot": bool(boot)}


def event_from_arguments(arguments):
    """Turn the parsed command line into one wall_audio_state event, or None.

    None means "apply what is stored" -- boot, resume and a manual re-assert
    all take that path, and none of them is allowed to invent a state change
    beyond recording what is plugged in (see _locked_apply).
    """
    if arguments.command == "set":
        return {"kind": "set_output", "output": arguments.value}
    if arguments.command == "input-mute":
        return {"kind": "set_input_mute", "muted": arguments.value == "on"}
    if arguments.command == "volume":
        if arguments.value in ("up", "down"):
            return {"kind": "nudge_volume", "louder": arguments.value == "up"}
        # `up:PCT` / `down:PCT` -- one rocker movement of a stated size. It is
        # spelled as a SUFFIX ON THE DIRECTION, not a second argument, so that
        # it stays one `value` token and the privileged broker keeps passing a
        # fixed-length argv it fully controls. See _nudge_volume for why a
        # magnitude is needed at all.
        if ":" in arguments.value:
            direction, _, size = arguments.value.partition(":")
            # `snap:PCT` -- round to the nearest multiple and settle there. The
            # rocker sends one when the Owner lets go, so the level lands on a
            # round number without the ramp itself being quantised.
            if direction == "snap":
                return {"kind": "snap_volume", "to": int(size)}
            return {"kind": "nudge_volume", "louder": direction == "up",
                    "step": int(size)}
        return {"kind": "set_volume", "level": int(arguments.value)}
    if arguments.command == "headset":
        return headset_event(arguments.value == "add", forced_boot=arguments.boot,
                             forced_runtime=arguments.runtime)
    return None


def _volume_value_is_valid(value):
    """True for the four accepted spellings of a volume argument.

    `0..100` absolute, `up`/`down` for one default press, and `up:PCT`/
    `down:PCT` for a movement of a stated size. PCT is validated HERE as well
    as in the state layer: this is the boundary a human or the broker types at,
    and argparse refusing it produces a usage message, where the state layer
    raising StateError produces a traceback-shaped failure instead.
    """
    if value in ("up", "down"):
        return True
    if value.isdigit():
        return 0 <= int(value) <= 100
    direction, separator, size = value.partition(":")
    if not separator or direction not in ("up", "down", "snap"):
        return False
    # isdigit() alone would accept "up:007" and unicode digits; both are fine
    # arithmetically, but the range check is what actually matters.
    return size.isdigit() and 1 <= int(size) <= 100


ALLOWED_REQUEST_KINDS = frozenset(
    {"set_output", "set_input_mute", "set_volume", "nudge_volume",
     "snap_volume"})


def read_request(path, last_seq=-1, generation=None, epoch_vouched=True):
    """One validated, deduplicated, epoch-scoped broker request, or None.

    The request file is written by a LESS privileged process, so it is treated
    as input from outside: the envelope is checked here, the contents are
    checked by policy, and `headset` is refused outright -- adapter presence is
    the kernel's fact to report, not the renderer's.

    Deduplication is by a monotonic `seq` against the last one recorded in the
    state: systemd.path fires on close-write, and an identical re-write of an
    unchanged request must not replay a rocker press.

    THE EPOCH GATE (contract 2026-09-14, section 1.2). `seq` orders requests
    inside one life of the applier. It cannot order across a restart: a state
    file replaced or rolled back moves `request_seq` backwards, and then a
    request refused before the restart is indistinguishable from a fresh one. So
    a request may also carry `generation`, and one that names an epoch this
    applier is not in is refused outright.

    `generation` is OPTIONAL, and that is not laxity. The two other writers of
    intent -- the rocker and the root CLI -- do not go through this file at all;
    they invoke this same binary under this same lock, so they take their
    ordering from the same authority and have no epoch of their own to quote. A
    request without one is accepted as unscoped, exactly as it was before this
    change, which is also what keeps an older broker working against a newer
    applier.

    Both gates run INSIDE the caller's lock, against the state just loaded, and
    before any policy event is applied -- so a refusal leaves the state file
    byte-identical.

    Inputs:  path: the request file
             last_seq: the state's `request_seq` high-water mark
             generation: the applier's current epoch, or None to skip the gate
    Outputs: (seq, event) or None
    Implements: SR-028, LLR-014
    """
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        log("request unusable: %s" % exc)
        return None
    if not isinstance(raw, dict) or raw.get("version") != 1:
        log("request refused: unknown envelope")
        return None
    seq = raw.get("seq")
    if not isinstance(seq, int) or isinstance(seq, bool) or seq < 0:
        log("request refused: seq must be a non-negative integer")
        return None
    if seq <= last_seq:
        # Said out loud rather than dropped in silence: if a clock step ever
        # puts a producer behind the recorded high-water mark, this line is the
        # only way anyone finds out why the switch stopped responding.
        log("request %d ignored: not newer than the last applied (%d)" % (seq, last_seq))
        return None
    if "generation" in raw:
        asked = raw.get("generation")
        if not isinstance(asked, int) or isinstance(asked, bool) or asked < 0:
            log("request %d refused: generation must be a non-negative integer" % seq)
            return None
        if not epoch_vouched:
            # /run was cleared under a running panel, so this process cannot say
            # which epoch it is in. Refusing is the only honest answer: the
            # alternative is obeying a request whose epoch nothing can check.
            log("request %d refused: the epoch marker is gone, so generation %d "
                "cannot be checked; apply-state must re-establish the epoch"
                % (seq, asked))
            return None
        if generation is not None and asked != generation:
            # Loud, because this is the only way anyone finds out that a renderer
            # is still talking to an epoch that ended -- which is precisely the
            # moment it must re-handshake rather than be quietly obeyed.
            log("request %d refused: generation %d is not the current epoch %d"
                % (seq, asked, generation))
            return None
    event = raw.get("event")
    if not isinstance(event, dict) or event.get("kind") not in ALLOWED_REQUEST_KINDS:
        log("request refused: unknown event kind")
        return None
    return seq, event


def main(argv=None):
    parser = argparse.ArgumentParser(description="panel audio output switch")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the privileged commands; change nothing")
    parser.add_argument("--state", default=str(STATE_FILE))
    parser.add_argument("--boot", action="store_true",
                        help="force a presence report to be treated as coldplug "
                             "(a fact to record, never an event to act on)")
    parser.add_argument("--runtime", action="store_true",
                        help="force a presence report to be treated as a plug "
                             "event on an already-running system")
    parser.add_argument("--render", action="store_true",
                        help="re-render the generated file from the stored values")
    parser.add_argument("--trim-env", default=None,
                        help="the trim values file (a test seam)")
    parser.add_argument("--trim-conf", default=None,
                        help="the rendered ALSA trim file (a test seam)")
    parser.add_argument("command", choices=("status", "set", "input-mute", "volume",
                                            "headset", "apply-state", "apply-request",
                                            "trim", "mic", "mic-allowed"))
    # `trim` and `mic` take a whole table's worth of KEY=VALUE; every other takes
    # at most one word. Parsed as a list here and narrowed below, so that a
    # second argument to `set` is a usage error rather than a silently ignored
    # one.
    parser.add_argument("value", nargs="*")
    arguments = parser.parse_args(argv)

    # CONF_DIR is read at import time from the environment, so these defaults
    # follow the hermetic suite's temp tree the same way STATE_FILE does.
    arguments.trim_env = Path(arguments.trim_env or TRIM_ENV)
    arguments.trim_conf = Path(arguments.trim_conf or TRIM_CONF)

    if arguments.command not in ("trim", "mic"):
        if arguments.render:
            parser.error("--render only means anything for `trim` and `mic`")
        if len(arguments.value) > 1:
            parser.error("%s takes at most one argument" % arguments.command)
        arguments.value = arguments.value[0] if arguments.value else None

    if arguments.command == "trim":
        # Under the same lock every other writer takes: see trim_command.
        with apply_lock(dry_run=arguments.dry_run):
            return trim_command(arguments)

    if arguments.command == "mic":
        # Same lock, same reason: it rewrites a generated ALSA file and may
        # restart a leg, so it must not interleave with an apply.
        with apply_lock(dry_run=arguments.dry_run):
            # dry_run was DROPPED here, so `--dry-run mic` overwrote
            # /etc/wall-panel/audio-mic.* and could restart a live microphone
            # (terra, round 5). A dry run must be dry in every command.
            return mic_command(list(arguments.value)
                               + (["--render"] if arguments.render else []),
                               dry_run=arguments.dry_run)

    if arguments.boot and arguments.runtime:
        parser.error("--boot and --runtime are opposites; pass at most one")
    if (arguments.boot or arguments.runtime) and arguments.command != "headset":
        parser.error("--boot/--runtime only mean anything for `headset`")

    expects_value = {"set": policy.OUTPUTS, "input-mute": ("on", "off"),
                     "headset": ("add", "remove")}
    if arguments.command in expects_value:
        if arguments.value not in expects_value[arguments.command]:
            parser.error("%s takes one of %s"
                         % (arguments.command, "|".join(expects_value[arguments.command])))
    if arguments.command == "volume":
        if arguments.value is None or not _volume_value_is_valid(arguments.value):
            parser.error("volume takes 0..100, up, down, up:PCT, down:PCT "
                         "or snap:PCT")

    if arguments.command == "mic-allowed":
        # Read-only and LOCK-FREE, like `status`: it is asked by both mic units'
        # ExecCondition while an apply that is starting them holds the lock.
        return mic_allowed_command(arguments)

    if arguments.command == "status":
        # The only read-only command, and the only one that does not take the
        # lock: a status printed during someone else's apply is a moment in
        # time, which is what it claims to be.
        state, note = load_state(arguments.state)
        if note:
            log(note)
        trim, trim_notes = load_trim(arguments.trim_env)
        for line in trim_notes:
            log(line)
        mic, mic_notes = load_mic()
        for line in mic_notes:
            log(line)
        print(json.dumps({"mode": current_mode(), "state": state,
                          "plan": policy.plan(state, aec_available=aec_available()),
                          # Step 3, and the two things the Owner will want at
                          # the glass test: which chain the leg actually opened,
                          # and what the centre and sub are being fed.
                          "speaker_chain": read_env(SPEAKER_CHAIN_ENV,
                                                    SPEAKER_CHAIN_VAR,
                                                    SPEAKER_CHAIN_MULTI),
                          "trim": {key: round(trim[key], 4) for key in TRIM_KEYS},
                          # Step 4. `mic_source` and `mic_live` come out of the
                          # plan, so `status` says which microphone the switch
                          # BELIEVES is selected and whether it should be
                          # running at all -- which is what tells a cosmetic
                          # mute apart from a real one at the glass.
                          "mic": {key: mic[key] for key in MIC_KEYS},
                          "mic_source_published": read_env(MIC_SOURCE_ENV,
                                                           MIC_SOURCE_VAR, None),
                          "headset_card": headset_card()}, indent=2, sort_keys=True))
        return 0

    with apply_lock(dry_run=arguments.dry_run):
        return _locked_apply(arguments)


def _locked_apply(arguments):
    """One complete apply, under the lock. See apply_lock for why it is whole.

    Returns the process exit code.
    """
    state, note = load_state(arguments.state)
    if note:
        log(note)

    # THE MARKER IS THE AUTHORITY FOR EVERY COMMAND BUT apply-state, which opens
    # the epoch itself below. Two things come out of it and BOTH matter (terra,
    # 2026-09-14, findings 1 and 2):
    #
    #   the GENERATION, because every request minted in this life was stamped
    #   from it, so a state file rolled back or replaced underneath a running
    #   panel must be brought back up rather than silently refusing everything
    #   in flight; and
    #
    #   the REQUEST MARK, because carrying only the generation left a hole: a
    #   rollback to an old `request_seq` under a live epoch re-opened every
    #   request the applier had already refused, and a delayed one would apply.
    #
    # A MISSING MARKER IS AN EPOCH BREAK, NOT A SHRUG. /run is tmpfs, so its
    # absence on a running system means it was cleared under us and this process
    # cannot vouch for the epoch at all. Requests that NAME an epoch are refused
    # until `apply-state` re-establishes one -- which is exactly the fresh
    # handshake the contract asks for. Requests that name none are still
    # applied: the rocker and the root CLI have no epoch to be wrong about, and
    # a volume key that stopped working because /run was cleaned would be a
    # worse failure than the one this guards.
    epoch_vouched = True
    if arguments.command != "apply-state":
        marker, mark = read_epoch_marker()
        if marker is None:
            epoch_vouched = False
            log("no epoch marker in %s: this process cannot vouch for the "
                "epoch, so any request that names one is refused until "
                "apply-state re-establishes it" % EPOCH_MARKER)
        else:
            if state["generation"] != marker:
                log("epoch %d adopted from the run marker (state file said %d)"
                    % (marker, state["generation"]))
                state["generation"] = marker
            if mark > state.get("request_seq", -1):
                log("request mark %d restored from the run marker (state file "
                    "said %d)" % (mark, state.get("request_seq", -1)))
                state["request_seq"] = mark

    seq = None
    boot_mark = None
    if arguments.command == "apply-state":
        # Sampled HERE, before anything is decided or applied, and written at
        # the very end -- see write_boot_stamp for why the two halves are apart.
        boot_mark = int(time.monotonic() * 1_000_000)
        # The epoch is opened BEFORE anything else this command does, so that
        # every write below -- including the presence record -- carries the
        # generation this life of the backend will answer requests in.
        try:
            state, epoch_lines = open_epoch(state, dry_run=arguments.dry_run)
        except policy.StateError as exc:
            log("refused: %s" % exc)
            return 1
        for line in epoch_lines:
            log(line)
        # THE STORED POSITION IS APPLIED FIRST, AND WHAT IS PLUGGED IN IS ONLY
        # RECORDED. Owner ruling 2026-09-13: over a boot we do not know when a
        # plug event happened or whether it is still relevant, so coldplug is a
        # fact, never an event. This refreshes `headset_present` -- which is
        # otherwise a stale value from the last boot -- and sets the one-shot
        # latch from what coldplug actually sees, without ever moving `output`.
        state, lines = policy.apply_event(
            state, headset_event(headset_card() is not None, forced_boot=True))
        for line in lines:
            log(line)
        save_state(state, arguments.state, dry_run=arguments.dry_run)

    if arguments.command == "apply-request":
        request = read_request(arguments.value or DEFAULT_REQUEST,
                               state.get("request_seq", -1),
                               generation=state.get("generation"),
                               epoch_vouched=epoch_vouched)
        if request is None:
            return 0
        seq, event = request
    else:
        event = event_from_arguments(arguments)

    if event is not None:
        try:
            state, lines = policy.apply_event(state, event)
        except policy.StateError as exc:
            log("refused: %s" % exc)
            return 1
        for line in lines:
            log(line)
        if seq is not None:
            # Recorded in the SAME atomic write as the change it caused: a seq
            # that survived while its effect did not would swallow the retry.
            state["request_seq"] = seq
        save_state(state, arguments.state, dry_run=arguments.dry_run)
        # THE MARKER IS ADVANCED AFTER THE STATE, AND THE ORDER IS THE WHOLE
        # POINT (terra, second pass). The marker's mark is a RESTORE copy: on
        # the next run the higher of the two wins. So a crash between them must
        # leave the marker BEHIND the state, never ahead of it -- writing the
        # marker first meant a crash before `save_state` deduplicated a request
        # whose effect had never happened, losing it permanently and silently.
        # An earlier comment here claimed this order while the code did the
        # opposite; the comment was right and the code is now too.
        #
        # ONLY WHEN A MARKER ALREADY EXISTS. Writing one when /run has been
        # cleared would RE-VOUCH for an epoch this process has just said it
        # cannot vouch for, and the next `apply-state` would keep the dead epoch
        # instead of opening a new one -- the fence of finding 2, undone by its
        # own bookkeeping.
        if seq is not None and epoch_vouched:
            write_epoch_marker(state["generation"], seq, dry_run=arguments.dry_run)

    mode = current_mode()
    if mode != "bus":
        # The state is still recorded: the Owner may set the switch while the
        # panel is in the old trigger chain, and `wall-audio-mode bus` applies
        # it on arrival. Touching mixers or units here would fight that chain.
        log("mode is %s, not bus: state recorded, hardware untouched" % mode)
        if boot_mark is not None:
            write_boot_stamp(dry_run=arguments.dry_run, monotonic_usec=boot_mark)
        return 0
    adapter = read_env(CARDS_FILE, "WALL_AUDIO_ADAPTER_CARD", "ICUSBAUDIO7D")
    if not adapter_present(adapter):
        # Slow USB enumeration is not a failed switch policy. Starting legs
        # here only spends their 15-second waits; the adapter add rule invokes
        # this non-sticky re-assert once the device actually exists. Do NOT
        # generalise this to a present-but-broken adapter: apply_plan below
        # still counts and reports those real failures.
        wanted = policy.plan(state, aec_available=aec_available())
        mic_values, mic_notes = load_mic()
        for mic_note in mic_notes:
            log(mic_note)
        builtin = read_env(CARDS_FILE, "WALL_AUDIO_BUILTIN_CARD", "PCH")
        deferred_applier = Applier(dry_run=arguments.dry_run)
        publish_adapter_independent_state(wanted, headset_card(), deferred_applier)
        failures = apply_builtin_capture_controls(
            wanted, mic_values, builtin, deferred_applier)
        log("audio adapter card id %r is not present: deferring apply until its "
            "device re-add; published runtime audio state and "
            "re-asserted built-in input controls" % adapter)
        if boot_mark is not None:
            write_boot_stamp(dry_run=arguments.dry_run, monotonic_usec=boot_mark)
        return 1 if failures else 0
    before_observation = state.get("mic_legs_running")
    failures = apply_plan(state, Applier(dry_run=arguments.dry_run))
    # A SECOND WRITE, AND IT IS NOT REDUNDANT. Everything else in the state is
    # an INTENTION and is persisted before the apply, so that a crash halfway
    # through cannot lose what the Owner asked for. `mic_legs_running` is an
    # OBSERVATION and cannot exist until the apply has happened -- and it is the
    # one fact that decides whether the broker may report the coupled mute as
    # confirmed, so it must reach the file even when the apply failed.
    if state.get("mic_legs_running") != before_observation:
        save_state(state, arguments.state, dry_run=arguments.dry_run)
    # Published only now, with the graph in the position the state asked for. A
    # stamp written before the apply would declare the boot settled while the
    # legs were still moving, and any adapter that enumerated in between would
    # read as a plug event -- the very thing this is here to prevent.
    if boot_mark is not None:
        write_boot_stamp(dry_run=arguments.dry_run, monotonic_usec=boot_mark)
    if failures:
        log("apply finished with %d failure(s): audio may be wrong" % failures)
        return 1
    return 0


if __name__ == "__main__":  # pragma: no cover - exercised through main()
    try:
        sys.exit(main())
    except BrokenPipeError:  # pragma: no cover
        os._exit(errno.EPIPE)
