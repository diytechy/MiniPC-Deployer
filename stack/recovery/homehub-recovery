#!/usr/bin/env python3
"""homehub-recovery — the Owner's handle on the hub recovery capability.

  status                 mode, health, brake, the last boots, quarantined services
  disarm                 the ONLY way to stop the supervisor with the hardware
                         watchdog closed (§3.6): a one-use authorisation naming
                         this boot and the running invocation, a SIGUSR1, and a
                         stop ONLY after the supervisor acknowledged and sysfs
                         reads the device inactive. A reboot never disarms.
  reset-brake            forget the counted boots so far (the brake also clears
                         by itself after 24 h with no counted boot)
  release SERVICE        undo a quarantine: restore the restart policy and start it
  enforce-quarantine     keep every quarantined service stopped (firstboot runs
                         this right after its `docker compose up -d`)
  events [-n N]          the newest evidence records
  check-config FILE      validate a .env-style file; print the normalised knobs
                         (setup-recovery.sh's refusal path; exit 2 on a bad knob)

Installed as /usr/local/sbin/homehub-recovery, a SYMLINK into the stack tree:
it imports recovery_common from beside its real path, and a copy would break
that import (the panel volume-applier lesson).

Implements: SR-050, SR-051, LLR-998, LLR-1001, LLR-1002, LLR-1016
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import recovery_common as rc  # noqa: E402

UNIT = "homehub-recoveryd.service"


def _run(argv, timeout=60):
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
        return done.returncode, (done.stdout or "").strip(), (done.stderr or "").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 127, "", str(exc)


def cmd_status(paths: rc.Paths, _args) -> int:
    status = rc.read_json(paths.status_json)
    boot = rc.read_json(paths.boot_json)
    code, active, _ = _run(["systemctl", "is-active", UNIT], 10)
    print("supervisor unit: {}   reset device {}: {}".format(
        active or "unknown", _device(paths), device_state(paths, _device(paths))))
    if status:
        print("mode: {mode}   health: {health}   armed: {armed}   petting: {petting}".format(**status))
        for reason in status.get("reasons") or []:
            print("  report-only because: {}".format(reason))
        print("memory state: {}   episode age: {}   kill budget left: {}".format(
            status.get("state"), status.get("episode_age"), status.get("kill_budget_left")))
        if status.get("quarantined"):
            print("QUARANTINED (stopped until released): {}".format(", ".join(status["quarantined"])))
            print("  release with: homehub-recovery release <service>")
        age = time.time() - float(status.get("utc") or 0)
        if age > 30:
            print("WARNING: status.json is {:.0f} s old - the supervisor is not ticking".format(age))
    else:
        print("no status: the supervisor is not running (HUB_WATCHDOG_ENABLED off, or stopped)")
        # Quarantine outlives the supervisor (firstboot keeps these stopped
        # every boot), so it must stay visible when the supervisor is off.
        held = (rc.read_json(paths.quarantine_file) or {}).get("quarantined") or {}
        if held:
            print("QUARANTINED (stopped until released): {}".format(", ".join(sorted(held))))
            print("  release with: homehub-recovery release <service>")
    if boot:
        print("this boot: previous boot was {class}; brake: {brake_detail}; braked: {braked}; "
              "kernel.panic={kernel_panic}; committed: {committed}".format(
                  **{k: boot.get(k) for k in ("class", "brake_detail", "braked", "kernel_panic",
                                              "committed")}))
        print("D10: unexplained boots {} counted (bootstatus proven for the selected device {}: {}; "
              "proven devices: {})".format(
                  "ARE" if boot.get("counting_unexplained") else "are NOT",
                  boot.get("watchdog_identity") or "(none)", boot.get("bootstatus_proven"),
                  ", ".join(boot.get("proven_identities") or []) or "none"))
    entries = rc.parse_boots_log(_read(paths.boots_log))
    if entries:
        print("last boots:")
        for entry in entries[-5:]:
            print("  {}  {:<12} {}".format(entry.get("utc", "?"), entry.get("class", entry.get("event")),
                                          entry.get("reason", "")))
    return 0


def _read(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError:
        return ""


def _device(paths: rc.Paths) -> str:
    """The reset device the supervisor was configured with (recovery.env)."""
    return rc.read_env_file(paths.conf_file).get("HUB_WD_DEVICE") or "/dev/watchdog0"


def device_state(paths: rc.Paths, device: str) -> str:
    """'active', 'inactive', 'absent' or 'unknown', from sysfs."""
    sysdir = os.path.join(paths.watchdog_class_dir, os.path.basename(device))
    if not os.path.isdir(sysdir):
        return "absent"
    try:
        with open(os.path.join(sysdir, "state"), encoding="ascii") as handle:
            state = handle.read().strip()
    except OSError:
        return "unknown"
    return state if state in ("active", "inactive") else "unknown"


def _nowayout(paths: rc.Paths, device: str) -> str:
    try:
        with open(os.path.join(paths.watchdog_class_dir, os.path.basename(device), "nowayout"),
                  encoding="ascii") as handle:
            return handle.read().strip()
    except OSError:
        return "?"


def _open_device(path: str) -> int:
    """Seam for tests: open the watchdog for writing (this pings a running one)."""
    return os.open(path, os.O_WRONLY)


def _orphan_disarm(paths: rc.Paths, device: str) -> int:
    """A device is running and NO supervisor owns it: magic-close it ourselves.

    This is the case a failed or killed supervisor leaves behind: an active
    timer that nothing pets, which resets the box. With nowayout=0 the kernel
    stops it when a holder writes 'V' and closes. Guarded: only when the unit
    is not active (an owner would make the open fail EBUSY anyway), only with
    nowayout 0, and verified afterwards.
    """
    print("WARNING: {} is ACTIVE and no supervisor is running - nothing is petting it and the board"
          " will reset.".format(device), file=sys.stderr)
    if _nowayout(paths, device) != "0":
        print("REFUSED: nowayout is set (or unreadable) on {}; it cannot be stopped from userspace."
              " Expect a reset.".format(device), file=sys.stderr)
        return 1
    dev_path = os.path.join(paths.root, device.lstrip("/"))
    try:
        fd = _open_device(dev_path)
        try:
            os.write(fd, b"V")
        finally:
            os.close(fd)
    except OSError as exc:
        print("FAILED to open and magic-close {}: {}".format(device, exc), file=sys.stderr)
        return 1
    state = device_state(paths, device)
    if state not in ("inactive", "absent"):
        print("FAILED: {} still reads {} after the magic close.".format(device, state), file=sys.stderr)
        return 1
    print("disarmed an orphaned {}: verified {}.".format(device, state))
    return 0


def _wait_for_ack(paths: rc.Paths, boot_id: str, invocation: str) -> dict:
    deadline = time.monotonic() + float(os.environ.get("RECOVERY_ACK_WAIT", "15"))
    while time.monotonic() < deadline:
        ack = rc.read_json(paths.disarm_ack_file)
        if ack and ack.get("boot_id") == boot_id and ack.get("invocation_id") == invocation:
            return ack
        time.sleep(0.2)
    return {}


def cmd_disarm(paths: rc.Paths, _args) -> int:
    """Stop the supervisor with the watchdog VERIFIABLY stopped, or not at all (review C2).

    1. Write a one-use authorisation naming this boot and the running invocation.
    2. Ask with SIGUSR1; the supervisor disables the card, magic-closes, and
       acknowledges ok only once sysfs reads inactive.
    3. Read the acknowledgement AND sysfs ourselves; only then stop the unit,
       and read sysfs once more after the stop.
    Any step that does not prove the device stopped exits non-zero WITHOUT
    stopping the unit, so a failed disarm leaves a running, petting supervisor
    rather than an orphaned timer. A device that is active with no supervisor
    running is disarmed directly (see _orphan_disarm).
    Implements: SR-051, LLR-1002, LLR-1010
    """
    device = _device(paths)
    code, active, _ = _run(["systemctl", "is-active", UNIT], 10)
    if active != "active":
        state = device_state(paths, device)
        if state in ("inactive", "absent"):
            print("{} is not running ({}) and {} is {}; nothing is armed.".format(
                UNIT, active or "unknown", device, state))
            return 0
        return _orphan_disarm(paths, device)
    code, invocation, err = _run(["systemctl", "show", "-p", "InvocationID", "--value", UNIT], 10)
    if code != 0 or not invocation:
        print("REFUSED: cannot read the supervisor's InvocationID ({}); not stopping it, because "
              "a stop without a verified disarm would leave the device running".format(err), file=sys.stderr)
        return 1
    boot_id = rc.read_boot_id(paths)
    os.makedirs(paths.run_dir, exist_ok=True)
    try:
        os.unlink(paths.disarm_ack_file)
    except OSError:
        pass
    rc.atomic_write(paths.disarm_file, "{} {}\n".format(boot_id, invocation).encode("ascii"),
                    mode=0o600, durable=False)
    code, _, err = _run(["systemctl", "kill", "-s", "SIGUSR1", "--kill-whom=main", UNIT], 10)
    if code != 0:
        print("FAILED: could not signal the supervisor ({}); it is still running and armed.".format(err),
              file=sys.stderr)
        return 1
    ack = _wait_for_ack(paths, boot_id, invocation)
    state = device_state(paths, device)
    if not ack.get("ok") or state not in ("inactive", "absent"):
        print("FAILED: the watchdog was NOT verified stopped (acknowledgement: {}; {} reads {}). The "
              "supervisor is still running and petting it; nothing was stopped.".format(
                  ack.get("detail", "none received"), device, state), file=sys.stderr)
        return 1
    code, _, err = _run(["systemctl", "stop", UNIT], 120)
    if code != 0:
        print("systemctl stop failed: {}".format(err), file=sys.stderr)
        return 1
    state = device_state(paths, device)
    if state not in ("inactive", "absent"):
        print("FAILED: {} reads {} after the stop.".format(device, state), file=sys.stderr)
        return 1
    print("disarmed: the watchdog is verified {} and the supervisor is stopped.".format(state))
    print("It starts again at the next boot unless HUB_WATCHDOG_ENABLED is false.")
    return 0


def cmd_reset_brake(paths: rc.Paths, _args) -> int:
    now = time.time()
    rc.append_boots_log(paths.boots_log, {"t": now, "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                                                      time.gmtime(now)),
                                          "event": "brake-reset"})
    print("brake reset: counted boots before now no longer count.")
    # Re-run the (idempotent) classifier so boot.json and kernel.panic reflect
    # the reset now. The supervisor is replaced through the VERIFIED disarm,
    # never a bare restart (review C1): a restart hands the timer off, and a
    # replacement that did not arm would leave it counting down.
    _run(["systemctl", "restart", "homehub-recovery-boot.service"], 60)
    code, active, _ = _run(["systemctl", "is-active", UNIT], 10)
    if active != "active":
        return 0
    if cmd_disarm(paths, None) != 0:
        print("The running supervisor could not be disarmed, so it was left running; it will "
              "notice the reset by itself within 10 minutes.", file=sys.stderr)
        return 1
    code, _, err = _run(["systemctl", "start", UNIT], 60)
    if code != 0:
        print("could not start the supervisor again: {}".format(err), file=sys.stderr)
        return 1
    return 0


def _quarantine_targets(record: dict) -> list:
    """The container(s) a quarantine record means NOW, not when it was written.

    The record stores the container id of the victim, but a boot that loads a
    new image makes `docker compose up -d` RECREATE the service under a new id,
    with compose's restart policy. So a COMPOSE victim is looked up by its
    project AND service labels - the service label alone also matches a
    same-named service of another project, which must never be touched - with
    the stored full id as the fallback. A victim with no recorded project (not
    started by compose) is its recorded full id and nothing else.
    """
    recorded = [c for c in [record.get("container", "")] if c]
    project, service = record.get("project") or "", record.get("service") or ""
    if not (project and service):
        return recorded
    code, out, _ = _run(["docker", "ps", "-a", "-q", "--no-trunc",
                         "--filter", "label=com.docker.compose.project={}".format(project),
                         "--filter", "label=com.docker.compose.service={}".format(service)], 20)
    found = out.split() if code == 0 else []
    return found or recorded


def cmd_enforce_quarantine(paths: rc.Paths, _args) -> int:
    """Keep every quarantined service STOPPED after the boot's `docker compose up -d`.

    Design §3.2 says a quarantined service stays down "even across a reboot".
    `docker update --restart=no` is enough for dockerd, but firstboot runs
    `docker compose up -d` on EVERY boot, and compose starts a stopped service
    whatever its restart policy - so without this the hog came back and ran
    while `status` still called it quarantined (review, 2026-10-10). firstboot
    calls this right after that `up`; it reads only the quarantine file, so it
    applies whether or not the supervisor is enabled, and the Owner's way out
    is unchanged: `release` removes the entry, and then nothing stops it.
    Exit 1 if any stop failed (firstboot logs it; it never fails the boot).
    Implements: SR-050, LLR-1016
    """
    quarantined = (rc.read_json(paths.quarantine_file) or {}).get("quarantined") or {}
    failed = []
    for key in sorted(quarantined):
        for container in _quarantine_targets(quarantined[key]):
            code1, _, err1 = _run(["docker", "update", "--restart=no", container], 20)
            code2, _, err2 = _run(["docker", "stop", "-t", "10", container], 35)
            if code1 != 0 or code2 != 0:
                failed.append(key)
                print("{}: could not keep {} stopped: update rc={} ({}) stop rc={} ({})".format(
                    key, container[:12], code1, err1, code2, err2), file=sys.stderr)
            else:
                print("quarantined, kept stopped: {} ({})".format(key, container[:12]))
    if quarantined:
        print("  release with: homehub-recovery release <service>")
    return 1 if failed else 0


def cmd_release(paths: rc.Paths, args) -> int:
    data = rc.read_json(paths.quarantine_file) or {}
    quarantined = data.get("quarantined") or {}
    record = quarantined.get(args.service)
    if record is None:
        print("{} is not quarantined (known: {})".format(args.service, ", ".join(sorted(quarantined)) or "none"))
        return 1
    restart = record.get("restart") or "unless-stopped"
    if restart == "no":
        restart = "unless-stopped"
    code1 = code2 = 1
    err1 = err2 = "no container found for {}".format(args.service)
    for container in _quarantine_targets(record):
        code1, _, err1 = _run(["docker", "update", "--restart={}".format(restart), container], 60)
        code2, _, err2 = _run(["docker", "start", container], 120)
        if code1 != 0 or code2 != 0:
            break
    if code1 != 0 or code2 != 0:
        print("release incomplete: update rc={} ({}) start rc={} ({})".format(code1, err1, code2, err2),
              file=sys.stderr)
        print("If the container was removed, recreate it: cd /opt/homehub/stack && docker compose up -d "
              + args.service, file=sys.stderr)
        return 1
    quarantined.pop(args.service, None)
    rc.atomic_write(paths.quarantine_file, json.dumps({"quarantined": quarantined}, sort_keys=True).encode())
    os.makedirs(paths.run_dir, exist_ok=True)
    with open(paths.released_file, "a", encoding="utf-8") as handle:
        handle.write(args.service + "\n")
    print("released {}: restart policy {} restored and the container started.".format(args.service, restart))
    return 0


def cmd_events(paths: rc.Paths, args) -> int:
    try:
        names = sorted(n for n in os.listdir(paths.events_dir) if n.endswith(".json"))
    except OSError:
        names = []
    if not names:
        print("no recovery events recorded")
        return 0
    for name in names[-args.n:]:
        event = rc.read_json(os.path.join(paths.events_dir, name)) or {}
        details = event.get("details") or {}
        summary = " ".join("{}={}".format(k, v) for k, v in sorted(details.items())
                           if v not in (None, "", [], {}))
        print("{}  {:<22} {}".format(name[:-5], event.get("action", "?"), summary[:160]))
    return 0


def cmd_check_config(_paths: rc.Paths, args) -> int:
    try:
        cfg = rc.parse_config(rc.read_env_file(args.file))
    except rc.ConfigError as exc:
        print("REFUSED: {}".format(exc), file=sys.stderr)
        return 2
    sys.stdout.write(rc.render_config(cfg))
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="homehub-recovery", description="hub recovery capability")
    parser.add_argument("--root", default="/", help=argparse.SUPPRESS)  # tests only
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    sub.add_parser("disarm")
    sub.add_parser("reset-brake")
    release = sub.add_parser("release")
    release.add_argument("service")
    sub.add_parser("enforce-quarantine")
    events = sub.add_parser("events")
    events.add_argument("-n", type=int, default=20)
    check = sub.add_parser("check-config")
    check.add_argument("file")
    args = parser.parse_args(argv)
    handlers = {"status": cmd_status, "disarm": cmd_disarm, "reset-brake": cmd_reset_brake,
                "release": cmd_release, "enforce-quarantine": cmd_enforce_quarantine,
                "events": cmd_events, "check-config": cmd_check_config}
    return handlers[args.command](rc.Paths(args.root), args)


if __name__ == "__main__":
    sys.exit(main())
