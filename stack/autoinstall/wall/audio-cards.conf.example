# /etc/wall-panel/audio-cards.conf — GENERATED by wall-firstboot.sh.
#
# This file is the ONLY place card ids appear. Everything else -- asound.conf,
# both mode files, wall-audio-mode and both daemons -- refers to these names, so
# swapping the USB adapter for a different model is a knob in wall.env rather
# than an edit across five files that must agree.
#
# Card *ids* rather than indexes, deliberately: indexes are assignment order and
# have already been observed to swap across a reboot on this panel, silently
# repointing ALSA's `default` at the wrong output.
#
# Regenerate by re-running firstboot, or edit alongside audio-cards.env -- the
# two must agree, since the ALSA graph reads this one and the scripts read that.

pcm.card_usb { type hw
    card "ICUSBAUDIO7D"
    device 0
}

pcm.card_builtin { type hw
    card "PCH"
    device 0
}

pcm.card_loop_play { type hw
    card "Loopback"
    device 0
    subdevice 0
}

pcm.card_loop_cap { type hw
    card "Loopback"
    device 1
    subdevice 0
}

ctl.card_usb_ctl { type hw
    card "ICUSBAUDIO7D"
}

ctl.card_builtin_ctl { type hw
    card "PCH"
}
