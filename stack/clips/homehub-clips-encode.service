# homehub-clips-encode - re-encode motion clips to compress them (SR-130;
# stack/clips/README.md). A LOW-PRIORITY BATCH, never inline with the cut:
# hardware VA-API on the UHD 600, the encoder container at --cpu-shares 2 (the
# lowest weight docker takes), this unit at Nice 19 and idle I/O. The encoded
# file replaces the copy only when verified and at most CLIPS_ENCODE_KEEP_PCT of
# its size; otherwise, and on any failure, the copy stays. CLIPS_ENCODE_ENABLED
# ships false: measure first. A clips writer (see homehub-clips-cut.service).
[Unit]
Description=Motion clips: hardware re-encode, low-priority batch
Documentation=file:///opt/homehub/stack/clips/README.md
Wants=docker.service
After=docker.service homehub-firstboot.service
AssertPathExists=/opt/homehub/stack/clips/homehub_clips.py

[Service]
Type=oneshot
WorkingDirectory=/opt/homehub/stack
ExecStart=/usr/bin/python3 /opt/homehub/stack/clips/homehub_clips.py encode
SyslogIdentifier=homehub-clips
StateDirectory=homehub-clips
StateDirectoryMode=0750
UMask=0027
CapabilityBoundingSet=~CAP_SYS_RESOURCE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
TimeoutStartSec=6h
Nice=19
IOSchedulingClass=idle
CPUAccounting=true
CPUQuota=25%
MemoryAccounting=true
MemoryMax=256M
TasksMax=32
