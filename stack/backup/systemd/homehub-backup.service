# AWOW bash backup service (WI-10.10). Oneshot invoked by homehub-backup.timer.
# Runs as root: mount.cifs (source pulls + offsite push) needs it, and the timer
# makes it periodic. Never-silent-green: a nonzero exit here is visible in
# `systemctl status` / journal; nothing is posted to NagLight, so the nightlySuccess age grows.
[Unit]
Description=AWOW bash backup (cifs pull -> tar/zstd -> verify -> offsite -> NagLight)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# Install path on the AWOW: /opt/homehub/stack/backup (matches the repo layout).
ExecStart=/opt/homehub/stack/backup/backup.sh --config /etc/homehub-backup/backup.env
Nice=10
IOSchedulingClass=idle
# mount.cifs requires real mount privileges; keep it simple and run as root.
User=root
# THE LIBRARY IS READ-ONLY HERE, even to root, except where ingest step 1b lands.
# This run reads the library and its only writes there are the INGEST_SOURCES
# mirrors, so each destination is named below. A new ingest line needs a matching
# entry (HomeHub's Deploy.Contracts.Tests.ps1 asserts they agree), or its rsync
# fails loudly, as it does if a listed folder is missing, because nothing here can
# make one. `-`: this unit must still start with a drive missing, for the same
# reason it has no RequiresMountsFor=. Measured on the hub 2026-11-05: the cifs
# mount works inside this namespace, and the host's own mount is unaffected.
ReadOnlyPaths=-/srv/library
ReadWritePaths=-/srv/library/NonDocs/Snapshots -/srv/library/NonDocs/NetworkSync/NetworkShare

[Install]
WantedBy=multi-user.target
