[Unit]
# Closes the gap `internal: true` leaves open: a container on an internal docker
# network can still address the HOST's bridge IP. See game-isolation.sh for the
# measurements that justify this unit existing at all.
Description=Block the Gun Master 3 relay subnet from addressing this host
Documentation=file:///opt/homehub/stack/game-isolation/game-isolation.sh
# BEFORE docker, and this was WRONG in the first version. It said After=docker,
# reasoning that the rule names a subnet whose bridge docker creates. But the
# rule does NOT need the bridge to exist - iptables holds a rule for a subnet
# with no interface quite happily - and ordering after docker means that on every
# reboot the relay (restart: unless-stopped) is started by docker BEFORE this
# unit runs. That window is exactly when an already-compromised relay would
# reach the host, and it recurs on every single boot.
#
# Before=docker.service closes it: the fence is up before anything can be
# started behind it. Requires= is deliberately absent - this must run even if
# docker is masked or broken, because a rule with no containers is harmless and
# a container with no rule is the failure this exists to prevent.
Before=docker.service
DefaultDependencies=no
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/homehub/stack/game-isolation/game-isolation.sh
# The rule is NOT removed on stop. Deliberate: a stopped unit must not silently
# re-open the host to a service that may still be running. Removing it is a
# manual, deliberate act.

[Install]
WantedBy=multi-user.target
