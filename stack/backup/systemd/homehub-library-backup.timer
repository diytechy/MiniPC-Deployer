# Schedule for the library backup (E2 / Phase 2).
#
# 03:00 BOX-LOCAL — THE OWNER MOVED THIS OFF THE Q-FB6 DEFAULT, 2026-08-30.
# Both backups now run at 03:00. The previous value was 21:30, and the reasoning
# it was chosen for is kept below rather than deleted, because it is still true
# and it is what you would want to re-read if the nightly ever starts running
# long.
#
# WHAT THE 21:30 OFFSET WAS FOR: homehub-backup.timer owns /mnt/backup-drive
# from its own start until its archive finishes, and both services hold the
# drive awake with hdparm while they run. Contending for one USB spindle makes
# each slower and neither safer. 21:30 put six clear hours in front of the
# nightly archive.
#
# WHY LOSING IT IS ACCEPTABLE, AND WHERE IT IS NOT. Correctness does not rest on
# the offset: the two services write different trees, and the wrapper's flock
# stops this one stacking on itself. The offset only ever bought THROUGHPUT for
# the steady state. And the honest note from the original still stands — the
# FIRST real run of a ~2 TiB library takes DAYS, so it was always going to
# overlap the nightly whichever slot it started in.
#
# SO THE COST IS SPEED, NOT SAFETY: once the first run is behind us, the nightly
# archive and the library's incremental pass will contend for one spindle every
# night instead of never. If the nightly starts running long, this is the first
# thing to look at — move one of them, and this comment is the argument for
# which way.
[Unit]
Description=HomeHub library backup timer (FileBackup container)

[Timer]
OnCalendar=*-*-* 03:00:00
# A missed run (box off, or asleep) fires on the next boot. A backup should
# never silently skip — the same reasoning as homehub-backup.timer, including
# its warning that a timezone change fires any window that is now in the past.
Persistent=true
# Kept at 300s against the nightly's 600s, and now it does real work rather than
# just avoiding round half-hours: both units share the 03:00 slot, so the two
# jitters are the only thing that stops them starting on the same second and
# racing each other onto one USB spindle.
RandomizedDelaySec=300
Unit=homehub-library-backup.service

[Install]
WantedBy=timers.target
