[Unit]
Description=Panel touchscreen fault filter (explicit shadow/filter mode)
After=systemd-udev-settle.service
Before=getty@tty1.service
ConditionPathExists=/etc/wall-panel/touch-filter.enabled
StartLimitIntervalSec=0

[Service]
Type=notify
WorkingDirectory=/opt/wall-panel/app/runtime/resources/app
ExecStart=/usr/bin/python3 -m touchfilter.daemon --config /etc/wall-panel/touch-filter.json
User=root
Group=root
RuntimeDirectory=wall-touch-filter
RuntimeDirectoryMode=0755
# Reboot-safe protection (SR-084, LLR-1142): the daemon keeps its last
# qualifying fault renewal in $STATE_DIRECTORY/protection.json
# (/var/lib/wall-touch-filter, root, 0700) and restores it at start, so a
# reboot does not hand a known fault back to the kiosk until it is
# re-detected. systemd adds this path to the writable set itself under
# ProtectSystem=strict; nothing else is made writable.
StateDirectory=wall-touch-filter
StateDirectoryMode=0700
UMask=0022
Restart=always
RestartSec=2
WatchdogSec=10
TimeoutStartSec=15
TimeoutStopSec=3
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/wall-touch-filter

[Install]
WantedBy=multi-user.target
