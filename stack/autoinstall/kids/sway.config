# /etc/kids-kiosk/sway.config — the KIDS KIOSK compositor. Implements: SR-139, LLR-1417.
#
# One application, full screen, on the touch output; every other output shows
# a mirror of it (kids-outputs.sh). NO KEY BINDINGS AT ALL, deliberately: this
# is the whole config, so there is no way to exit sway, open a terminal or
# switch workspace from the keyboard or the screen.
xwayland disable
default_border none
default_floating_border none
focus_follows_mouse no
focus_on_window_activation none
seat * hide_cursor 1000
output * bg #000000 solid_color
# A config error must not put a clickable bar over the kids' screen.
swaynag_command -

# OtterTube always lives on workspace "kiosk", which kids-outputs.sh keeps on
# the touch output. Its Wayland app_id is "ottertube" (measured 2026-11-01).
for_window [app_id="^ottertube"] fullscreen enable, move container to workspace kiosk
for_window [app_id="^at.yrlf.wl_mirror$"] fullscreen enable, inhibit_idle visible

exec /usr/local/bin/kids-outputs.sh
exec /usr/local/bin/kids-app-loop.sh
