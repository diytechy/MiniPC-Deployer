  "knownDifferences": [
    {
      "name": "revision-written-as-1.0",
      "ownOk": true,
      "mpdOk": false,
      "payload": {
        "displayMode": "TABBED",
        "selectedTab": "MUSIC",
        "fullscreenOwner": null,
        "mediaPreference": null,
        "visualizerStatus": null,
        "displayPower": "on",
        "musicActive": false,
        "revision": 1.0,
        "monotonicMs": 1000.5,
        "projectmPreset": null
      },
      "note": "JSON 1.0 is the integer 1 to JavaScript and a float to Python."
    },
    {
      "name": "astral-characters-33-emoji-in-required-string",
      "ownOk": false,
      "mpdOk": true,
      "payload": {
        "displayMode": "TABBED",
        "selectedTab": "MUSIC",
        "fullscreenOwner": null,
        "mediaPreference": null,
        "visualizerStatus": null,
        "displayPower": {
          "$repeat": [
            "\ud83d\ude00",
            33
          ]
        },
        "musicActive": false,
        "revision": 1,
        "monotonicMs": 1000.5,
        "projectmPreset": null
      },
      "note": "33 emoji is 66 UTF-16 units (JavaScript length) but 33 code points (Python len); the 64-char bound counts differently."
    }
  ]
