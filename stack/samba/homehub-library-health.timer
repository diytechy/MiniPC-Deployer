[Unit]
Description=Run the AWOW file-share health monitor every 10 minutes
Documentation=file:/opt/homehub/stack/samba/library-guard.sh

[Timer]
# Soon after boot so a drive that failed to mount is reported without waiting
# for the first interval — the boot case is the likeliest one.
OnBootSec=3min
OnUnitActiveSec=10min
# Cheap check; jitter only to avoid lining up with every other timer.
RandomizedDelaySec=30s
Persistent=false

[Install]
WantedBy=timers.target
